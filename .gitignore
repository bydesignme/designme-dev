# Dependencies
node_modules/

# Build output that isn't served (the served build is committed at the root)
dist/
.astro/
*.tgz

# Generated by `npm run base` in tools/site from git history
tools/site/site-main.html

# The registry entries of the components that aren't live (tools/site/live.js): the build writes them for the templates and
# the React package's styles, and nothing serves them
tools/pages/data/unlisted/

# Python
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*

# Local settings and secrets
.env
.env.*
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/settings.local.json
