---
// /components: every component, by set and section, one row each, under the homepage's section headers
import Page from '../layouts/Page.astro';
import { SITE, SETS, SECTIONS, COMPONENTS } from '../lib/data.mjs';
const title = `${COMPONENTS.length} free UI components for AI agent products, in React and HTML | Designme.dev`;
const agentCount = SECTIONS.filter(s => s.grp === 'agent').reduce((n, s) => n + s.cards.length, 0);
const description = `Every Designme.dev component: ${agentCount} components for showing an agent's work, from status pills and reasoning trails to permission gates and run summaries, plus the app basics around them. Free, MIT licensed, as HTML or typed React.`;
const jsonld = [{ '@context':'https://schema.org', '@type':'CollectionPage', name:'Components', description, url:SITE + '/components',
  mainEntity:{ '@type':'ItemList', numberOfItems:COMPONENTS.length, itemListElement:COMPONENTS.map((c, i) => ({ '@type':'ListItem', position:i + 1, name:c.title, url:SITE + c.url })) } }];
const no = s => String(SECTIONS.indexOf(s) + 1).padStart(2, '0');
---
<Page title={title} description={description} path="/components" jsonld={jsonld}>
  <Fragment slot="head"><style is:global>
    .ix-set{margin:64px 0 0;font-size:22px;line-height:1.3;font-weight:600;letter-spacing:-.02em}
    .ix-set:first-of-type{margin-top:48px}
    .ix-list{list-style:none;margin:0;padding:0}
    .ix-list a{display:grid;grid-template-columns:minmax(160px,260px) minmax(0,1fr) auto;align-items:baseline;gap:4px 24px;padding:14px 0;border-bottom:1px solid var(--pg-line);text-decoration:none}
    .ix-list li:first-child a{padding-top:0}
    .ix-list .pg-d{font-size:13.5px}
    .ix-list i{font-style:normal;color:var(--pg-muted);transition:transform .25s cubic-bezier(.16,1,.3,1),color .2s}
    .ix-list a:hover .pg-t{text-decoration:underline;text-decoration-color:var(--pg-line2);text-underline-offset:3px}
    .ix-list a:hover i{color:var(--pg-fg);transform:translateX(3px)}
    .ix-sh a{color:inherit;text-decoration:none}
    .ix-sh a:hover{text-decoration:underline;text-decoration-color:var(--pg-line2);text-underline-offset:3px}
    @media (max-width:640px){.ix-list a{grid-template-columns:minmax(0,1fr) auto}.ix-list .pg-d{grid-column:1;grid-row:2}.ix-list i{grid-row:1/3;align-self:center}}
  </style></Fragment>
  <div class="pg-wrap">
    <h1 class="pg-h1">Components</h1>
    <p class="pg-lead">{COMPONENTS.length} free components for products built around AI agents, each one as plain HTML, CSS and JavaScript or as a typed React component, in two styles with light and dark mode. Install any of them with <code>npx designme add</code>.</p>
    <div class="pg-cmd"><span class="d">$</span><span class="c">npx designme add composer</span><button type="button" data-copy="npx designme add composer" aria-label="Copy install command" set:html={'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>'} /></div>

    {Object.entries(SETS).map(([g, name]) => <>
      <h2 class="ix-set">{name}</h2>
      {SECTIONS.filter(s => s.grp === g).map(s => <section>
        <div class="pg-sh ix-sh"><span class="n">{no(s)}</span><h3 style="margin:0;font-size:17px;line-height:1.5;font-weight:600;letter-spacing:-.015em"><a href={s.url}>{s.title}</a></h3><p>{s.about}</p></div>
        <ul class="ix-list">{s.cards.map(c => <li><a href={`/components/${c.reg}`}><span class="pg-t">{c.title}</span><span class="pg-d">{c.desc}</span><i aria-hidden="true">→</i></a></li>)}</ul>
      </section>)}
    </>)}
  </div>
</Page>
