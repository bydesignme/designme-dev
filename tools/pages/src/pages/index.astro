          <div class="lp-tl" role="tablist" aria-label="How to add it">{INSTALL.map(([id, n, mk], i) => <button type="button" role="tab" id={`in-t-${id}`} aria-controls={`in-p-${id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><Fragment set:html={mk} />{n}</button>)}</div>
          {INSTALL.map(([id, n, , cmd, note], i) => { const f = FILES[id]; return <div class="lp-tp" role="tabpanel" id={`in-p-${id}`} aria-labelledby={`in-t-${id}`} hidden={i !== 0}>
            <div class="lp-line"><code class="d" aria-hidden="true">$</code><code class="c" set:html={words(cmd)} /><button class="lp-copy" type="button" data-copy={cmd} data-label="Copy" aria-label={`Copy the ${n} command`}>Copy</button></div>
            <p>{note}</p>
            <div class="lp-art lp-ed-art" data-art="code">
              <div class="lp-win lp-ed" role="group" aria-label={`The files the ${n} command writes`}>
                <div class="lp-bar"><span class="lp-bar-l">{f.root ? <span>It writes, into <code>{f.root}</code>{f.or && <Fragment> (<code>{f.or}</code> without a src folder)</Fragment>}</span> : <span>It writes, into your components folder</span>}</span></div>
                <div class="lp-ed-b">
                  <div class="lp-tree" role="tablist" aria-orientation="vertical" aria-label="Files">
                    {[['own', `${HERO.reg}/`], ['shared', 'Once per project, shared']].map(([g, label]) => <Fragment>
                      <span class="lp-tg" aria-hidden="true">{label}</span>
                      {f[g].map((x, k) => { const i = g === 'own' ? k : f.own.length + k; return <button type="button" role="tab" class="lp-tf" id={`fl-${id}-${i}`} aria-controls={`fp-${id}-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
                        <Fragment set:html={fileIcon} /><span class="n">{g === 'shared' && <span class="d">{x.dir}</span>}{x.name}</span><span class="m">{x.demo ? '' : x.folder ? x.meta : x.n}</span>
                      </button>; })}
                    </Fragment>)}
                  </div>
                  <div class="lp-code">
                    {[...f.own, ...f.shared].map((x, i) => <div class="lp-cp" role="tabpanel" id={`fp-${id}-${i}`} aria-labelledby={`fl-${id}-${i}`} hidden={i !== 0}>
                      <p class="lp-cph"><code>{x.path}</code><span>{x.demo ? 'written by the CLI' : x.meta}</span></p>
                      {x.demo ? <p class="lp-cpn">A page with the component on its own, on the shared core, written beside it. Open it in a browser to see it working before you copy its markup into yours.</p>
                        : <pre class:list={{ cut:!x.folder && x.n > PREVIEW, ls:x.folder }} tabindex="0" aria-label={x.folder ? `The files in ${x.name}` : `The first lines of ${x.name}`}><code>{x.head.map(l => <span class="l">{l || ' '}</span>)}</code></pre>}
                    </div>)}
                  </div>
                </div>
              </div>
            </div>
          </div>; })}
        </div>
      </div>
      <div class="lp-two">
        <div class="lp-h">
