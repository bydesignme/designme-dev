            <div class="lp-ed-b">
              {INSTALL.map(([id, n], i) => { const f = FILES[id], tabs = f.rows.filter(x => !x.dir); return <div class="lp-ed-f" id={`in-f-${id}`} data-tab={id} hidden={i !== 0}>
                <div class="lp-tree" role="tablist" aria-orientation="vertical" aria-label="Files">
                  {f.rows.map(x => { if (x.dir) return <span class="lp-tr dir" style={`--d:${x.depth}`} aria-hidden="true"><Fragment set:html={folderIcon} /><span class="n">{x.name}</span><span class="m">{x.once ? 'added once' : ''}</span></span>;
                    const k = tabs.indexOf(x); return <button type="button" role="tab" class="lp-tr" style={`--d:${x.depth}`} id={`fl-${id}-${k}`} aria-controls={`fp-${id}-${k}`} aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1} aria-label={`${x.path}, ${x.meta}${x.once ? ', added once per project' : ''}`}>
                      <Fragment set:html={x.folder ? folderIcon : fileIcon} /><span class="n">{x.name}</span><span class="m">{x.demo ? '' : x.folder ? x.meta : x.n}</span>
                    </button>; })}
