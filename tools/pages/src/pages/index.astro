      <script is:inline>
      // from 1100 to 1439px the bento is two stacks, balanced on their own (BENTO2); the cards move there before any of them
      // has loaded, and back if the window crosses the line again
      (function(){
        var bento = document.querySelector('.lp-bento'), stacks = [].slice.call(bento.children), two = JSON.parse(bento.dataset.two), cards = {};
        bento.querySelectorAll('.lp-bt').forEach(function(c){ cards[c.querySelector('.lp-bc').dataset.reg] = c; });
        var three = stacks.map(function(s){ return [].map.call(s.children, function(c){ return c.querySelector('.lp-bc').dataset.reg; }); });
        var q = matchMedia('(min-width:1100px) and (max-width:1439px)');
        var place = function(){ var plan = q.matches ? two : three; stacks.forEach(function(s, i){ (plan[i] || []).forEach(function(r){ s.appendChild(cards[r]); }); }); };
        if (q.matches) place();
        if (q.addEventListener) q.addEventListener('change', place);
      })();
      </script>
