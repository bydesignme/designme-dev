          </div>
        </div>)}
      </div>
      <script is:inline>
      // each picture in the style and theme on screen (tools/pages/wall.mjs takes a set of each), swapped when either changes.
      // The pictures are asked for once the wall comes within a screen of the view, not with the first screen
      (function(){
        var root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)'), imgs = [].slice.call(document.querySelectorAll('.lp-wt img')), near = false;
        var set = function(){ if (!near) return;
          var s = root.getAttribute('data-style'), t = root.getAttribute('data-theme') || (mq.matches ? 'dark' : 'light');
          var dir = '/components/wall/' + (s === 'soft' || s === 'clean' ? s : 'bp') + '-' + (t === 'dark' ? 'dark' : 'light') + '/';
          imgs.forEach(function(i){ var u = dir + i.parentNode.getAttribute('data-reg') + '.webp'; if (i.getAttribute('src') !== u) i.setAttribute('src', u); });
        };
        var rows = document.querySelector('.lp-rows');
        if ('IntersectionObserver' in window && rows){ var io = new IntersectionObserver(function(es){ if (!es[es.length - 1].isIntersecting) return; io.disconnect(); near = true; set(); }, { rootMargin:'100% 0px' }); io.observe(rows); }
        else { near = true; set(); }
        new MutationObserver(set).observe(root, { attributes:true, attributeFilter:['data-style', 'data-theme'] });
        if (mq.addEventListener) mq.addEventListener('change', set);
      })();
      </script>
