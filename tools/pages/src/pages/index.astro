---
// The landing page at / (owner, 19 Nov): what designme.dev is, shown with the components themselves. The library it leads to is
// at /library (tools/site builds it as library.html). A full-width page with the site's header and footer and no sidebar.
// Sections, in order:
//   hero      the title, one short line, Browse the library and Read the docs, then the two templates (whole apps made
//             of the components) live in a frame on a colour backdrop, taking turns (owner, 19 Nov: a quiet first screen)
//   wall      every component, as rows of pictures that drift in turn left and right across a backdrop, each linking to
//             its page
//   screens   four small app screens, each two agent components side by side in one window on its own backdrop, playing
//             their demos, with one line under it (owner, 19 Nov: "a very impressive elevation pass")
//   styles    Blueprint, Soft and Clean to pick from, with a demo beside them; a pick restyles the whole page
//   install   how to add a component: the CLI in HTML, React or Astro, and the shadcn CLI, with the files each writes in an
//             editor on a backdrop (each file's first lines as installed, read from the registry)
//   built     what comes with every component, as a plain list
//   start     Browse the library, GitHub, and DesignMe's Book a call
//   faq       questions, with their answers
// The backdrops are the only colour the page adds: soft washes of the accent and the chart palette (--dm-accent, --dm-c2 to
// --dm-c6), so they follow the style, the theme and a picked accent. Shadows stay the neutral --dm-shadow and --dm-shadow-pop.
// /?headings=large shows the section headings large, as the references set them, to compare with the page as it is (a
// question for the owner; the type rule keeps them at 14px).
// Every number and claim here is read from the code or true of it: the counts come from the library's own sections, the
// file names and line counts from the registry (/r), the facts from the README, the CLI and the docs. The demos are the
// installed HTML, CSS and JS on the shared core, as on a component page: they load from the registry (/r/<name>.json) when
// they come near the screen, and each stage fits the tallest its component gets in the style on screen
// (tools/site/card-heights.json), so nothing below it moves while it plays and no stage keeps room for another style.
import fs from 'node:fs';
import path from 'node:path';
import Page from '../layouts/Page.astro';
import { ROOT, SITE, COMPONENTS, SECTIONS, BANDS, icon, MARKS, shadcnUrl } from '../lib/data.mjs';
import { FRAME_CSS, FRAME_JS } from '../lib/templates.mjs';

const comp = reg => { const c = COMPONENTS.find(x => x.reg === reg); if (!c) throw new Error('landing: no component called ' + reg); return c; };
const total = COMPONENTS.length;
const nOf = g => SECTIONS.filter(s => s.grp === g).reduce((n, s) => n + s.cards.length, 0);
const nAgent = nOf('agent'), nBasics = nOf('basics');

// each stage is as tall as its component gets in the style on screen (measure-heights.js measures each style: components is
// Soft), with its padding above and below it (48px, 32px in the chat screen), so the component sits in the middle and
// nothing below the stage moves while it plays. Picking another style fits the stages to it. From 641px up every stage here
// gives its component its whole width (440px, or at least 464px for a wide one, and never less than the library's card at
// the same width), so the tallest it gets is the most the library measured where its cards were at least that wide: band
// a, then c to i (b is the library's tight two-up band). On a phone the stages are as wide as the library's, so each band
// is its own
const MEASURED = JSON.parse(fs.readFileSync(path.join(ROOT, 'tools/site/card-heights.json'), 'utf8'));
const KEYS = { soft:'components', bp:'componentsBp', clean:'componentsClean' }, PAD = 48;
const ROOMY = BANDS.map(([b, w], i) => ({ b, w, i })).filter(x => x.w > 640 && x.b !== 'b'), PHONE = BANDS.map(([b, w], i) => ({ b, w, i })).filter(x => x.w <= 640);
const heights = (c, style) => {
  const r = (MEASURED[KEYS[style]] || {})[c.v2], soft = MEASURED.components[c.v2];
  if (!soft) throw new Error('landing: no measured height for ' + c.v2 + ': measure it with measure-heights.js');
  return r && r.length === BANDS.length ? r : soft;
};
// a component with a switch under it (its views or designs, in a .dm frame) keeps 40px more for the switch, as on its own page
// (the library shows that switch in the card's footer, so its measurement leaves it out)
const SW = c => /class="[^"]*(?<![\w-])dm(?![\w-])/.test(c.html.html) ? 40 : 0;
// and 4px to spare, for the pixel or two a component can reach past what was measured at another width in its band
const stageVars = (c, pad = PAD) => Object.keys(KEYS).flatMap(st => { const r = heights(c, st), add = 2 * pad + SW(c) + 4;
  return [`--lh-${st}:${Math.max(...ROOMY.map(x => r[x.i])) + add}px`, ...PHONE.map(x => `--lh-${st}-${x.b}:${r[x.i] + add}px`)]; }).join(';');
// Blueprint draws when <html> has no data-style; each phone band applies from its own width up to the next one's
const pick = sfx => `.lp-demo{--lh:var(--lh-bp${sfx})}:root[data-style="soft"] .lp-demo{--lh:var(--lh-soft${sfx})}:root[data-style="clean"] .lp-demo{--lh:var(--lh-clean${sfx})}`;
const bandCss = [pick(''), ...PHONE.map((x, k) => `@media (max-width:${(k ? PHONE[k - 1].w : 641) - 1}px){${pick('-' + x.b)}}`), '.lp-demo{min-height:var(--lh)}'].join('\n');

// the component the install commands name
const HERO = comp('agent-tree');
// the templates, whole apps made of the components, shown live in the first screen (with ?embed=1, only the app)
const TEMPLATES = [['sales-crm', 'Sales CRM'], ['workflow-editor', 'Workflow editor']].map(([slug, name]) => ({ slug, name, url:`/templates/${slug}` }));
// the wall: every component in the library, in its order, as four rows that drift in turn left and right
const ROWS = [0, 1, 2, 3].map(i => COMPONENTS.slice(Math.round(i * COMPONENTS.length / 4), Math.round((i + 1) * COMPONENTS.length / 4)));
if (ROWS.flat().length !== total) throw new Error('landing: the wall shows ' + ROWS.flat().length + ' of ' + total + ' components');
// the screens: two agent components in one window, side by side from 1200px (two wide ones share it; a wide one leaves
// 488px for a narrow one, its whole 440px), one under another below that. The chat screen is always one under another, an
// answer over the box for the next question, in a narrower window. Each sits on its own mix of the backdrop's colours
const SCREENS = [
  { art:'1', k:'ww', title:'An agent at work', line:'An orchestrator and its sub-agents with cost per branch, beside one run as a waterfall of spans.', regs:['agent-tree', 'trace-view'] },
  { art:'2', k:'wn', title:'It asks before it acts', line:'You check and edit the plan before it runs, and say yes before it touches something new.', regs:['plan-review', 'permission-gate'] },
  { art:'3', k:'wn', title:'Everything that needs you', line:'Every run that needs you, is running or is done, with one live line for what the agent is doing.', regs:['agent-inbox', 'status-pill'] },
  { art:'4', k:'stack', title:'The answer as it streams', line:'An answer streams in with numbered sources and next steps, over the box for what to ask next.', regs:['live-answer', 'composer'] },
].map(s => ({ ...s, comps:s.regs.map(comp) }));
const STYLE_DEMO = comp('decision-prompt');

const STYLES = [
  ['bp', 'Blueprint', 'Square corners, hairline edges and a lime accent, like a technical sheet.', '<html>'],
  ['soft', 'Soft', 'Rounded, plush surfaces with a blue accent.', '<html data-style="soft">'],
  ['clean', 'Clean', 'Black, white and grey, with fully round controls. Data keeps its colours.', '<html data-style="clean">'],
];

// what `npx designme add <name>` writes, read from the registry the CLI reads (packages/designme/bin/designme.js): the
// component's own files, and the shared ones it adds once per project. React and Astro go into src/components/designme
// (components/designme in a project without src/), HTML into ./designme, the shadcn CLI into the components alias
const REG = p => JSON.parse(fs.readFileSync(path.join(ROOT, 'r', p + '.json'), 'utf8'));
const nLines = s => s.split('\n').length - (s.endsWith('\n') ? 1 : 0);
const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
// each file with its first lines, shown as they are installed (the editor in Install shows one file at a time)
const PREVIEW = 14;
const entry = (p, extra) => ({ path:p, dir:p.slice(0, p.lastIndexOf('/', p.length - 2) + 1), name:p.slice(p.lastIndexOf('/', p.length - 2) + 1), ...extra });
const own = files => files.map(f => { const n = nLines(f.content); return entry(f.path, { n, meta:plural(n, 'line'), head:f.content.split('\n').slice(0, Math.min(PREVIEW, n)) }); });
// a folder of shared helpers, as one row that lists what is in it
const folder = (files, dir) => { const in_ = files.filter(f => f.path.startsWith(dir)); if (!in_.length) return [];
  const list = in_.map(f => [f.path.slice(dir.length), nLines(f.content)]), w = Math.max(...list.map(x => x[0].length));
  return [entry(dir, { n:in_.length, meta:plural(in_.length, 'file'), head:list.map(([f, n]) => `${f.padEnd(w)}  ${plural(n, 'line')}`), folder:true })]; };
const shared = (files, dir) => [...own(files.filter(f => !f.path.startsWith(dir))), ...folder(files, dir)];
const strip = (files, pre) => files.map(f => ({ ...f, path:f.path.startsWith(pre) ? f.path.slice(pre.length) : f.path }));
const needs = (core, item) => { const f = core.files.filter(x => item.needs.includes(x.path)); if (f.length !== item.needs.length) throw new Error('landing: a shared file ' + HERO.reg + ' needs is missing from the registry'); return f; };
const FILES = (() => {
  const r = REG('react/' + HERO.reg), a = REG('astro/' + HERO.reg), s = REG('shadcn/' + HERO.reg);
  return {
    html:{ root:'designme/', own:[...own(REG(HERO.reg).files), entry(`${HERO.reg}/demo.html`, { meta:'demo', demo:true })], shared:own(REG('core').files) },
    react:{ root:'src/components/designme/', or:'components/designme/', own:own(r.files), shared:shared(needs(REG('react/core'), r), 'lib/') },
    astro:{ root:'src/components/designme/', or:'components/designme/', own:own(a.files), shared:own(needs(REG('astro/core'), a)) },
    shadcn:{ root:null, own:own(strip(s.files, 'designme/')), shared:shared(strip(REG('shadcn/core').files, 'designme/'), 'lib/') },
  };
})();

const INSTALL = [
  ['html', 'HTML', MARKS.html, `npx designme add ${HERO.reg}`, 'Open demo.html to see it working, then copy its markup into your page.'],
  ['react', 'React', MARKS.react, `npx designme add ${HERO.reg} --react`, 'A typed component that imports its own CSS. Needs React 19, and works in Next.js, Vite and Astro islands.'],
  ['astro', 'Astro', MARKS.astro, `npx designme add ${HERO.reg} --astro`, 'The same markup, CSS and script as the HTML version, as an .astro component.'],
  ['shadcn', 'shadcn', MARKS.react, `npx shadcn@latest add ${shadcnUrl(HERO.reg)}`, 'Every component is also a shadcn registry item, in React and in Astro (at /r/shadcn/astro/), for a project set up for shadcn/ui.'],
];

const BUILT = [
  ['code', 'You own the code', 'The CLI copies the source into your project. Change anything.'],
  ['tune', 'Three styles, light and dark', 'Picked with two attributes on <html>.'],
  ['dashboard', 'No clashes with your CSS', 'Every CSS variable starts with --dm-, and in React every class too.'],
  ['stars', 'Your theme, if you want it', '--theme-bridge takes the colours and corners of your shadcn/ui or Tailwind v4 theme.'],
  ['check_circle', 'Accessible', 'ARIA roles and live regions, keyboard support in most components, and reduced motion.'],
  ['description', 'Ready for AI coding tools', 'A Markdown copy of every page at its address plus .md, all listed in llms.txt.'],
];

const FAQ = [
  ['Is it free?', 'Yes. Every component is free for personal and commercial work under the MIT licence. Fonts, icons, flags and brand marks from other projects keep their own licences, listed in NOTICE.md.'],
  ['What do I need?', 'Node 18 or later to run the CLI. The React components need React 19 and work in Next.js, Vite and Astro islands. The HTML version needs only the shared core, which the CLI adds once.'],
  ['Do I need Tailwind or shadcn/ui?', 'No. The components bring their own CSS. If your project uses shadcn/ui or Tailwind v4, the theme bridge (--theme-bridge) gives them your theme, and the shadcn CLI can add any of them.'],
  ['Will their CSS clash with mine?', 'No. Every CSS variable starts with --dm-, and in React every class and animation name starts with dm- too, so nothing meets your own names.'],
  ['What are Blueprint, Soft and Clean?', 'Three styles for the same components: Blueprint is technical and square with a lime accent, Soft is rounded with a blue accent, and Clean is black, white and grey with fully round controls. Each has a light and a dark theme. In your project, data-style on <html> picks one.'],
  ['Can AI coding tools use it?', 'Yes. Every component and docs page has a Markdown copy at its address plus .md, and llms.txt lists every component with its install command. The Using with AI page in the docs has prompts to start from.'],
  ['Is there a Figma file?', 'It is in progress on the roadmap. Leave your email in the library and you will get it when it lands.'],
  ['Who made it?', 'DesignMe, a design and development studio working with startups and enterprises. If you want help building your product, book a call.'],
];

// the prompt the docs give a coding agent (Using with AI), for any screen
const PROMPT = `Read ${SITE}/llms.txt and pick the components for our screen.\nFor each one, read its .md page, then install it with:\n  npx designme add <name> --react\nKeep the installed files as they are and drive the components through their props from our state.`;
const BOOK = 'https://www.designme.agency/intro?utm_source=designme.dev&utm_medium=referral&utm_campaign=book_a_call';
const GITHUB = 'https://github.com/bydesignme/designme-dev';
const GH_MARK = '<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>';
const replayIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>';
const arrow = icon('arrow_forward', 'lp-ar');
const fileIcon = icon('description', 'lp-fi');
// a command in words that each stay whole, so on a phone it wraps at a space (an address may also wrap after a slash)
const words = cmd => cmd.split(' ').map(w => /^https?:/.test(w) ? w.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/\//g, '/<wbr>') : `<span class="lp-w">${w.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`).join(' ');
// `code` in the copy becomes <code>
const md = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/(--[\w-]+|&lt;html&gt;|NOTICE\.md|\.md\b|llms\.txt|data-style)/g, '<code>$1</code>');

const title = 'Designme.dev: free UI components for AI agent products';
const description = `${total} free, MIT-licensed UI components for products built around AI agents, in HTML, React or Astro, in three styles with light and dark mode.`;
const jsonld = [
  { '@context':'https://schema.org', '@type':'WebSite', name:'Designme.dev', url:SITE + '/', description,
    publisher:{ '@type':'Organization', name:'DesignMe', url:'https://designme.agency' } },
  { '@context':'https://schema.org', '@type':'FAQPage', mainEntity:FAQ.map(([q, a]) => ({ '@type':'Question', name:q, acceptedAnswer:{ '@type':'Answer', text:a } })) },
];
---
<Page title={title} description={description} path="/" jsonld={jsonld}>
  <Fragment slot="head">
    <script is:inline>
    // the larger section headings the references use, to compare side by side with the page as it is: /?headings=large
    // (a question for the owner, on this branch only: the type rule keeps every text but the page title at 14px or under)
    if (/[?&]headings=large(&|$)/.test(location.search)) document.documentElement.setAttribute('data-lp-h', 'large');
    // the library used to be here: its old addresses (/#/changelog, /#s-status, /#/agent-tree, /?q=…) open it at /library
    (function(){ var h = location.hash, q = /[?&]q=/.test(location.search); if (q || /^#(\/|s-|c-|components$)/.test(h)) location.replace('/library' + location.search + h); })();
    </script>
    <script async src="https://plausible.io/js/pa-0ymYxWA7A4pvtqpGbOCwQ.js"></script>
    <script is:inline>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()</script>
    <link rel="stylesheet" href="/components/assets/core.css">
    <style is:inline set:html={FRAME_CSS} />
    <style is:inline set:html={bandCss} />
    <style is:global>
      .pg-main:has(.lp){padding:0}
      /* one rhythm for the whole page: sections 160px apart (120px on a tablet, 96px on a phone), everything else on the 4px
         scale; one family of corners (r1 for fields and rows, r2 for windows, frames and tiles, r3 for backdrops): Soft's
         plush and squircled, Clean's a little rounder and never squircled, and Blueprint keeps the site's rounded page
         around its square components, as on a component page; one easing, Clean's */
      .lp{--lp-sec:160px;--lp-ease:cubic-bezier(.23,1,.32,1);--lp-r1:10px;--lp-r2:16px;--lp-r3:28px;--lp-hair:color-mix(in srgb,var(--pg-line2) 50%,transparent)}
      :root[data-style="clean"] .lp{--lp-r2:22px;--lp-r3:30px}
            @supports (corner-shape:squircle){
        :root[data-style="soft"] .lp{--lp-r1:16px;--lp-r2:26px;--lp-r3:44px}
        :root[data-style="soft"] :is(.lp-art,.lp-win,.lp-show,.lp-show .dvf-dev:not(.mobile),.lp-wt,.lp-wt img,.lp-opt,.lp-line,.lp-prompt pre){corner-shape:squircle}
      }
      .lp-in{max-width:1464px;margin:0 auto;padding:0 32px}
      .lp code{font:500 12.5px/1.4 var(--pg-mono);font-variant-ligatures:none;background:var(--pg-chip);padding:1px 5px;border-radius:5px;color:var(--pg-fg)}
      .lp-ar{display:block;width:14px;height:14px;flex:none}

      /* ---- hero: the words and the two buttons, then the templates on a backdrop ---- */
      .lp-hero{padding-top:96px}
      /* the page's title: the one text over 14px (the page-title exception, .pg-h1) */
      .pg-h1.lp-h1{max-width:1000px;margin:0;font-size:clamp(34px,3.6vw,52px);line-height:1.08;font-weight:500;letter-spacing:-.034em;text-wrap:balance}
      .lp-lead{margin:24px 0 0;max-width:1000px;font-size:14px;line-height:1.65;color:var(--pg-dim);text-wrap:balance}
      .lp-cta{display:flex;flex-wrap:wrap;gap:8px;margin-top:32px}
      /* buttons: the components' own (.pill, .pill.primary on the accent, .pill.line), a step taller on the page */
      .lp .lp-btn{height:40px;padding:0 18px;font-size:14px;text-decoration:none;gap:8px}
      .lp .lp-btn svg{width:14px;height:14px}
      /* the templates: one quiet row, the switch between them on the left and Open on the right, over the backdrop */
      .lp-show-w{margin-top:80px}
      .lp-show-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:16px}
      .lp-show-bar .pg-seg button{height:28px;padding:0 12px}
      .lp-open .lp-ar{transform:rotate(-45deg)}
      .lp-more.lp-open:hover .lp-ar{transform:rotate(-45deg) translateX(2px)}
      /* the frame keeps its size from the start (the app inside fades in once it has loaded): the app at the frame's width,
         800px tall, scaled down below 1376px wide; on a phone, the app's phone layout in a phone's frame */
      .lp-show{--dvf-line:var(--pg-line2);--dvf-bg:var(--pg-bg);width:100%;aspect-ratio:16/10;max-height:800px;border-radius:var(--lp-r2);background:var(--pg-bg);box-shadow:var(--dm-shadow-pop)}
      .lp-show .dvf-dev:not(.mobile){border-radius:var(--lp-r2)}
      .lp-show-ph{position:absolute;inset:0;display:grid;place-items:center;margin:0;color:var(--pg-dim);font-size:13px}

      /* ---- a backdrop: soft washes of the accent and three of the chart colours from the corners, over the site's grey.
         Colour lives here and nowhere else the page adds; what sits on it keeps its own neutral surfaces and shadows.
         Fainter in dark mode and in Clean; Blueprint lays its sheet's grid over it ---- */
      .lp-art{--a1:var(--dm-accent);--a2:var(--dm-c2);--a3:var(--dm-c6);--a4:var(--dm-c5);--lp-k:1;position:relative;isolation:isolate;padding:56px;border-radius:var(--lp-r3);overflow:hidden;
        background:
          radial-gradient(64% 88% at 0% 0%,color-mix(in srgb,var(--a1) calc(52% * var(--lp-k)),transparent),transparent 72%),
          radial-gradient(58% 82% at 100% 0%,color-mix(in srgb,var(--a2) calc(46% * var(--lp-k)),transparent),transparent 72%),
          radial-gradient(62% 86% at 100% 100%,color-mix(in srgb,var(--a3) calc(42% * var(--lp-k)),transparent),transparent 72%),
          radial-gradient(56% 80% at 0% 100%,color-mix(in srgb,var(--a4) calc(36% * var(--lp-k)),transparent),transparent 72%),
          var(--pg-soft)}
      .lp-art[data-art="1"]{--a1:var(--dm-c2);--a2:var(--dm-accent);--a3:var(--dm-c6);--a4:var(--dm-c5)}
      .lp-art[data-art="2"]{--a1:var(--dm-c4);--a2:var(--dm-c5);--a3:var(--dm-c2);--a4:var(--dm-accent)}
      .lp-art[data-art="3"]{--a1:var(--dm-c6);--a2:var(--dm-c3);--a3:var(--dm-accent);--a4:var(--dm-c2)}
      .lp-art[data-art="4"]{--a1:var(--dm-c5);--a2:var(--dm-c2);--a3:var(--dm-c4);--a4:var(--dm-c6)}
      .lp-art[data-art="sty"]{--a1:var(--dm-accent);--a2:var(--dm-c6);--a3:var(--dm-c2);--a4:var(--dm-c3)}
      .lp-art[data-art="code"]{--a1:var(--dm-c2);--a2:var(--dm-c6);--a3:var(--dm-accent);--a4:var(--dm-c4)}
      :root[data-style="clean"] .lp-art{--lp-k:.7}
      :root[data-theme="dark"] .lp-art{--lp-k:.74}
      :root[data-theme="dark"][data-style="clean"] .lp-art{--lp-k:.56}
      @media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .lp-art{--lp-k:.74}:root:not([data-theme="light"])[data-style="clean"] .lp-art{--lp-k:.56}}
      :root:not([data-style="soft"],[data-style="clean"]) .lp-art::before{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(var(--lp-sheet) 1px,transparent 1px),linear-gradient(90deg,var(--lp-sheet) 1px,transparent 1px);background-size:32px 32px;background-position:-1px -1px}
      .lp{--lp-sheet:rgba(20,20,12,.06)}
      :root[data-theme="dark"] .lp{--lp-sheet:rgba(255,255,255,.045)}
      @media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .lp{--lp-sheet:rgba(255,255,255,.045)}}

      /* ---- a window: a title bar (the components in it, each linked to its page, and Animate), then the components on the
         site's grey, as on a component page ---- */
      .lp-win{position:relative;display:flex;flex-direction:column;max-width:1056px;margin:0 auto;border-radius:var(--lp-r2);background:var(--pg-bg);box-shadow:var(--dm-shadow-pop);overflow:hidden}
      .lp-win.stack{max-width:640px}
      .lp-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;padding:8px 8px 8px 16px;box-shadow:inset 0 -1px 0 var(--lp-hair);font-size:13px;line-height:20px;color:var(--pg-muted)}
      :root[data-style="clean"] .lp-bar{background:var(--dm-strip)}
      .lp-bar-l{display:flex;flex-wrap:wrap;align-items:center;gap:0 8px;min-width:0}
      .lp-bar a{color:var(--pg-dim);font-weight:500;text-decoration:none;white-space:nowrap;transition:color 220ms var(--lp-ease)}
      .lp-bar a:hover{color:var(--pg-fg)}
      .lp-bar a:focus-visible{outline:2px solid var(--pg-focus);outline-offset:2px;border-radius:4px}
      .lp-panes{display:grid;grid-template-columns:minmax(0,1fr);background:var(--pg-soft)}
      :root[data-style="clean"] .lp-panes{background:var(--dm-stage)}
      :root:not([data-style="soft"],[data-style="clean"]){--lp-grid:rgba(20,20,12,.018)}
      @media (prefers-color-scheme: dark){:root:not([data-theme="light"]):not([data-style="soft"],[data-style="clean"]){--lp-grid:rgba(255,255,255,.014)}}
      :root[data-theme="dark"]:not([data-style="soft"],[data-style="clean"]){--lp-grid:rgba(255,255,255,.014)}
      :root:not([data-style="soft"],[data-style="clean"]) .lp-panes{background-image:linear-gradient(var(--lp-grid) 1px,transparent 1px),linear-gradient(90deg,var(--lp-grid) 1px,transparent 1px);background-size:24px 24px;background-position:-1px -1px}
      .lp-pane{display:flex;flex-direction:column;min-width:0}
      .lp-pane+.lp-pane{box-shadow:inset 0 1px 0 var(--lp-hair)}
      @media (min-width:1200px){
        .lp-panes.ww{grid-template-columns:repeat(2,minmax(0,1fr))}
        .lp-panes.wn{grid-template-columns:minmax(0,1fr) 488px}
        .lp-panes:is(.ww,.wn)>.lp-pane+.lp-pane{box-shadow:inset 1px 0 0 var(--lp-hair)}
      }
      .lp-demo{flex:1;display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:center;padding:48px 24px;overflow-anchor:none}
      .lp-win.stack .lp-demo{padding-top:32px;padding-bottom:32px}
      /* a picked style fits each stage to it; the visitor's own click, so the page may move then */
      @media (prefers-reduced-motion:no-preference){.lp-demo{transition:min-height 340ms var(--lp-ease)}}
      .lp-demo>.card{min-width:0;align-self:stretch;display:grid;place-items:center}
      .lp-anim{flex:none;display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border:0;border-radius:999px;background:var(--pg-bg);box-shadow:inset 0 0 0 1px var(--pg-line2);color:var(--pg-dim);font:500 13px/1 var(--pg-sans);cursor:pointer;transition:color 220ms var(--lp-ease),background-color 220ms var(--lp-ease)}
      .lp-anim:hover{color:var(--pg-fg);background:var(--pg-soft)}
      .lp-anim svg{width:14px;height:14px}
      /* a demo that couldn't load says so and links to its page */
      .lp-miss{margin:0;color:var(--pg-dim);font-size:14px}

      /* ---- sections: a line across the column, then the heading on the left and what the section is on the right ---- */
      .lp-sec{padding-top:var(--lp-sec)}
      .lp-sh{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:8px 48px;padding-top:24px;margin-bottom:48px;border-top:1px solid var(--pg-line)}
      .lp-sh h2{margin:0;font-size:14px;line-height:20px;font-weight:500;letter-spacing:0;color:var(--pg-fg)}
      .lp-sh p{margin:0;max-width:64ch;font-size:14px;line-height:1.6;color:var(--pg-dim)}
      .lp-sh .lp-more{grid-column:2;justify-self:start;margin-top:8px}
      .lp-more{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:500;color:var(--pg-fg);text-decoration:none}
      .lp-more:hover .lp-ar{transform:translateX(2px)}
      .lp-more .lp-ar{transition:transform 220ms var(--lp-ease)}
      @media (max-width:860px){.lp-sh{grid-template-columns:minmax(0,1fr)}.lp-sh .lp-more{grid-column:1}}
      /* a text section: its heading and what it is on the left, its content on the right, on the same columns */
      .lp-two{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:24px 48px;padding-top:24px;border-top:1px solid var(--pg-line)}
      .lp-two+.lp-two{margin-top:64px}
      .lp-h h2{margin:0;font-size:14px;line-height:20px;font-weight:500;letter-spacing:0;color:var(--pg-fg)}
      .lp-h p{margin:8px 0 0;max-width:52ch;font-size:14px;line-height:1.6;color:var(--pg-dim)}
      .lp-h .lp-more{margin-top:16px}
      .lp-h p a{color:var(--pg-fg)}
      @media (max-width:860px){.lp-two{grid-template-columns:minmax(0,1fr)}}

      /* ---- the wall: every component, four rows that drift in turn left and right, across the whole window. A row holds still
         under the pointer or while a tile in it has the focus; with reduced motion the rows stand still and scroll by hand ---- */
      /* the rows run across a backdrop the full width of the window, the tiles on it like prints on a table */
      .lp .lp-rows{display:flex;flex-direction:column;gap:16px;padding:56px 0;border-radius:0}
      .lp-art[data-art="wall"]{--a1:var(--dm-c6);--a2:var(--dm-c2);--a3:var(--dm-accent);--a4:var(--dm-c4)}
      /* each row clips the tiles that drift past its ends, with room above and below for their shadows */
      .lp-row{overflow:hidden;padding:16px 0;margin:-16px 0}
      .lp-track{display:flex;width:max-content;animation:lp-drift var(--dur,200s) linear infinite}
      .lp-row.rev .lp-track{animation-direction:reverse}
      .lp-set{display:flex;gap:16px;padding-right:16px}
      @keyframes lp-drift{to{transform:translateX(-50%)}}
      .lp-row:hover .lp-track,.lp-row:focus-within .lp-track{animation-play-state:paused}
      .lp-wt{flex:none;display:flex;flex-direction:column;gap:8px;width:240px;padding:6px 6px 10px;border-radius:var(--lp-r2);background:var(--pg-bg);box-shadow:var(--dm-shadow);color:var(--pg-fg);text-decoration:none;transition:background-color 220ms var(--lp-ease)}
      .lp-wt:hover{background:var(--pg-soft)}
      .lp-wt:focus-visible{outline:2px solid var(--pg-focus);outline-offset:-2px}
      .lp-wt img{display:block;width:100%;height:auto;aspect-ratio:16/10;border-radius:max(0px,calc(var(--lp-r2) - 6px));background:var(--pg-soft)}
      .lp-wt span{padding:0 4px;font-size:13px;line-height:18px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      @media (max-width:640px){.lp-wt{width:176px}.lp .lp-rows{padding:24px 0;margin:0}}
      @media (prefers-reduced-motion:reduce){.lp-track{animation:none}.lp-set[aria-hidden]{display:none}.lp-row{overflow-x:auto;scrollbar-width:none}.lp-row::-webkit-scrollbar{display:none}}

      /* ---- screens: each one's backdrop and window, then its name and one line on the section's columns ---- */
      .lp-scrs{display:flex;flex-direction:column;gap:96px}
      .lp-scr{margin:0}
      .lp-scap{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:4px 48px;margin-top:24px}
      .lp-scap h3{margin:0;font-size:14px;line-height:20px;font-weight:500;color:var(--pg-fg)}
      .lp-scap p{margin:0;max-width:64ch;font-size:14px;line-height:20px;color:var(--pg-dim);text-wrap:pretty}
      @media (max-width:860px){.lp-scap{grid-template-columns:minmax(0,1fr)}}

      /* ---- styles: the three to pick from, and a demo beside them on a backdrop ---- */
      .lp-sty{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:24px 48px;align-items:start}
      .lp-opts{display:flex;flex-direction:column;gap:8px}
      /* each style is a choice: white with a quiet edge, a stronger edge and a filled dot when it's picked */
      .lp-opt{display:grid;grid-template-columns:16px minmax(0,1fr);gap:4px 12px;align-items:start;width:100%;padding:16px;border:0;border-radius:var(--lp-r2);background:var(--pg-bg);box-shadow:inset 0 0 0 1px var(--pg-line2);color:var(--pg-fg);font:inherit;text-align:left;cursor:pointer;transition:background-color 220ms var(--lp-ease),box-shadow 220ms var(--lp-ease)}
      .lp-opt:hover{background:var(--pg-soft)}
      .lp-opt[aria-checked="true"]{box-shadow:inset 0 0 0 1px var(--pg-field)}
      .lp-opt .lp-dot{grid-row:span 3;width:16px;height:16px;margin-top:2px;border-radius:50%;box-shadow:inset 0 0 0 1.5px var(--pg-field);transition:box-shadow 220ms var(--lp-ease),background-color 220ms var(--lp-ease)}
      .lp-opt[aria-checked="true"] .lp-dot{background:var(--pg-fg);box-shadow:inset 0 0 0 4.5px var(--pg-fg),inset 0 0 0 16px var(--pg-bg)}
      .lp-opt b{font-weight:500;font-size:14px;line-height:20px}
      .lp-opt span:not(.lp-dot){font-size:14px;line-height:20px;color:var(--pg-dim)}
      .lp-opt code{justify-self:start;margin-top:8px;font-size:12px}
      .lp-opt:focus-visible{outline:2px solid var(--pg-focus);outline-offset:2px}
      .lp-theme{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;margin-top:16px;font-size:13px;color:var(--pg-muted)}
      .lp-theme .pg-seg button{height:28px;padding:0 12px}
      @media (max-width:1099px){.lp-sty{grid-template-columns:minmax(0,1fr)}}

      /* ---- install: the command for each way to add it, the files it writes, then the prompt for a coding agent ---- */
      .lp-add{min-width:0}
      .lp-tl{display:flex;gap:4px;margin:0 0 16px;overflow-x:auto;scrollbar-width:none;box-shadow:inset 0 -1px 0 var(--pg-line)}
      @media (pointer:coarse){.lp-tl{padding:2px 0;margin:-2px 0 14px;box-shadow:none;background:linear-gradient(var(--pg-line),var(--pg-line)) 0 calc(100% - 2px)/100% 1px no-repeat}}
      .lp-tl button{position:relative;flex:none;display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 10px;border:0;background:none;color:var(--pg-dim);font:400 14px/1 var(--pg-sans);cursor:pointer;transition:color 220ms var(--lp-ease)}
      .lp-tl button:first-child{padding-left:0}
      .lp-tl button:first-child::after{left:0}
      .lp-tl button:hover,.lp-tl button[aria-selected="true"]{color:var(--pg-fg)}
      .lp-tl button::after{content:"";position:absolute;left:10px;right:10px;bottom:0;height:2px;border-radius:2px;background:var(--pg-fg);transform:scaleX(0);transition:transform 340ms var(--lp-ease)}
      .lp-tl button[aria-selected="true"]::after{transform:scaleX(1)}
      .lp-tl .cp-mk{width:16px;height:16px}
      .lp-line{display:flex;align-items:center;gap:10px;min-width:0;min-height:48px;padding:8px 8px 8px 16px;border-radius:var(--lp-r1);background:var(--pg-soft);box-shadow:inset 0 0 0 1px var(--pg-line)}
      .lp .lp-line code{background:none;padding:0;border-radius:0;color:var(--pg-fg)}
      .lp .lp-line .d{flex:none;color:var(--pg-muted);font:500 13px/1 var(--pg-mono)}
      .lp .lp-line .c{flex:1;min-width:0;overflow-wrap:anywhere;font:500 13px/1.5 var(--pg-mono)}
      .lp-line .lp-w{white-space:nowrap}
      .lp-copy{flex:none;display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border:0;border-radius:999px;background:var(--pg-bg);color:var(--pg-fg);box-shadow:inset 0 0 0 1px var(--pg-line2);font:500 13px/1 var(--pg-sans);cursor:pointer;transition:background-color 220ms var(--lp-ease)}
      .lp-copy:hover{background:var(--pg-chip)}
      .lp-copy svg{width:14px;height:14px}
      .lp-tp>p{margin:16px 0 0;max-width:72ch;font-size:14px;line-height:1.6;color:var(--pg-dim)}
      /* the files it writes, as an editor on a backdrop: one file to a row on the left (the component's own, then the shared
         ones it adds once per project), and the first lines of the one picked on the right, as they are installed */
      .lp-ed-art{margin-top:32px}
      .lp-ed .lp-bar{justify-content:flex-start}
      .lp .lp-ed .lp-bar code{font-size:12px}
      .lp-ed-b{display:grid;grid-template-columns:232px minmax(0,1fr)}
      .lp-tree{display:flex;flex-direction:column;gap:2px;min-width:0;padding:8px;box-shadow:inset -1px 0 0 var(--lp-hair)}
      .lp-tg{padding:12px 8px 4px;font-size:12px;line-height:16px;color:var(--pg-muted)}
      .lp-tg:first-child{padding-top:4px}
      .lp-tf{display:grid;grid-template-columns:16px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;height:32px;padding:0 8px;border:0;border-radius:var(--lp-r1);background:none;color:var(--pg-dim);font:400 13px/1 var(--pg-sans);text-align:left;cursor:pointer;transition:background-color 220ms var(--lp-ease),color 220ms var(--lp-ease),box-shadow 220ms var(--lp-ease)}
      .lp-tf:hover{background:var(--pg-soft);color:var(--pg-fg)}
      .lp-tf[aria-selected="true"]{background:var(--pg-bg);box-shadow:inset 0 0 0 1px var(--pg-line2);color:var(--pg-fg)}
      .lp-tf:focus-visible{outline:2px solid var(--pg-focus);outline-offset:-2px}
      .lp-tf .n{min-width:0;line-height:20px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .lp-tf .d,.lp-tf .m{color:var(--pg-muted)}
      .lp-tf .m{font-size:12px;font-variant-numeric:tabular-nums}
      .lp-fi{width:16px;height:16px;color:var(--pg-muted)}
      .lp-code{min-width:0;height:352px;background:var(--pg-soft)}
      :root[data-style="clean"] .lp-code{background:var(--dm-stage)}
      .lp-cp{display:flex;flex-direction:column;height:100%}
      .lp-cph{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;margin:0;padding:12px 16px;box-shadow:inset 0 -1px 0 var(--lp-hair);font-size:12px;line-height:20px;color:var(--pg-muted)}
      .lp .lp-cph code{min-width:0;background:none;padding:0;font-size:12px;line-height:20px;color:var(--pg-fg);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .lp-cph span{flex:none}
      .lp-cp pre{flex:1;min-height:0;margin:0;padding:12px 16px 16px 0;overflow:auto;font:500 12px/20px var(--pg-mono);font-variant-ligatures:none;color:var(--pg-fg);counter-reset:ln;scrollbar-width:thin}
      .lp .lp-cp pre code{display:block;width:max-content;min-width:100%;background:none;padding:0;border-radius:0;font:inherit;color:inherit}
      .lp-cp pre .l{display:block;white-space:pre;counter-increment:ln}
      .lp-cp pre .l::before{content:counter(ln);display:inline-block;width:32px;margin-right:16px;text-align:right;color:var(--pg-muted);user-select:none}
      .lp-cp pre.ls{padding-left:16px}
      .lp-cp pre.ls .l::before{content:none}
      /* a file longer than what is shown fades out at the foot */
      .lp-cp pre.cut{-webkit-mask-image:linear-gradient(#000 calc(100% - 72px),transparent);mask-image:linear-gradient(#000 calc(100% - 72px),transparent)}
      .lp-cp pre:focus-visible{outline:2px solid var(--pg-focus);outline-offset:-2px}
      .lp-cpn{margin:0;padding:16px;max-width:52ch;font-size:13px;line-height:20px;color:var(--pg-dim)}
      @media (max-width:640px){.lp-ed-b{grid-template-columns:minmax(0,1fr)}.lp-tree{box-shadow:inset 0 -1px 0 var(--lp-hair)}}
      .lp-prompt{position:relative}
      .lp-prompt pre{margin:0;padding:16px 88px 16px 16px;border-radius:var(--lp-r1);background:var(--pg-soft);box-shadow:inset 0 0 0 1px var(--pg-line);font:500 12.5px/1.65 var(--pg-mono);font-variant-ligatures:none;color:var(--pg-fg);white-space:pre-wrap;overflow-wrap:anywhere}
      .lp .lp-prompt pre code{background:none;padding:0;border-radius:0;font:inherit;color:inherit}
      .lp-prompt .lp-copy{position:absolute;top:10px;right:10px}
      /* on a phone the tabs lose their marks so all four fit, and the prompt starts under its Copy button */
      @media (max-width:640px){.lp-tl .cp-mk{display:none}.lp-tl button{padding:0 8px}.lp-prompt pre{padding:52px 16px 16px}}

      /* ---- built in: facts as a plain list, two across ---- */
      .lp-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 48px;margin:0;padding:0;list-style:none}
      .lp-facts li{display:grid;grid-template-columns:20px minmax(0,1fr);gap:4px 12px;align-content:start}
      .lp-facts svg{grid-row:span 2;width:20px;height:20px;color:var(--pg-dim)}
      .lp-facts b{font-weight:500;font-size:14px;line-height:20px}
      .lp-facts p{margin:0;font-size:14px;line-height:1.6;color:var(--pg-dim)}
      @media (max-width:640px){.lp-facts{grid-template-columns:minmax(0,1fr)}}

      /* ---- start: the library and GitHub, then DesignMe ---- */
      .lp-act{margin:0;max-width:60ch;font-size:14px;line-height:1.6;color:var(--pg-dim)}
      .lp-act+.lp-cta{margin-top:24px}
      .lp-gh svg{width:16px;height:16px}
      /* Book a call, the site's own: a rectangle with the fields' squircle corners, as tall as the buttons beside it */
      .lp-book{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 14px 0 16px;border-radius:10px;background:var(--pg-bg);box-shadow:inset 0 0 0 1px var(--pg-line2);color:var(--pg-fg);font-size:14px;font-weight:500;text-decoration:none;transition:background-color 220ms var(--lp-ease)}
      @supports (corner-shape:squircle){.lp-book{corner-shape:squircle;border-radius:16px}}
      .lp-book:hover{background:var(--pg-chip)}
      .lp-mail{display:inline-flex;align-items:center;height:40px;font-size:14px;color:var(--pg-dim)}
      .lp-mail a{margin-left:4px;color:var(--pg-fg)}

      /* ---- questions: a plain list that opens one answer at a time ---- */
      .lp-faq{margin:-14px 0 0}
      .lp-faq details{border-bottom:1px solid var(--lp-hair)}
      .lp-faq summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:52px;padding:14px 0;font-size:14px;line-height:20px;font-weight:500;cursor:pointer;list-style:none}
      .lp-faq summary::-webkit-details-marker{display:none}
      .lp-faq summary::after{content:"";flex:none;width:7px;height:7px;margin-right:4px;border-right:1.5px solid var(--pg-muted);border-bottom:1.5px solid var(--pg-muted);transform:translateY(-2px) rotate(45deg);transition:transform 220ms var(--lp-ease)}
      .lp-faq details[open] summary::after{transform:translateY(2px) rotate(225deg)}
      .lp-faq summary:hover{color:var(--pg-dim)}
      .lp-faq p{margin:0;padding:0 32px 18px 0;max-width:72ch;font-size:14px;line-height:1.65;color:var(--pg-dim)}
      .lp-end{height:var(--lp-sec)}

      /* smaller screens: the backdrops' room shrinks first, then the page's edges and the room between sections; on a phone
         a backdrop runs to the window's edges */
      @media (max-width:1199px){.lp-art{padding:32px}}
      .lp-art.lp-ed-art{padding:32px}
      @media (max-width:960px){.lp{--lp-sec:120px}.lp-in{padding:0 24px}.lp-hero{padding-top:64px}.lp-show-w{margin-top:64px}}
      @media (max-width:640px){
        .lp{--lp-sec:96px}
        .lp-in{padding:0 16px}
        .lp-hero{padding-top:40px}
        .pg-h1.lp-h1{font-size:34px}
        .lp-art,.lp-art.lp-ed-art{margin:0 -16px;padding:16px;border-radius:0}
        .lp-art.lp-ed-art{margin-top:32px}
        .lp-demo{padding:48px 16px}
        .lp-cta .lp-btn{flex:1 1 auto}
        .lp-show{aspect-ratio:auto;height:600px;background:transparent;box-shadow:none}
        .lp-show .dvf-dev{box-shadow:0 0 0 1px var(--dvf-line),var(--dm-shadow-pop)}
        .lp-show-w{margin-top:56px}
        .lp-scrs{gap:72px}
        .lp-scap{margin-top:20px}
      }
      @media (max-width:380px){.pg-h1.lp-h1{font-size:32px}}
      /* the larger-headings variant (/?headings=large): section headings and screen names set large and tight, as the
         references do. Not the default: the type rule keeps them at 14px */
      :root[data-lp-h="large"] :is(.lp-sh h2,.lp-h h2){max-width:20ch;font-size:clamp(26px,2.6vw,38px);line-height:1.1;letter-spacing:-.03em;text-wrap:balance}
      :root[data-lp-h="large"] :is(.lp-sh,.lp-two){padding-top:32px}
      :root[data-lp-h="large"] .lp-h p{margin-top:12px}
      :root[data-lp-h="large"] .lp-sh p{padding-top:8px}
      :root[data-lp-h="large"] .lp-sh{row-gap:12px}
      :root[data-lp-h="large"] .lp-scap h3{font-size:20px;line-height:28px;letter-spacing:-.015em}
