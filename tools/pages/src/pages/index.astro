      /* ---- inside: the library's groups, in two columns, as plain lists ---- */
      .lp-sets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px 32px}
      .lp-set h3{display:flex;align-items:baseline;gap:8px;margin:0 0 4px;font-size:14px;line-height:20px;font-weight:500}
      .lp-set h3 span,.lp-g .n{color:var(--pg-muted);font-weight:400;font-variant-numeric:tabular-nums}
      .lp-gs{margin:0;padding:0;list-style:none}
      .lp-g{padding:14px 0;border-bottom:1px solid color-mix(in srgb,var(--pg-line2) 50%,transparent)}
      .lp-g a{display:inline-flex;align-items:baseline;gap:8px;font-size:14px;line-height:20px;font-weight:500;color:var(--pg-fg);text-decoration:none}
      .lp-g a:hover{text-decoration:underline;text-decoration-color:var(--pg-line2);text-underline-offset:3px}
      .lp-g p{margin:2px 0 0;font-size:14px;line-height:20px;color:var(--pg-dim)}
      @media (max-width:640px){.lp-sets{grid-template-columns:minmax(0,1fr)}}

      /* ---- built in: facts as a plain list, two across ---- */
      .lp-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px;margin:0;padding:0;list-style:none}
      .lp-facts li{display:grid;grid-template-columns:20px minmax(0,1fr);gap:4px 12px;align-content:start}
