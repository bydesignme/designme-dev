      <script type="application/json" id="lp-wall-data" set:html={WALL} />
      <script is:inline>
      // and each card plays its component (owner, 26 Nov: "can we animate these cards here?"): the installed HTML, CSS and JS on
      // the shared core (/r/<name>.json, as the bento loads them), each in a frame of its own, so everything the demo places
      // by measuring (its pointer, popovers, tooltips) lands where it does in the library. The frame is laid out at the size
      // the card's picture frames the component (the component at its largest in the style on screen, 40px round it, at
      // 16:10) and scaled down to the picture's box, with the component in the middle of it, so it grows and shrinks there
      // without being cut off or moving its card.
      //  - only the few cards nearest the middle of the screen play (four, two on a phone: two and one a row): every one playing at once (26 at
      //    1440) dropped the drift to 15 frames a second. The others show their picture. A card's frame is made when it first
      //    comes to play (two a frame); one that stops holds its demo, as a mouse resting on a component holds it, pauses its
      //    animations and draws nothing (dm-idle, as the library's far-away cards), so its picture shows, and its frame is
      //    taken down once it has not played for 20 seconds
      //  - the pointer coming onto a card plays its demo again from the beginning
      //  - the frames follow the page's style and theme, and a new style starts them again, as it does the bento's demos
      //  - with reduced motion there are no frames: the pictures stand still, as the rows do
      (function(){
        var rows = document.querySelector('.lp-rows'), data = document.getElementById('lp-wall-data');
        if (!rows || !data || !('IntersectionObserver' in window) || !window.fetch) return;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)'); if (reduce.matches && !window.DM_WALL_MEASURE) return;
        var W = JSON.parse(data.textContent), root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)'), MEASURE = !!window.DM_WALL_MEASURE;
        var cards = [].slice.call(rows.querySelectorAll('.lp-wt'));
        var styleOf = function(){ var s = root.getAttribute('data-style'); return s === 'soft' || s === 'clean' ? s : 'bp'; };
        var themeOf = function(){ var t = root.getAttribute('data-theme'); return t === 'dark' || t === 'light' ? t : mq.matches ? 'dark' : 'light'; };
        var got = {};
        var files = function(reg){ return got[reg] || (got[reg] = fetch('/r/' + reg + '.json').then(function(r){ if (!r.ok) throw new Error(r.status); return r.json(); }).then(function(d){
          var f = function(ext){ var x = d.files.filter(function(x){ return x.path.slice(-ext.length) === ext; })[0]; return x ? x.content : ''; };
          return { html:f('.html'), css:f('.css'), js:f('.js').replace(/<\/script/gi, '<\\/script') };
        })); };
        // the component's stage, as on its own page and in its picture (tools/pages/wall.mjs): the site's grey, the component in
        // the middle; a demo's own switch (its variants, under the component) stays out of the picture, as there, and so do the demo's pointer and tooltips, which read as specks at a card's size
        var STAGE = 'html,body{margin:0;height:100%;overflow:hidden}html{background:#fafafa}html[data-theme="dark"]{background:#1c1c1c;color-scheme:dark}html[data-style="clean"]{background:var(--dm-stage)}'
          + 'body{font:14px/1.6 Inter,ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased}'
          + '.stage-inner{height:100%;display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;align-items:center}.stage-inner>.card{min-width:0;display:grid;place-items:center}'
          + '.stage-in>.dm>.demo{position:absolute!important;visibility:hidden!important}'
          + '.hand,.tip{visibility:hidden!important}'
          + 'html.lp-off *,html.lp-off *::before,html.lp-off *::after{animation-play-state:paused!important}';
        var attrs = function(){ var s = styleOf(); return ' data-theme="' + themeOf() + '"' + (s === 'bp' ? '' : ' data-style="' + s + '"'); };
        // (the style tags are written out in pieces, so the page's build, which reads every style in the page, leaves them be)
        var css = function(t){ return '<' + 'style>' + t + '</' + 'style>'; };
        var page = function(f){ return '<!doctype html><html lang="en"' + attrs() + '><head><meta charset="utf-8">' + css(W.font) + '<link rel="stylesheet" href="/components/assets/core.css">' + css(f.css) + css(STAGE) + '</head>'
