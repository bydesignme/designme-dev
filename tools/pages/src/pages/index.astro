      </div>
      <script is:inline>
      // each picture in the style and theme on screen (tools/pages/wall.mjs takes a set of each), swapped when either changes
      (function(){
        var root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)'), imgs = [].slice.call(document.querySelectorAll('.lp-wt img'));
        var set = function(){
          var s = root.getAttribute('data-style'), t = root.getAttribute('data-theme') || (mq.matches ? 'dark' : 'light');
          var dir = '/components/wall/' + (s === 'soft' || s === 'clean' ? s : 'bp') + '-' + (t === 'dark' ? 'dark' : 'light') + '/';
          imgs.forEach(function(i){ var u = dir + i.parentNode.getAttribute('data-reg') + '.webp'; if (i.getAttribute('src') !== u) i.setAttribute('src', u); });
        };
        set();
        new MutationObserver(set).observe(root, { attributes:true, attributeFilter:['data-style', 'data-theme'] });
        if (mq.addEventListener) mq.addEventListener('change', set);
      })();
      </script>
