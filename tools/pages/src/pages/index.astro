  <Fragment slot="end">
    <script is:inline src="/components/assets/core.js"></script>
    <script is:inline set:html={FRAME_JS} />
    <script is:inline>
    (function(){
      if (typeof DM === 'undefined') return;
      // the demos: each one's files come from the registry (/r/<name>.json) once it is within a screen of the view, and it
      // starts once a quarter of it is on screen
      var got = {};
      var files = function(reg){ return got[reg] || (got[reg] = fetch('/r/' + reg + '.json').then(function(r){ if (!r.ok) throw new Error(r.status); return r.json(); }).then(function(d){
        var f = function(ext){ var x = d.files.filter(function(x){ return x.path.slice(-ext.length) === ext; })[0]; return x ? x.content : ''; };
        var st = document.createElement('style'); st.textContent = f('.css'); document.head.appendChild(st);
        var sc = document.createElement('script'); sc.textContent = f('.js'); document.body.appendChild(sc);
        return f('.html');
      })); };
      var start = new IntersectionObserver(function(es){ es.forEach(function(en){ if (!en.isIntersecting) return; start.unobserve(en.target); DM.mount(en.target); }); }, { threshold:.25 });
      var near = new IntersectionObserver(function(es){ es.forEach(function(en){
        if (!en.isIntersecting) return; var box = en.target; near.unobserve(box);
        files(box.dataset.reg).then(function(html){
          box.innerHTML = html; var card = box.firstElementChild;
          if (card && DM.defs[card.dataset.c]) start.observe(card);
        }).catch(function(){
          box.innerHTML = '<p class="lp-miss">This demo didn’t load. <a href="' + box.dataset.url + '">See it on its page</a>.</p>';
        });
      }); }, { rootMargin:'100% 0px' });
      [].slice.call(document.querySelectorAll('.lp-demo[data-reg]')).forEach(function(box){ near.observe(box); });
      // Animate plays every demo in its window again, from the start, including one the visitor has taken over
      document.querySelectorAll('[data-replay]').forEach(function(b){ b.addEventListener('click', function(){
        b.closest('.lp-win').querySelectorAll('.lp-demo > .card[data-c]').forEach(function(card){ if (DM.defs[card.dataset.c]) DM.mount(card); });
      }); });
      // a new style starts the demos that are playing again, as a component page does; one the visitor has taken over stays
      // theirs until Animate
      document.addEventListener('pg-style', function(){ document.querySelectorAll('.lp-demo > .card[data-c]').forEach(function(card){ if (card._c && !card._c.mine) DM.mount(card); }); });
    })();
    (function(){
      // the templates, live in the first screen: the first loads once the page has (so it never holds up the page), and the
      // two take turns every 9 seconds while the frame is on screen. A mouse resting on the frame holds the turn; a click,
      // key or scroll inside the app, or a pick on the switch, ends the turns for good. With reduced motion they never turn.
      // On a phone the app shows its phone layout in a phone's frame. On a desktop the app is laid out at least 1376px wide (the
      // Sales CRM's table needs about 1312px) and scaled down to the frame's width when that is narrower
      var box = document.querySelector('.lp-show'); if (!box || !window.dmFrame) return;
      var T = JSON.parse(box.dataset.tpls), segs = [].slice.call(document.querySelectorAll('.lp-tpls [data-tpl]'));
      var open = document.querySelector('.lp-open'), ph = box.querySelector('.lp-show-ph');
      var phone = matchMedia('(max-width:640px)'), reduce = matchMedia('(prefers-reduced-motion: reduce)');
      var at = 0, done = reduce.matches, held = false, seen = true, started = false;
      var stop = function(){ done = true; };
      var v = window.dmFrame(box, { fill:1376, title:function(src){ var t = T.filter(function(x){ return src.indexOf(x.url) === 0; })[0]; return (t ? t.name : 'Template') + ', live'; }, onUse:stop,
        onLoad:function(){ if (ph) ph.hidden = true; } });
      var show = function(i){
        at = i; var t = T[i];
        segs.forEach(function(b, k){ var on = k === i; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
        open.href = t.url; open.setAttribute('aria-label', 'Open ' + t.name + ', opens in a new tab');
        box.setAttribute('aria-label', t.name + ', live');
        // the page's file, so it loads from any static server (Cloudflare Pages sends it on to the page's own address,
        // keeping ?embed=1; the page also knows it is framed here)
        v.show(t.url + '.html?embed=1', phone.matches ? 'mobile' : 'desktop');
      };
      segs.forEach(function(b){ b.addEventListener('click', function(e){ if (e.isTrusted) stop(); show(+b.dataset.tpl); }); });
      box.addEventListener('mouseenter', function(){ held = true; }); box.addEventListener('mouseleave', function(){ held = false; });
      if ('IntersectionObserver' in window) new IntersectionObserver(function(es){ seen = es[es.length - 1].isIntersecting; }).observe(box);
      if (phone.addEventListener) phone.addEventListener('change', function(){ if (started) v.device(phone.matches ? 'mobile' : 'desktop'); });
      if (reduce.addEventListener) reduce.addEventListener('change', function(){ if (reduce.matches) stop(); });
      var begin = function(){ if (started) return; started = true; show(at);
        setInterval(function(){ if (done || held || !seen || document.hidden || box.matches(':hover')) return; show((at + 1) % T.length); }, 9000); };
      if (document.readyState === 'complete') setTimeout(begin, 100); else addEventListener('load', function(){ setTimeout(begin, 100); });
    })();
    (function(){
      // the styles to pick from are one group of radio buttons: the arrow keys move through them and pick (the header's
      // script handles every [data-style-set])
      document.querySelectorAll('.lp-opts[role="radiogroup"]').forEach(function(g){ g.addEventListener('keydown', function(e){
        var d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        var bs = [].slice.call(g.querySelectorAll('[role="radio"]')), i = bs.indexOf(document.activeElement);
        if (!d || i < 0) return; e.preventDefault(); var n = bs[(i + d + bs.length) % bs.length]; n.click(); n.focus();
      }); });
      // how to add it: a click or the arrow keys show one way at a time
      var tabs = [].slice.call(document.querySelectorAll('.lp-tl [role="tab"]'));
      var pick = function(t, focus){ tabs.forEach(function(b){ var on = b === t; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; document.getElementById(b.getAttribute('aria-controls')).hidden = !on; }); if (focus) t.focus(); };
      tabs.forEach(function(b, i){
        b.addEventListener('click', function(){ pick(b); });
        b.addEventListener('keydown', function(e){ var d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0; if (e.key === 'Home') d = -i; if (e.key === 'End') d = tabs.length - 1 - i; if (!d) return; e.preventDefault(); pick(tabs[(i + d + tabs.length) % tabs.length], true); });
      });
      // the files it writes: a click or the up and down arrows show one file at a time
      document.querySelectorAll('.lp-tree[role="tablist"]').forEach(function(list){
        var fs = [].slice.call(list.querySelectorAll('[role="tab"]'));
        var sel = function(t, focus){ fs.forEach(function(b){ var on = b === t; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; document.getElementById(b.getAttribute('aria-controls')).hidden = !on; }); if (focus) t.focus(); };
        fs.forEach(function(b, i){
          b.addEventListener('click', function(){ sel(b); });
          b.addEventListener('keydown', function(e){ var d = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0; if (e.key === 'Home') d = -i; if (e.key === 'End') d = fs.length - 1 - i; if (!d) return; e.preventDefault(); sel(fs[(i + d + fs.length) % fs.length], true); });
        });
      });
    })();
    </script>
  </Fragment>
</Page>
