      <script is:inline>
      // the release label's light: an outline drawn just inside the label's edge, its corners following the label's (square in
      // Blueprint, round elsewhere), measured as 100 so the dash keeps one speed; it runs only while the label is on screen
      (function(){
        var rel = document.querySelector('.lp-rel'), svg = rel && rel.querySelector('.lp-beam'); if (!svg) return;
        var fit = function(){ var w = rel.offsetWidth, h = rel.offsetHeight, r = Math.max(0, Math.min(parseFloat(getComputedStyle(rel).borderTopLeftRadius) || 0, h / 2) - 1);
          [].forEach.call(svg.querySelectorAll('rect'), function(t){ var l = parseFloat(t.style.getPropertyValue('--l'));
            t.setAttribute('x', 1); t.setAttribute('y', 1); t.setAttribute('width', Math.max(0, w - 2)); t.setAttribute('height', Math.max(0, h - 2));
            t.setAttribute('rx', r); t.setAttribute('ry', r); t.setAttribute('pathLength', 100); t.setAttribute('stroke-dasharray', l + ' ' + (100 - l)); }); };
        fit();
        if (window.ResizeObserver) new ResizeObserver(fit).observe(rel);
        new MutationObserver(fit).observe(document.documentElement, { attributes:true, attributeFilter:['data-style'] });
        if (window.IntersectionObserver) new IntersectionObserver(function(es){ rel.classList.toggle('on', es[es.length - 1].isIntersecting); }).observe(rel);
        else rel.classList.add('on');
