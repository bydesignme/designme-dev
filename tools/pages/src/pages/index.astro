      .lp-faq details[open] summary::after{transform:translateY(2px) rotate(225deg)}
      .lp-faq summary:hover{color:var(--pg-dim)}
      .lp-faq summary:focus-visible{outline:2px solid var(--pg-focus);outline-offset:2px;border-radius:4px}
      .lp-fa p{margin:0;padding:0 40px 24px 0;max-width:64ch;font-size:14px;line-height:1.7;color:var(--pg-dim)}
      @media (prefers-reduced-motion:no-preference){
        .lp-faq details::details-content{height:0;overflow:clip;opacity:0;transition:height 340ms var(--lp-ease),opacity 220ms var(--lp-ease),content-visibility 340ms allow-discrete}
        .lp-faq details[open]::details-content{height:auto;opacity:1}
      }
      @media (min-width:961px){
        .lp-qa{grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:48px;align-items:start}
        .lp-qa .lp-qh{position:sticky;top:calc(var(--pg-head) + 48px);align-items:flex-start;max-width:none;margin:0;text-align:left}
