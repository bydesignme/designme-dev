---
// /docs/<page>: Introduction, Installation, Theming, Accessibility and Using with AI (their text is in src/lib/docs.mjs)
import DocsPage from '../../components/DocsPage.astro';
import { DOCS } from '../../lib/docs.mjs';
export function getStaticPaths(){
  return DOCS.map(d => ({ params:{ slug:d.slug }, props:{ d } }));
}
const { d } = Astro.props;
---
<DocsPage d={d} />
