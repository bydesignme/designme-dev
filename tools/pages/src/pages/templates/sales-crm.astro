---
// /templates/sales-crm: a sales CRM where an agent works beside the rep, made of the library's own components as a showcase
// of what they build. The sidebar switches between five views: Accounts (a table with each account's next step, health and
// the agent's suggestion), the Agent inbox (what the agent prepared, to approve, edit or dismiss), the Calendar (the reps'
// week of meetings, the deals closing each day, and follow-up slots the agent proposes), the Pipeline (a deals board) and
// the Forecast. Saved views in the sidebar filter the accounts. Everything is drawn with the components' own classes and
// tokens, from their installed CSS, so the screen follows Soft and Blueprint, light and dark, with the site's switches. Its
// data and interactions are one script (src/templates/sales-crm/crm.js); the layout around the components is
// src/templates/sales-crm/crm.css. Noindex and out of the sitemap, llms.txt and the site's navigation until the owner
// decides where to link it.
import fs from 'node:fs';
import path from 'node:path';
import Page from '../../layouts/Page.astro';
import { ROOT, COMPONENTS } from '../../lib/data.mjs';

// the components the screen is made of, by their registry name: each one's installed CSS is on the page
const USES = ['agent-harness', 'task-table', 'progress', 'kanban-board', 'details-panel', 'filter-menu', 'search-input', 'form', 'toast',
  'activity-heatmap', 'notifications', 'profile-menu', 'command-palette', 'stat-cards', 'line-chart', 'radial-goals', 'funnel-chart',
  'event-calendar', 'agent-inbox', 'health-score', 'decision-prompt', 'date-picker', 'banner', 'draft-review', 'rewrite-toolbar',
  'inline-text-diff', 'bar-chart', 'top-pages'];
// the screen's type scale: five sizes from the library's own (11, 12, 13, 14 and the 16px title), nothing under 11px. Every
// component's text snaps to the nearest step at or below it; a display number (Health score's score, Stat cards' values) keeps
// its size
const SCALE = v => v >= 15 ? v : v >= 13.75 ? 14 : v >= 12.75 ? 13 : v >= 11.75 ? 12 : 11;
const snap = t => t.replace(/font-size:\s*([\d.]+)px/g, (m, v) => 'font-size:' + SCALE(+v) + 'px');
const css = snap(USES.map(reg => {
  const c = COMPONENTS.find(x => x.reg === reg);
  if (!c) throw new Error('sales-crm: no component called ' + reg);
  return `/* ${c.title} */\n` + c.html.css;
}).join('\n'));
const DIR = path.join(ROOT, 'tools/pages/src/templates/sales-crm');
const APP_CSS = snap(fs.readFileSync(path.join(DIR, 'crm.css'), 'utf8'));
const APP_JS = fs.readFileSync(path.join(DIR, 'crm.js'), 'utf8');
const title = 'Sales CRM template, free, open source | Designme.dev';
const description = 'A free sales CRM template with an agent beside the rep: accounts with next steps and health, an agent inbox, a calendar, a deals board and a forecast.';
const I = (n, c = 's') => `<svg class="i ${c}" aria-hidden="true"><use href="#i-${n}"/></svg>`;
---
<Page title={title} description={description} path="/templates/sales-crm" app>
  <Fragment slot="head">
    <link rel="stylesheet" href="/components/assets/core.css">
    <style is:inline set:html={css} />
    <style is:inline set:html={APP_CSS} />
  </Fragment>
  <span slot="top" class="crm-name">Sales CRM template</span>

  <div class="crm" data-c="sales-crm" data-view="accounts">
    <aside class="ahx-side crm-side" aria-label="Workspace">
      <div class="ahx-ws"><button class="ahx-wsb crm-wsb" data-pop="#crm-p-ws" aria-haspopup="menu"><span class="pfm-lg" data-t="pb">L</span><span class="crm-wst"><span class="t">Larkfield Sales</span><span class="s">8 people</span></span><Fragment set:html={I('unfold', 'xs')} /></button></div>
      <nav class="crm-nav" aria-label="Views">
        <button class="ahx-cv" data-go="accounts"><Fragment set:html={I('table')} /><span class="t">Accounts</span><span class="n num" data-count="accounts"></span></button>
        <button class="ahx-cv" data-go="pipeline"><Fragment set:html={I('grid')} /><span class="t">Pipeline</span><span class="n num" data-count="deals"></span></button>
        <button class="ahx-cv" data-go="forecast"><Fragment set:html={I('chart')} /><span class="t">Forecast</span></button>
        <button class="ahx-cv" data-go="calendar"><Fragment set:html={I('cal')} /><span class="t">Calendar</span><span class="n num" data-count="meetings" data-tip="Meetings booked this week"></span></button>
      </nav>
      <div class="ahx-lh"><span>Agent</span></div>
      <nav class="crm-nav" aria-label="Agent">
        <button class="ahx-cv" data-go="inbox"><Fragment set:html={I('spark')} /><span class="t">Agent inbox</span><span class="n num crm-wait" data-count="inbox"></span></button>
        <button class="ahx-cv" data-saved="closing"><Fragment set:html={I('target')} /><span class="t">Closing this month</span><span class="n num" data-count="closing"></span></button>
        <button class="ahx-cv" data-saved="nostep"><Fragment set:html={I('flag')} /><span class="t">No next step</span><span class="n num" data-count="nostep"></span></button>
        <button class="ahx-cv" data-saved="quiet"><Fragment set:html={I('history')} /><span class="t">Quiet for 2+ weeks</span><span class="n num" data-count="quiet"></span></button>
      </nav>
      <!-- the sidebar's foot: Banner, with this week's ask (owner, 10 Nov) -->
      <div class="bnx crm-sbn" role="region" data-tone="accent" data-art="steps" aria-label="Forecast due">
        <div class="bnx-art" aria-hidden="true"></div>
        <div class="bnx-tx">
          <span class="bnx-eb"><span>Due Friday</span></span>
          <p class="bnx-t"><span>Submit your Q4 commit</span></p>
          <p class="bnx-d"><span class="crm-fbd"></span></p>
          <div class="bnx-acts"><button class="pill primary sm bnx-go" data-fb="go"><span>Review deals</span></button><button class="bnx-lk" data-fb="later"><span>Later</span></button></div>
        </div>
        <button class="ib crm-sbx" data-fb="later" aria-label="Minimise this banner" data-tip="Minimise"><Fragment set:html={I('x', 'xs')} /></button>
      </div>
      <!-- the banner, minimised: X or Later folds it to this row, which opens it again (owner, 10 Nov) -->
      <button class="crm-sbm" hidden aria-label="Submit your Q4 commit, due Friday. Show the reminder"><span class="crm-sbm-i" aria-hidden="true"><Fragment set:html={I('flag', 'xs')} /></span><span class="t">Q4 commit</span><span class="d">Due Fri</span><Fragment set:html={I('chev-u', 'xs')} /></button>
    </aside>
    <div class="ahx-scrim crm-scrim" aria-hidden="true"></div>

    <div class="crm-main">
      <header class="crm-top">
        <button class="ib crm-menu" aria-label="Show views" data-tip="Views"><Fragment set:html={I('panel')} /></button>
        <div class="crm-ttl"><h1 class="crm-h1" id="content" tabindex="-1"><span class="crm-h1t">Accounts</span></h1><span class="crm-sum muted num" aria-live="polite"></span></div>
        <span class="crm-sp"></span>
        <button class="ib crm-find" aria-label="Jump to an account, a deal or an action" aria-keyshortcuts="Control+K Meta+K" data-tip="Jump to" data-tip-k="⌘K"><Fragment set:html={I('search')} /></button>
        <button class="ib crm-bell" data-pop="#crm-p-ntf" data-pop-align="end" aria-haspopup="dialog" aria-label="Notifications" data-tip="Notifications"><Fragment set:html={I('bell')} /><i class="crm-unread" aria-hidden="true"></i></button>
        <button class="pfm-tr crm-me" data-pop="#crm-p-me" data-pop-align="end" aria-haspopup="menu" aria-label="Account menu, Noah Cole"><span class="av ph" style="background:var(--dm-av-m);color:var(--dm-av-m-ink)"><img src="/art/people/NC-3777943.jpg" alt="" width="64" height="64" decoding="async"></span><span class="crm-men">Noah Cole</span><Fragment set:html={I('chev-d', 'xs')} /></button>
      </header>

      <!-- Accounts: the task table's header, bulk bar, sort buttons and checkboxes, with Filter menu's chips and Search input's
           field and answer line in the toolbar -->
      <section class="crm-view ttx crm-co" id="crm-v-accounts" aria-label="Accounts">
        <div class="ttx-hd crm-hd">
          <div class="ttx-ti crm-fbar" role="toolbar" aria-label="Filter, search and sort">
            <div class="crm-chips" hidden>
              <div class="flm-chips crm-fch" role="list" aria-label="Filters"></div>
              <button class="pill ghost sm crm-clr" hidden>Clear</button>
              <button class="pill ghost sm crm-save" data-pop="#crm-p-save" aria-haspopup="dialog" hidden><Fragment set:html={I('bookmark', 'xs')} />Save view</button>
              <span class="crm-inview muted num"></span>
            </div>
            <div class="crm-acts">
              <div class="six-box crm-ask"><div class="six-in"><Fragment set:html={I('search', 'xs')} /><input type="search" placeholder="Search, or ask in plain words" aria-label="Search accounts, or ask in plain words and press Enter" autocomplete="off" spellcheck="false"><button class="ib six-x" aria-label="Clear the search" hidden><Fragment set:html={I('x', 'xs')} /></button></div></div>
              <button class="pill line sm flm-tr crm-ftr" data-pop="#crm-p-flt" data-pop-align="end" aria-haspopup="menu" aria-label="Filter"><Fragment set:html={I('filter', 'xs')} /><span>Filter</span></button>
              <button class="pill line sm crm-sort" data-pop="#crm-p-sort" data-pop-align="end" aria-haspopup="dialog" aria-label="Sort"><Fragment set:html={I('sort', 'xs')} /><span class="v">Pipeline</span></button>
              <button class="pill line sm crm-export" aria-label="Export accounts in view as CSV"><Fragment set:html={I('down', 'xs')} /><span>Export CSV</span></button>
              <button class="pill primary sm crm-new" aria-label="Add account"><Fragment set:html={I('plus', 'xs')} /><span>Add account</span></button>
            </div>
          </div>
          <div class="ttx-sb" inert><span class="ttx-n num"></span><button class="pill ghost sm" data-pop="#crm-p-assign" aria-haspopup="menu"><Fragment set:html={I('user', 'xs')} />Assign owner</button><button class="pill ghost sm" data-pop="#crm-p-move" aria-haspopup="menu"><Fragment set:html={I('right', 'xs')} />Move stage</button><button class="pill ghost sm" data-a="export"><Fragment set:html={I('down', 'xs')} />Export</button><button class="pill ghost sm ttx-del" data-a="delete"><Fragment set:html={I('trash', 'xs')} />Delete</button><span class="ttx-sp"></span><button class="pill ghost sm ttx-clr">Clear</button></div>
        </div>
        <div class="crm-ans" hidden><div class="six-ans"><Fragment set:html={I('spark', 'xs')} /><span class="t" aria-live="polite"></span><button class="pill ghost sm crm-ansx">Clear</button></div></div>
        <div class="pop crm-pop crm-sug" role="group" aria-label="Try asking"></div>
        <div class="ttx-sc crm-sc" tabindex="0" role="region" aria-label="Accounts table">
          <table class="ttx-t crm-t">
            <thead><tr>
              <th class="ck stk"><button class="ttx-cb ttx-all" role="checkbox" aria-checked="false" aria-label="Select all accounts in view"></button></th>
              <th class="stk2"><button class="ttx-s" data-k="name"><Fragment set:html={I('globe', 'xs')} />Account</button></th>
              <th><button class="ttx-s" data-k="stage"><Fragment set:html={I('layers', 'xs')} />Stage</button></th>
              <th><button class="ttx-s" data-k="next"><Fragment set:html={I('cal', 'xs')} />Next step</button></th>
              <th><button class="ttx-s" data-k="owner"><Fragment set:html={I('user', 'xs')} />Owner</button></th>
              <th class="r"><button class="ttx-s" data-k="value"><Fragment set:html={I('dollar', 'xs')} />Pipeline</button></th>
              <th class="crm-hc"><button class="ttx-s" data-k="health"><Fragment set:html={I('gauge', 'xs')} />Health</button></th>
              <th><span class="crm-thi"><Fragment set:html={I('spark', 'xs')} />Agent</span></th>
              <th class="r crm-actc"><span class="pg-sr">Actions</span></th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- Agent inbox: Agent inbox's grouped list on the left, a preview of the selected item on the right (a sheet on a phone) -->
      <section class="crm-view crm-ib" id="crm-v-inbox" aria-label="Agent inbox" hidden>
        <div class="aib panel crm-aib">
          <div class="aib-h"><b>Prepared by the agent</b><span class="muted aib-st" aria-live="polite"></span></div>
          <div class="aib-gs"></div>
        </div>
        <div class="panel crm-ipv" role="region" aria-label="Preview"></div>
      </section>

      <!-- Calendar: Event calendar's week, with the deals closing each day under the day headers -->
      <section class="crm-view crm-cal" id="crm-v-calendar" aria-label="Calendar" hidden>
        <div class="ecx panel crm-ecx">
          <div class="ecx-h"><div class="crm-wk"><button class="ib" data-wk="-1" aria-label="Previous week" data-tip="Previous week"><Fragment set:html={I('chev-l', 'xs')} /></button><button class="ib" data-wk="1" aria-label="Next week" data-tip="Next week"><Fragment set:html={I('chev-r', 'xs')} /></button><button class="pill line sm" data-wk="0">Today</button></div><button class="crm-wkb" data-pop="#crm-p-jump" aria-haspopup="dialog" aria-label="Go to a date"><b class="crm-wkt num"></b><Fragment set:html={I('chev-d', 'xs')} /></button><span class="ecx-sp"></span><div class="seg2 crm-cvw" role="group" aria-label="Calendar view"><button aria-pressed="false" data-cv="day" data-v="day">Day</button><button aria-pressed="true" data-cv="week" data-v="week">Week</button><button aria-pressed="false" data-cv="month" data-v="month">Month</button></div><span class="ecx-msg muted" aria-live="polite"></span><button class="pill soft sm ecx-ask crm-plan"><Fragment set:html={I('spark', 'xs')} /><span>Plan follow-ups</span></button></div>
          <div class="ecx-days" role="group" aria-label="Day"></div>
          <div class="ecx-sc"><div class="ecx-grid"><div class="ecx-tm"></div></div></div>
          <div class="crm-mon" hidden></div>
          <div class="crm-leg muted" aria-label="Owners"></div>
        </div>
      </section>

      <!-- Pipeline: the Kanban board, with the stages as columns -->
      <section class="crm-view crm-deals" id="crm-v-pipeline" aria-label="Pipeline" hidden>
        <div class="kbx crm-kb">
          <div class="kbx-hd"><div class="kbx-ti"><b>Open deals by stage</b><span class="num crm-kbsum"></span></div><div class="kbx-fp" role="group" aria-label="Filter by owner"></div><span class="kbx-sp"></span><label class="kbx-q"><Fragment set:html={I('search', 'xs')} /><input type="search" placeholder="Search deals" aria-label="Search deals" autocomplete="off"><button class="ib kbx-qx" aria-label="Clear the search" hidden><Fragment set:html={I('x', 'xs')} /></button></label><div class="seg2 kbx-vw" role="group" aria-label="Layout"><button aria-pressed="true" data-v="board" aria-label="Board"><Fragment set:html={I('grid', 'xs')} /><span class="lb">Board</span></button><button aria-pressed="false" data-v="list" aria-label="List"><Fragment set:html={I('list', 'xs')} /><span class="lb">List</span></button></div></div>
          <div class="kbx-fl"><button class="chip sm kbx-f" data-pop="#crm-p-close" aria-haspopup="menu" data-f="close"><span class="k">Closes</span><span class="v"></span><Fragment set:html={I('chev-d', 'xs')} /></button><button class="pill ghost sm kbx-clr" hidden>Clear</button><div class="crm-dock" role="group" aria-label="Hidden stages" hidden><span class="crm-dkl">Hidden</span><div class="crm-dks"></div></div><span class="kbx-sp"></span><span class="kbx-cnt num"></span></div>
          <div class="kbx-bar"><div class="seg2 kbx-tabs" role="group" aria-label="Stage"></div></div>
          <div class="kbx-bd"><div class="crm-lhd" role="presentation" hidden><span class="kbx-id">ID</span><span class="t">Deal</span><span class="co">Account</span><span class="ow">Owner</span><span class="cl">Closes</span><span class="pr">Win</span><span class="v">Value</span><span class="mv"></span></div><div class="kbx-cols"></div><div class="kbx-em" hidden><span class="ic"><Fragment set:html={I('filter')} /></span><b>No deals match</b><span class="crm-emn">Try another owner, date or search.</span><button class="pill line sm crm-kbclr">Clear filters</button></div><div class="kbx-em crm-allhid" role="status" hidden><span class="ic"><Fragment set:html={I('eye')} /></span><b>All stages are hidden</b><span class="crm-ahn"></span><button class="pill line sm">Show all stages</button></div></div>
          <div class="kbx-sr" aria-live="polite"></div>
        </div>
      </section>

      <!-- Forecast: Stat cards, Line chart, Activity heatmap, Funnel, Radial goals and Progress meters, worked out from the deals -->
      <section class="crm-view crm-fc" id="crm-v-forecast" aria-label="Forecast" hidden>
        <div class="scx-grid crm-c12"></div>
        <!-- the forecast reads 4, 3, 3: stat cards, then three charts, then three breakdowns; every card's head is its title, a
             muted line under it, and its controls on the right (owner, 10 Nov). The heatmap takes 5 of 12 columns so the library's
             component shows the whole day, as it does on its own page; under 400px it switches to its own half-day scroller -->
        <div class="lnx panel crm-c3">
          <div class="lnx-h"><div class="crm-ht"><b>Closed won</b><span class="muted"><span class="num lnx-v">$0</span> won, <span class="crm-fcst"></span></span></div><div class="lnx-lg"><button class="lnx-k on" data-s="0" aria-pressed="true"><i style="background:var(--dm-accent-mark,var(--dm-accent))"></i>Q4</button><button class="lnx-k on" data-s="1" aria-pressed="true"><i style="background:var(--dm-c2)"></i>Q3</button></div></div>
          <div class="lnx-ch"><svg class="lnx-svg" viewBox="0 0 320 140" preserveAspectRatio="none" aria-hidden="true"></svg><div class="lnx-x"></div><div class="lnx-tt"><b class="num"></b><span></span></div></div>
          <div class="lnx-ax muted num" aria-hidden="true"></div>
        </div>
        <div class="bcx panel crm-bc crm-c4">
          <div class="bcx-h"><div class="crm-ht"><b class="crm-bct">Pipeline by close week</b><span class="muted crm-bcs"></span></div><div class="seg2 bcx-rg" role="group" aria-label="Range"><button aria-pressed="true" data-v="w">Week</button><button aria-pressed="false" data-v="m">Month</button></div></div>
          <div class="bcx-ch" role="list" aria-label="Open pipeline by close date"></div>
        </div>
        <div class="hmx panel crm-hm crm-c5">
          <div class="hmx-h"><div class="crm-ht"><b>Team activity</b><span class="muted hmx-st">Last 12 weeks</span></div><div class="seg2 hmx-sg" role="group" aria-label="Whose activity"><button aria-pressed="true" data-v="team">Team</button><button aria-pressed="false" data-v="agent">Agent</button></div></div>
          <div class="hmx-wrap"><div class="hmx-sc"><div class="hmx-days muted"><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span><span>Sun</span></div><div class="hmx-grid"></div>
          <div class="hmx-f muted"><span class="hmx-ax">6am</span><span class="hmx-ax x">8am</span><span class="hmx-ax">10am</span><span class="hmx-ax x">12pm</span><span class="hmx-ax">2pm</span><span class="hmx-ax x">4pm</span><span class="hmx-ax">6pm</span><span class="hmx-ax x">8pm</span></div></div></div>
        </div>
        <div class="fnx panel crm-c4">
          <div class="fnx-h"><div class="crm-ht"><b>Stage conversion</b><span class="muted crm-fnn num"></span></div></div>
          <div class="fnx-rows"></div>
          <div class="fnx-ins"><span class="fnx-ic"><Fragment set:html={I('spark', 'xs')} /></span><span class="fnx-t"></span></div>
        </div>
        <div class="rgx panel crm-c4">
          <div class="rgx-h"><div class="rgx-t crm-ht"><b>Team quotas</b><span class="muted rgx-sub">Q4, closed won against quota</span></div></div>
          <div class="rgx-b"><div class="rgx-ring"><svg viewBox="0 0 180 180" aria-hidden="true"></svg><div class="rgx-c"><b class="num">0%</b><span class="muted">of quota</span></div></div><div class="rgx-lg"></div></div>
          <div class="crm-qsum"></div>
        </div>
        <!-- quota attainment is Top pages: a ranked list with a share bar and the change since last week, sorted by won or change -->
        <div class="tpx panel crm-tp crm-c4">
          <div class="tpx-h"><div class="crm-ht"><b>Quota attainment</b><span class="muted tpx-sub">Top 5 closers, change on Q3 pace</span></div><div class="seg2 tpx-sg" role="group" aria-label="Sort"><button aria-pressed="true" data-v="v">Won</button><button aria-pressed="false" data-v="c">Change</button></div></div>
          <div class="tpx-list" role="list"></div>
        </div>
        <!-- deal activity: the quarter's deals, filtered by stage, owner and amount or searched, with stage chips and pages -->
        <div class="panel crm-c12 crm-act">
          <div class="crm-ath">
            <!-- one line: the title with its count as a grey chip, then sort and filters, each with its field's icon (owner, 10 Nov) -->
            <div class="crm-ah"><b>Deal activity</b><span class="tag crm-actn num" aria-label="deals shown"></span></div>
            <div class="crm-afl" role="group" aria-label="Sort and filter deal activity">
              <button class="pill line sm flm-tr crm-aft" data-pop="#crm-p-af" data-pop-align="end" aria-haspopup="menu" aria-label="Filter deal activity"><Fragment set:html={I('filter', 'xs')} /><span>Filter</span></button>
              <button class="pill line sm crm-asort" data-pop="#crm-p-as" data-pop-align="end" aria-haspopup="menu" aria-label="Sort deal activity"><Fragment set:html={I('sort', 'xs')} /><span class="v">Close date</span></button>
              <label class="crm-asq"><Fragment set:html={I('search', 'xs')} /><input type="search" placeholder="Search" aria-label="Search deal activity" autocomplete="off" spellcheck="false"></label>
            </div>
          </div>
          <div class="crm-fch crm-ach" role="list" aria-label="Deal activity filters"></div>
          <div class="crm-dsc"><table class="crm-dat"><thead><tr><th><span class="crm-thi"><Fragment set:html={I('coins', 'xs')} />Deal</span></th><th><span class="crm-thi"><Fragment set:html={I('globe', 'xs')} />Account</span></th><th><span class="crm-thi"><Fragment set:html={I('user', 'xs')} />Owner</span></th><th><span class="crm-thi"><Fragment set:html={I('layers', 'xs')} />Stage</span></th><th><span class="crm-thi"><Fragment set:html={I('cal', 'xs')} />Close date</span></th><th class="r"><span class="crm-thi"><Fragment set:html={I('dollar', 'xs')} />Amount</span></th><th class="r"><span class="crm-sr">Actions</span></th></tr></thead><tbody></tbody></table></div>
          <div class="crm-pg"><button class="pill line sm" data-pg="-1"><Fragment set:html={I('chev-l', 'xs')} />Previous</button><span class="crm-pgs"></span><button class="pill line sm" data-pg="1">Next<Fragment set:html={I('chev-r', 'xs')} /></button></div>
        </div>
      </section>

      <!-- the account's details: the Details panel's sections and rows, as a sheet over the right of the screen -->
      <!-- the sheet slides inside a clipping layer, so its slide never widens the page -->
      <div class="crm-sheetw"><aside class="crm-sheet" role="dialog" aria-modal="false" aria-label="Account details" inert><div class="dtp crm-dtp"></div></aside></div>
    </div>
    <!-- a dimmed overlay under the open sheet, over the rest of the app; a click on it closes the sheet -->
    <div class="crm-shade" aria-hidden="true"></div>

    <!-- menus: the shared core opens each from its button (data-pop) -->
    <div class="pop crm-pop" id="crm-p-ws" role="menu" aria-label="Workspaces"></div>
    <div class="pop crm-pop flm-pop crm-flt" id="crm-p-flt" role="menu" aria-label="Filter by"></div>
