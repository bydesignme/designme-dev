---
// /templates/sales-crm: a sales CRM where an agent works beside the rep, made of the library's own components as a showcase
// of what they build. The sidebar switches between six views: Accounts (a table with each account's next step, health and
// the agent's suggestion), the Agent inbox (what the agent prepared, to approve, edit or dismiss), the Calendar (the reps'
// week of meetings, the deals closing each day, and follow-up slots the agent proposes), the Pipeline (a deals board),
// the Forecast (the quarter against quota, by rep) and Reports (the charts). Saved views in the sidebar filter the accounts. Everything is drawn with the components' own classes and
// tokens, from their installed CSS, so the screen follows Soft and Blueprint, light and dark, with the site's switches. Its
// data and interactions are one script (src/templates/sales-crm/crm.js); the layout around the components is
// src/templates/sales-crm/crm.css. Noindex and out of the sitemap, llms.txt and the site's navigation until the owner
// decides where to link it.
import fs from 'node:fs';
import path from 'node:path';
import Page from '../../layouts/Page.astro';
import { ROOT, componentOf } from '../../lib/data.mjs';

// the components the screen is made of, by their registry name: each one's installed CSS is on the page. The accounts table and
// the account panel started from Task table and Details panel, but carry their own markup, so they have their own copy of
// those styles under CRM classes (crmt-* and crmd-*, at the top of crm.css): a new look for either component never reaches
// the CRM (19 Nov)
const USES = ['agent-harness', 'progress', 'kanban-board', 'filter-menu', 'search-input', 'form', 'toast',
  'activity-heatmap', 'notifications', 'profile-menu', 'command-palette', 'stat-cards', 'line-chart', 'donut-chart',
  'event-calendar', 'agent-inbox', 'health-score', 'decision-prompt', 'date-picker', 'banner', 'draft-review', 'rewrite-toolbar',
  'inline-text-diff', 'bar-chart'];
// the screen's type scale: five sizes from the library's own (11, 12, 13, 14 and the 16px title), nothing under 11px. Every
// component's text snaps to the nearest step at or below it; a display number (Health score's score, Stat cards' values) keeps
// its size
const SCALE = v => v >= 15 ? v : v >= 13.75 ? 14 : v >= 12.75 ? 13 : v >= 11.75 ? 12 : 11;
const snap = t => t.replace(/font-size:\s*([\d.]+)px/g, (m, v) => 'font-size:' + SCALE(+v) + 'px');
const css = snap(USES.map(reg => {
  const c = componentOf(reg);
  if (!c) throw new Error('sales-crm: no component called ' + reg);
  return `/* ${c.title} */\n` + c.html.css;
}).join('\n'));
const DIR = path.join(ROOT, 'tools/pages/src/templates/sales-crm');
const APP_CSS = snap(fs.readFileSync(path.join(DIR, 'crm.css'), 'utf8'));
const APP_JS = fs.readFileSync(path.join(DIR, 'crm.js'), 'utf8');
const title = 'Sales CRM template, free, open source | Designme.dev';
const description = 'A free sales CRM template with an agent beside the rep: accounts with next steps and health, an agent inbox, a calendar, a deals board and a forecast.';
const I = (n, c = 's') => `<svg class="i ${c}" aria-hidden="true"><use href="#i-${n}"/></svg>`;
---
<Page title={title} description={description} path="/templates/sales-crm" app>
  <Fragment slot="head">
    <link rel="stylesheet" href="/components/assets/core.css">
    <style is:inline set:html={css} />
    <style is:inline set:html={APP_CSS} />
  </Fragment>
  <span slot="top" class="crm-name">Sales CRM template</span>

  <div class="crm" data-c="sales-crm" data-view="accounts">
    <aside class="ahx-side crm-side" aria-label="Workspace">
      <div class="ahx-ws"><button class="ahx-wsb crm-wsb" data-pop="#crm-p-ws" aria-haspopup="menu"><span class="pfm-lg" data-t="pb">L</span><span class="crm-wst"><span class="t">Larkfield Sales</span><span class="s">8 people</span></span><Fragment set:html={I('unfold', 'xs')} /></button></div>
      <nav class="crm-nav" aria-label="Views">
        <!-- the views carry no counts: each view says its own (elevation pass, 19 Nov: no number said twice) -->
        <button class="ahx-cv" data-go="accounts"><Fragment set:html={I('table')} /><span class="t">Accounts</span></button>
        <button class="ahx-cv" data-go="pipeline"><Fragment set:html={I('grid')} /><span class="t">Pipeline</span></button>
        <button class="ahx-cv" data-go="forecast"><Fragment set:html={I('chart')} /><span class="t">Forecast</span></button>
        <button class="ahx-cv" data-go="reports"><Fragment set:html={I('bars')} /><span class="t">Reports</span></button>
        <button class="ahx-cv" data-go="calendar"><Fragment set:html={I('cal')} /><span class="t">Calendar</span></button>
      </nav>
      <div class="ahx-lh"><span>Agent</span></div>
      <nav class="crm-nav" aria-label="Agent">
        <button class="ahx-cv" data-go="inbox"><Fragment set:html={I('spark')} /><span class="t">Agent inbox</span><span class="n num crm-wait" data-count="inbox"></span></button>
        <button class="ahx-cv" data-saved="closing"><Fragment set:html={I('target')} /><span class="t">Closing this month</span><span class="n num" data-count="closing"></span></button>
        <button class="ahx-cv" data-saved="nostep"><Fragment set:html={I('flag')} /><span class="t">No next step</span><span class="n num" data-count="nostep"></span></button>
        <button class="ahx-cv" data-saved="quiet"><Fragment set:html={I('history')} /><span class="t">Quiet for 2+ weeks</span><span class="n num" data-count="quiet"></span></button>
      </nav>
      <!-- the sidebar's foot: Banner, with this week's ask (owner, 10 Nov) -->
      <div class="bnx crm-sbn" role="region" data-tone="accent" data-art="steps" aria-label="Forecast due">
        <div class="bnx-art" aria-hidden="true"></div>
        <div class="bnx-tx">
          <span class="bnx-eb"><span>Due Friday</span></span>
          <p class="bnx-t"><span>Submit your Q4 commit</span></p>
          <p class="bnx-d"><span class="crm-fbd"></span></p>
          <div class="bnx-acts"><button class="pill primary sm bnx-go" data-fb="go"><span>Review deals</span></button><button class="bnx-lk" data-fb="later"><span>Later</span></button></div>
        </div>
        <button class="ib crm-sbx" data-fb="later" aria-label="Minimise this banner" data-tip="Minimise"><Fragment set:html={I('x', 'xs')} /></button>
      </div>
      <!-- the banner, minimised: X or Later folds it to this row, which opens it again (owner, 10 Nov) -->
      <button class="crm-sbm" hidden aria-label="Submit your Q4 commit, due Friday. Show the reminder"><span class="crm-sbm-i" aria-hidden="true"><Fragment set:html={I('flag', 'xs')} /></span><span class="t">Q4 commit</span><span class="d">Due Fri</span><Fragment set:html={I('chev-u', 'xs')} /></button>
    </aside>
    <div class="ahx-scrim crm-scrim" aria-hidden="true"></div>

    <div class="crm-main">
      <header class="crm-top">
        <button class="ib crm-menu" aria-label="Show views" data-tip="Views"><Fragment set:html={I('panel')} /></button>
        <div class="crm-ttl"><h1 class="crm-h1" id="content" tabindex="-1"><span class="crm-h1t">Accounts</span></h1><span class="crm-sum muted num" aria-live="polite"></span></div>
        <span class="crm-sp"></span>
        <button class="ib crm-find" aria-label="Jump to an account, a deal or an action" aria-keyshortcuts="Control+K Meta+K" data-tip="Jump to" data-tip-k="⌘K"><Fragment set:html={I('search')} /></button>
        <button class="ib crm-bell" data-pop="#crm-p-ntf" data-pop-align="end" aria-haspopup="dialog" aria-label="Notifications" data-tip="Notifications"><Fragment set:html={I('bell')} /><i class="crm-unread" aria-hidden="true"></i></button>
        <button class="pfm-tr crm-me" data-pop="#crm-p-me" data-pop-align="end" aria-haspopup="menu" aria-label="Account menu, Noah Cole"><span class="av ph" style="background:var(--dm-av-m);color:var(--dm-av-m-ink)"><img src="/art/people/NC-3777943.jpg" alt="" width="64" height="64" decoding="async"></span><span class="crm-men">Noah Cole</span><Fragment set:html={I('chev-d', 'xs')} /></button>
      </header>

      <!-- Accounts: the task table's header, bulk bar, sort buttons and checkboxes, with Filter menu's chips and Search input's
           field and answer line in the toolbar -->
      <section class="crm-view crmt crm-co" id="crm-v-accounts" aria-label="Accounts">
        <!-- the account views as quiet tabs over the table (owner, 19 Nov: "this is a crm page not some dashboard"): All accounts,
             then the ones that need a look, each with how many; the one in use is underlined -->
        <div class="crm-vt" role="group" aria-label="Account views"></div>
        <div class="crmt-hd crm-hd">
          <div class="crmt-ti crm-fbar" role="toolbar" aria-label="Filter, search and sort">
            <!-- the owners, as on the Pipeline board: pick one or more to see only their accounts (owner, 10 Nov) -->
            <div class="kbx-fp crm-afp" role="group" aria-label="Filter by owner"></div>
            <div class="crm-chips" hidden>
              <div class="flm-chips crm-fch" role="list" aria-label="Filters"></div>
              <button class="pill ghost sm crm-clr" hidden>Clear</button>
              <button class="pill ghost sm crm-save" data-pop="#crm-p-save" aria-haspopup="dialog" hidden><Fragment set:html={I('bookmark', 'xs')} />Save view</button>
              <span class="crm-inview muted num"></span>
            </div>
            <div class="crm-acts">
              <div class="six-box crm-ask"><div class="six-in"><Fragment set:html={I('search', 'xs')} /><input type="search" placeholder="Search, or ask in plain words" aria-label="Search accounts, or ask in plain words and press Enter" autocomplete="off" spellcheck="false"><button class="ib six-x" aria-label="Clear the search" hidden><Fragment set:html={I('x', 'xs')} /></button></div></div>
              <!-- Filter and Sort are quiet ghost buttons and Export an icon, so the one filled button, Add account, leads (19 Nov) -->
              <button class="pill ghost sm flm-tr crm-ftr" data-pop="#crm-p-flt" data-pop-align="end" aria-haspopup="menu" aria-label="Filter"><Fragment set:html={I('filter', 'xs')} /><span>Filter</span></button>
              <button class="pill ghost sm crm-sort" data-pop="#crm-p-sort" data-pop-align="end" aria-haspopup="dialog" aria-label="Sort"><Fragment set:html={I('sort', 'xs')} /><span class="v">Pipeline</span></button>
              <button class="ib crm-export" aria-label="Export accounts in view as CSV" data-tip="Export CSV"><Fragment set:html={I('down', 'xs')} /></button>
              <button class="pill primary sm crm-new" aria-label="Add account"><Fragment set:html={I('plus', 'xs')} /><span>Add account</span></button>
            </div>
          </div>
          <div class="crmt-sb" inert><span class="crmt-n num"></span><button class="pill ghost sm" data-pop="#crm-p-assign" aria-haspopup="menu"><Fragment set:html={I('user', 'xs')} />Assign owner</button><button class="pill ghost sm" data-pop="#crm-p-move" aria-haspopup="menu"><Fragment set:html={I('right', 'xs')} />Move stage</button><button class="pill ghost sm" data-a="export"><Fragment set:html={I('down', 'xs')} />Export</button><button class="pill ghost sm crmt-del" data-a="delete"><Fragment set:html={I('trash', 'xs')} />Delete</button><span class="crmt-sp"></span><button class="pill ghost sm crmt-clr">Clear</button></div>
        </div>
        <div class="crm-ans" hidden><div class="six-ans"><Fragment set:html={I('spark', 'xs')} /><span class="t" aria-live="polite"></span><button class="pill ghost sm crm-ansx">Clear</button></div></div>
        <div class="pop crm-pop crm-sug" role="group" aria-label="Try asking"></div>
        <div class="crmt-sc crm-sc" tabindex="0" role="region" aria-label="Accounts table">
          <table class="crmt-t crm-t">
            <thead><tr>
              <th class="ck stk"><button class="crmt-cb crmt-all" role="checkbox" aria-checked="false" aria-label="Select all accounts in view"></button></th>
              <th class="stk2"><button class="crmt-s" data-k="name"><Fragment set:html={I('globe', 'xs')} />Account</button></th>
              <!-- what each account is, as coloured labels (owner, 21 Nov: "category, account category, stage, next step, owner") -->
              <th class="c-cat"><button class="crmt-s" data-k="cat"><Fragment set:html={I('hash', 'xs')} />Category</button></th>
              <th class="c-tier"><button class="crmt-s" data-k="tier"><Fragment set:html={I('star', 'xs')} />Account category</button></th>
              <th><button class="crmt-s" data-k="stage"><Fragment set:html={I('layers', 'xs')} />Stage</button></th>
              <th><button class="crmt-s" data-k="next"><Fragment set:html={I('cal', 'xs')} />Next step</button></th>
              <th><button class="crmt-s" data-k="owner"><Fragment set:html={I('user', 'xs')} />Owner</button></th>
              <th class="r"><button class="crmt-s" data-k="value"><Fragment set:html={I('dollar', 'xs')} />Pipeline</button></th>
              <th class="crm-hc"><button class="crmt-s" data-k="health"><Fragment set:html={I('gauge', 'xs')} />Health</button></th>
              <th><span class="crm-thi"><Fragment set:html={I('spark', 'xs')} />Agent</span></th>
              <th class="r crm-actc"><span class="pg-sr">Actions</span></th>
            </tr></thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- Agent inbox: Agent inbox's grouped list on the left, a preview of the selected item on the right (a sheet on a phone) -->
      <section class="crm-view crm-ib" id="crm-v-inbox" aria-label="Agent inbox" hidden>
        <div class="aib panel crm-aib">
          <!-- the agent's mark leads the list; how many wait is the sidebar's count and each group's, so it is only read out (19 Nov) -->
          <div class="aib-h"><span class="aib-hi crm-aibh" aria-hidden="true"><Fragment set:html={I('spark', 'xs')} /></span><b>Prepared by the agent</b><span class="pg-sr aib-st" aria-live="polite"></span></div>
          <div class="aib-gs"></div>
        </div>
        <div class="panel crm-ipv" role="region" aria-label="Preview"></div>
      </section>

      <!-- Calendar: Event calendar's week, with the deals closing each day under the day headers -->
      <section class="crm-view crm-cal" id="crm-v-calendar" aria-label="Calendar" hidden>
        <div class="ecx panel crm-ecx">
          <div class="ecx-h"><div class="crm-wk"><button class="ib" data-wk="-1" aria-label="Previous week" data-tip="Previous week"><Fragment set:html={I('chev-l', 'xs')} /></button><button class="ib" data-wk="1" aria-label="Next week" data-tip="Next week"><Fragment set:html={I('chev-r', 'xs')} /></button><button class="pill line sm" data-wk="0">Today</button></div><button class="crm-wkb" data-pop="#crm-p-jump" aria-haspopup="dialog" aria-label="Go to a date"><b class="crm-wkt num"></b><Fragment set:html={I('chev-d', 'xs')} /></button><span class="ecx-sp"></span><span class="ecx-msg muted" aria-live="polite"></span><button class="pill soft sm ecx-ask crm-plan"><Fragment set:html={I('spark', 'xs')} /><span>Plan follow-ups</span></button><div class="seg2 crm-cvw" role="group" aria-label="Calendar view"><button aria-pressed="false" data-cv="day" data-v="day">Day</button><button aria-pressed="true" data-cv="week" data-v="week">Week</button><button aria-pressed="false" data-cv="month" data-v="month">Month</button></div></div>
          <div class="ecx-days" role="group" aria-label="Day"></div>
          <div class="ecx-sc"><div class="ecx-grid"><div class="ecx-tm"></div></div></div>
          <div class="crm-mon" hidden></div>
          <div class="crm-leg muted" aria-label="Owners"></div>
        </div>
      </section>

      <!-- Pipeline: the Kanban board, with the stages as columns -->
      <section class="crm-view crm-deals" id="crm-v-pipeline" aria-label="Pipeline" hidden>
        <div class="kbx crm-kb">
          <div class="kbx-hd"><div class="kbx-ti"><b>Open deals by stage</b><span class="num crm-kbsum"></span></div><div class="kbx-fp" role="group" aria-label="Filter by owner"></div><div class="flm-chips crm-kfch" role="list" aria-label="Filters"></div><button class="pill ghost sm kbx-clr" hidden>Clear</button><div class="crm-dock" role="group" aria-label="Hidden stages" hidden><span class="crm-dkl">Hidden</span><div class="crm-dks"></div></div><span class="kbx-sp"></span><label class="kbx-q"><Fragment set:html={I('search', 'xs')} /><input type="search" placeholder="Search deals" aria-label="Search deals" autocomplete="off"><button class="ib kbx-qx" aria-label="Clear the search" hidden><Fragment set:html={I('x', 'xs')} /></button></label><button class="pill ghost sm flm-tr crm-kftr" data-pop="#crm-p-kflt" data-pop-align="end" aria-haspopup="menu" aria-label="Filter"><Fragment set:html={I('filter', 'xs')} /><span>Filter</span></button><button class="pill ghost sm crm-ksort"data-pop="#crm-p-ksort" data-pop-align="end" aria-haspopup="dialog" aria-label="Sort"><Fragment set:html={I('sort', 'xs')} /><span class="v">Close date</span></button><div class="seg2 kbx-vw" role="group" aria-label="Layout"><button aria-pressed="true" data-v="board" aria-label="Board"><Fragment set:html={I('grid', 'xs')} /><span class="lb">Board</span></button><button aria-pressed="false" data-v="list" aria-label="List"><Fragment set:html={I('list', 'xs')} /><span class="lb">List</span></button></div></div>
          <div class="kbx-bar"><div class="seg2 kbx-tabs" role="group" aria-label="Stage"></div></div>
          <div class="kbx-bd"><div class="crm-lhd" role="presentation" hidden><span class="kbx-id">ID</span><span class="t">Deal</span><span class="co">Account</span><span class="ow">Owner</span><span class="cl">Closes</span><span class="pr">Win</span><span class="v">Value</span><span class="mv"></span></div><div class="kbx-cols"></div><div class="crm-lsum" role="group" aria-label="Summary of the deals in view" hidden></div><div class="kbx-em" hidden><span class="ic"><Fragment set:html={I('filter')} /></span><b>No deals match</b><span class="crm-emn">Try another owner, date or search.</span><button class="pill line sm crm-kbclr">Clear filters</button></div><div class="kbx-em crm-allhid" role="status" hidden><span class="ic"><Fragment set:html={I('eye')} /></span><b>All stages are hidden</b><span class="crm-ahn"></span><button class="pill line sm">Show all stages</button></div></div>
          <div class="kbx-sr" aria-live="polite"></div>
        </div>
      </section>

      <!-- Forecast (owner, 16 Nov: a simple results page, closer to Stripe): three action cards for what to do next, then one card
           with the quarter's figures over a wide closed-won chart (owner, 21 Nov: the chart is the main thing, no Closing next
           beside it), and the forecast by rep. The other charts are in Reports -->
      <section class="crm-view crm-fc crm-fo" id="crm-v-forecast" aria-label="Forecast" hidden>
        <!-- next steps: three action cards, each with a small picture of what it opens and one button, first on the page (owner, 16 Nov) -->
        <div class="crm-axs crm-c12" role="group" aria-label="Next steps"></div>
        <!-- the quarter's figures and the library's Line chart in one card: closed won day by day to today, against Q3 at the same
             point; a hairline under the figures, the values on the left, the legend under the plot -->
        <div class="lnx panel crm-hero crm-c12">
          <div class="lnx-h crm-hh"><div class="crm-hm4" role="group" aria-label="This quarter against quota"></div></div>
          <div class="lnx-pl"><div class="lnx-y num" aria-hidden="true"></div><div class="lnx-ch" tabindex="0" role="group" aria-roledescription="line chart" aria-label="Closed won this quarter, day by day, against Q3 at the same point. The arrow keys read each day"><svg class="lnx-svg" aria-hidden="true"></svg><span class="lnx-x"></span><span class="lnx-pt" style="color:var(--dm-lnx-cmp)"></span><span class="lnx-pt" style="color:var(--dm-lnx-line)"></span><span class="lnx-now"></span><div class="lnx-tt" aria-hidden="true"><div class="lnx-tt-h"></div><div class="lnx-tt-r"><i></i><span>Q4</span><b class="num"></b></div><div class="lnx-tt-r c"><i></i><span>Q3</span><b class="num"></b></div></div></div><div class="lnx-ax num" aria-hidden="true"></div></div>
          <div class="lnx-lg"><button class="lnx-k" data-s="0" aria-pressed="true"><i></i><span>Q4</span></button><button class="lnx-k c" data-s="1" aria-pressed="true"><i></i><span>Q3 at the same point</span></button></div>
          <p class="lnx-sr" aria-live="polite"></p><div class="lnx-sr"><table class="crm-fct"></table></div>
        </div>
        <!-- the forecast by rep: quota, closed won with attainment, commit, best case, the gap and whether the rep's commit is in -->
        <div class="panel crm-c12 crm-act crm-reps">
          <!-- what the table means sits behind an (i) beside the title, not in a line under it (owner, 21 Nov: "too busy");
               every column but Closed won's bar sorts, as tables do -->
          <div class="crm-ath"><div class="crm-hti"><b>Forecast by rep</b><button class="ib crm-info" aria-label="About this table: commit is closed won plus weighted proposals and negotiations. Commits are due Friday." data-tip="Commit is closed won plus weighted proposals and negotiations. Commits are due Friday."><Fragment set:html={I('info', 'xs')} /></button></div></div>
          <div class="crm-dsc"><table class="crm-dat crm-rpt"><thead><tr><th><button class="crm-srt" data-k="n">Rep<Fragment set:html={I('chev-d', 'xs')} /></button></th><th class="r"><button class="crm-srt" data-k="q">Quota<Fragment set:html={I('chev-d', 'xs')} /></button></th><th aria-sort="descending"><button class="crm-srt" data-k="w">Closed won<Fragment set:html={I('chev-d', 'xs')} /></button></th><th class="r"><button class="crm-srt" data-k="c">Commit<Fragment set:html={I('chev-d', 'xs')} /></button></th><th class="r"><button class="crm-srt" data-k="b">Best case<Fragment set:html={I('chev-d', 'xs')} /></button></th><th class="r"><button class="crm-srt" data-k="g">Gap<Fragment set:html={I('chev-d', 'xs')} /></button></th><th class="r"><button class="crm-srt" data-k="s">Commit status<Fragment set:html={I('chev-d', 'xs')} /></button></th></tr></thead><tbody></tbody><tfoot></tfoot></table></div>
        </div>
      </section>

      <!-- Reports: the library's Stat cards, Activity heatmap and Donut chart, and the quarter's deal activity, worked out from the
           same deals (owner, 21 Nov: Stage conversion and Quota attainment are gone, and Team quotas sits beside Team activity) -->
      <section class="crm-view crm-fc crm-rp" id="crm-v-reports" aria-label="Reports" hidden>
        <div class="scx-grid crm-c12"></div>
        <div class="hmx panel crm-hm crm-c6">
          <div class="hmx-h"><div class="crm-ht"><b>Team activity</b><span class="muted hmx-st">Last 12 weeks</span></div><div class="seg2 hmx-sg" role="group" aria-label="Whose activity"><button aria-pressed="true" data-v="team">Team</button><button aria-pressed="false" data-v="agent">Agent</button></div></div>
          <div class="hmx-wrap"><div class="hmx-sc"><div class="hmx-days muted"><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span><span>Sun</span></div><div class="hmx-grid"></div>
          <div class="hmx-f muted"><span class="hmx-ax">6am</span><span class="hmx-ax x">8am</span><span class="hmx-ax">10am</span><span class="hmx-ax x">12pm</span><span class="hmx-ax">2pm</span><span class="hmx-ax x">4pm</span><span class="hmx-ax">6pm</span><span class="hmx-ax x">8pm</span></div></div></div>
        </div>
        <!-- Team quotas, the library's Donut chart as a gauge: each rep's closed won is a part, what is left of the team's quota the
             grey track, and the middle the team's closed won against it; the legend names each rep beside the gauge -->
        <div class="dnx panel crm-qt crm-c6">
          <div class="crm-qh"><div class="crm-ht"><b>Team quotas</b><span class="muted">Q4, closed won against quota</span></div></div>
          <div class="crm-qb"><div class="dnx-g"><svg class="dnx-svg" viewBox="0 0 220 110" aria-hidden="true"></svg><div class="dnx-c"><b class="num dnx-v"></b><span class="muted dnx-l"></span></div></div><div class="dnx-lg" role="list" aria-label="Closed won by rep"></div></div>
        </div>
        <!-- deal activity: the quarter's deals, filtered by stage, owner and amount or searched, with stage chips and pages -->
        <div class="panel crm-c12 crm-act">
          <div class="crm-ath">
            <!-- one line: the title with its count as a grey chip, then sort and filters, each with its field's icon (owner, 10 Nov) -->
            <div class="crm-ah"><b>Deal activity</b><span class="tag crm-actn num" aria-label="deals shown"></span></div>
            <div class="crm-afl" role="group" aria-label="Sort and filter deal activity">
              <button class="pill line sm flm-tr crm-aft" data-pop="#crm-p-af" data-pop-align="end" aria-haspopup="menu" aria-label="Filter deal activity"><Fragment set:html={I('filter', 'xs')} /><span>Filter</span></button>
              <button class="pill line sm crm-asort" data-pop="#crm-p-as" data-pop-align="end" aria-haspopup="menu" aria-label="Sort deal activity"><Fragment set:html={I('sort', 'xs')} /><span class="v">Close date</span></button>
              <label class="crm-asq"><Fragment set:html={I('search', 'xs')} /><input type="search" placeholder="Search" aria-label="Search deal activity" autocomplete="off" spellcheck="false"></label>
            </div>
          </div>
          <div class="crm-fch crm-ach" role="list" aria-label="Deal activity filters"></div>
          <div class="crm-dsc"><table class="crm-dat"><thead><tr><th><span class="crm-thi"><Fragment set:html={I('coins', 'xs')} />Deal</span></th><th><span class="crm-thi"><Fragment set:html={I('globe', 'xs')} />Account</span></th><th><span class="crm-thi"><Fragment set:html={I('user', 'xs')} />Owner</span></th><th><span class="crm-thi"><Fragment set:html={I('layers', 'xs')} />Stage</span></th><th><span class="crm-thi"><Fragment set:html={I('cal', 'xs')} />Close date</span></th><th class="r"><span class="crm-thi"><Fragment set:html={I('dollar', 'xs')} />Amount</span></th><th class="r"><span class="crm-sr">Actions</span></th></tr></thead><tbody></tbody></table></div>
          <div class="crm-pg"><button class="pill line sm" data-pg="-1"><Fragment set:html={I('chev-l', 'xs')} />Previous</button><span class="crm-pgs"></span><button class="pill line sm" data-pg="1">Next<Fragment set:html={I('chev-r', 'xs')} /></button></div>
        </div>
      </section>

      <!-- the account's details: the Details panel's sections and rows, as a sheet over the right of the screen -->
      <!-- the sheet slides inside a clipping layer, so its slide never widens the page -->
      <div class="crm-sheetw"><aside class="crm-sheet" role="dialog" aria-modal="false" aria-label="Account details" inert><div class="crmd crm-dtp"></div></aside></div>
    </div>
    <!-- a dimmed overlay under the open sheet, over the rest of the app; a click on it closes the sheet -->
    <div class="crm-shade" aria-hidden="true"></div>

    <!-- menus: the shared core opens each from its button (data-pop) -->
    <div class="pop crm-pop" id="crm-p-ws" role="menu" aria-label="Workspaces"></div>
    <div class="pop crm-pop flm-pop crm-flt" id="crm-p-flt" role="menu" aria-label="Filter by"></div>
    <div class="pop crm-pop crm-srp" id="crm-p-sort" role="dialog" aria-label="Sort"></div>
    <div class="pop crm-pop crm-calcp" id="crm-p-calc" role="menu" aria-label="Calculation"></div>
    <div class="pop crm-pop crm-srp" id="crm-p-ksort" role="dialog" aria-label="Sort deals"></div>
    <div class="pop crm-pop crm-svp" id="crm-p-save" role="dialog" aria-label="Save view"></div>
    <div class="pop crm-pop flm-pop crm-flt" id="crm-p-af" role="menu" aria-label="Filter by"></div>
    <div class="pop crm-pop" id="crm-p-as" role="menu" aria-label="Sort by"></div>
    <div class="pop crm-pop flm-pop crm-flt" id="crm-p-kflt" role="menu" aria-label="Filter by"></div>
    <div class="pop crm-pop" id="crm-p-assign" role="menu" aria-label="Assign owner"></div>
    <div class="pop crm-pop" id="crm-p-move" role="menu" aria-label="Move to stage"></div>
    <div class="pop crm-pop" id="crm-p-row" role="menu" aria-label="Account actions"></div>
    <div class="pop crm-pop" id="crm-p-mv" role="menu" aria-label="Move deal to"></div>
    <div class="pop crm-pop" id="crm-p-colm" role="menu" aria-label="Column actions"></div>
    <div class="pop crm-pop" id="crm-p-sown" role="menu" aria-label="Account owner"></div>
    <div class="pop crm-pop" id="crm-p-sstage" role="menu" aria-label="Stage"></div>
    <div class="pop crm-pop" id="crm-p-ied" role="menu" aria-label="Change the suggestion"></div>
    <div class="pop crm-pop crm-acc" id="crm-p-acc" role="menu" aria-label="Account"></div>
    <div class="pop crm-pop crm-cfm" id="crm-p-cfm" role="dialog" aria-label="Confirm"></div>
    <div class="pop crm-pop" id="crm-p-sg" role="menu" aria-label="Proposed slot"></div>
    <div class="pop crm-pop crm-ppk" id="crm-p-ppl" role="dialog" aria-label="Add people"><label class="crm-ppin"><svg class="i xs" aria-hidden="true"><use href="#i-search"/></svg><input class="crm-ppq" placeholder="Search people" aria-label="Search people" role="combobox" aria-expanded="true" aria-controls="crm-ppo" autocomplete="off" spellcheck="false"></label><div class="crm-ppo" id="crm-ppo" role="listbox" aria-multiselectable="true" aria-label="People"></div></div>
    <div class="pop crm-pop dpk-pop crm-when" id="crm-p-when" role="dialog" aria-label="Date and time"></div>
    <div class="pop crm-pop dpk-pop crm-jump" id="crm-p-jump" role="dialog" aria-label="Go to a date"></div>
    <div class="pop crm-pop" id="crm-p-cls" role="menu" aria-label="Closing that day"></div>
    <div class="pop crm-pop crm-ntf" id="crm-p-ntf" role="dialog" aria-label="Notifications"><div class="ntx"><div class="ntx-h"><b>Notifications</b><span class="ntx-ct num">0</span><span class="ntx-sp"></span><button class="pill ghost sm ntx-all">Mark all read</button></div><div class="ntx-tabs"><div class="seg2" role="group" aria-label="Show"><button aria-pressed="true" data-v="all">All</button><button aria-pressed="false" data-v="men">Mentions</button><button aria-pressed="false" data-v="deal">Deals</button></div></div><div class="ntx-list"></div></div></div>
    <div class="pop pfm-pop crm-pop" id="crm-p-me" role="menu" aria-labelledby="crm-me-n crm-me-e">
      <div class="pfm-me" role="none"><span class="av ph" style="background:var(--dm-av-m);color:var(--dm-av-m-ink)"><img src="/art/people/NC-3777943.jpg" alt="" width="64" height="64" decoding="async"></span><span class="t"><b id="crm-me-n">Noah Cole</b><span class="muted" id="crm-me-e">Head of sales</span></span></div>
      <div class="sep" role="separator"></div>
      <button class="mi pfm-th" role="menuitemcheckbox" aria-checked="false" tabindex="-1"><Fragment set:html={I('moon')} /><span>Dark theme</span><span class="toggle" aria-hidden="true"></span></button>
      <button class="mi" role="menuitem" tabindex="-1" data-act="help" data-close><Fragment set:html={I('keyboard')} /><span>Keyboard shortcuts</span><span class="kbd" aria-hidden="true">?</span></button>
      <div class="sep" role="separator"></div>
      <button class="mi" role="menuitem" tabindex="-1" data-act="signout" data-close><Fragment set:html={I('logout')} /><span>Sign out</span></button>
    </div>

    <!-- jump to: the Command palette, over the app -->
    <div class="crm-over crm-cmd" hidden><div class="cpl panel" role="dialog" aria-label="Jump to"><div class="cpl-in"><Fragment set:html={I('search')} /><input class="cpl-q" placeholder="Jump to an account, a deal or an action" aria-label="Jump to" spellcheck="false" autocomplete="off"><span class="kbd">esc</span></div><div class="cpl-list" role="listbox" aria-label="Results"></div><div class="cpl-f muted"><span><span class="kbd">↑</span><span class="kbd">↓</span> move</span><span><span class="kbd">↵</span> open</span><span class="cpl-st"></span></div></div></div>

    <!-- Add account: the Form -->
    <div class="crm-over crm-newd" hidden><form class="fmx panel" role="dialog" aria-modal="true" aria-labelledby="crm-new-h" novalidate>
      <div class="fmx-h"><b id="crm-new-h">Add account</b><button type="button" class="ib crm-newx" aria-label="Close" data-tip="Close"><Fragment set:html={I('x', 'xs')} /></button></div>
      <label class="fmx-f"><span>Account name</span><input name="n" placeholder="e.g. Hollis & Rowe" maxlength="40" autocomplete="off" required></label>
      <div class="fmx-f"><span id="crm-new-seg">Account category</span><div class="fmx-ty" role="radiogroup" aria-labelledby="crm-new-seg"></div></div>
      <div class="fmx-f"><span id="crm-new-own">Owner</span><div class="fmx-ty" role="radiogroup" aria-labelledby="crm-new-own"></div></div>
      <label class="fmx-f"><span>First deal value</span><input name="v" inputmode="numeric" placeholder="e.g. $40,000" autocomplete="off"></label>
      <div class="fmx-ft"><span class="fmx-ms muted">The first deal starts in Discovery, at $25,000 unless you set a value</span><button class="pill primary sm fmx-go" type="submit">Add account</button></div>
    </form></div>

    <!-- delete: Decision prompt's question, summary and buttons, as a dialog over the app -->
    <div class="crm-over crm-delw" hidden><div class="dpx panel crm-dlg" role="alertdialog" aria-modal="true" aria-labelledby="crm-dlq" aria-describedby="crm-dld"></div></div>

    <div class="crm-toasts" aria-live="polite"></div>
  </div>

  <Fragment slot="end">
    <script is:inline src="/components/assets/core.js"></script>
    <script is:inline set:html={APP_JS} />
  </Fragment>
</Page>
