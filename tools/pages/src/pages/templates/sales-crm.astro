      <div class="fmx-ft"><span class="fmx-ms muted">The first deal starts in Discovery, at $25,000 unless you set a value</span><button class="pill primary sm fmx-go" type="submit">Add account</button></div>
    </form></div>

    <!-- delete: Decision prompt's question, summary and buttons, as a dialog over the app -->
    <div class="crm-over crm-delw" hidden><div class="dpx panel crm-dlg" role="alertdialog" aria-modal="true" aria-labelledby="crm-dlq" aria-describedby="crm-dld"></div></div>

    <div class="crm-toasts" aria-live="polite"></div>
