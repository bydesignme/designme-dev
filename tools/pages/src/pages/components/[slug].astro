---
// /components/<component> and /components/<section> share one route: their names never overlap
import ComponentPage from '../../components/ComponentPage.astro';
import SectionPage from '../../components/SectionPage.astro';
import { COMPONENTS, SECTIONS } from '../../lib/data.mjs';
export function getStaticPaths(){
  const taken = new Set(COMPONENTS.map(c => c.slug));
  for (const s of SECTIONS) if (taken.has(s.slug)) throw new Error(`section and component share the address /components/${s.slug}`);
  return [...COMPONENTS.map(c => ({ params:{ slug:c.slug }, props:{ c } })), ...SECTIONS.map(s => ({ params:{ slug:s.slug }, props:{ s } }))];
}
const { c, s } = Astro.props;
---
{c ? <ComponentPage c={c} /> : <SectionPage s={s} />}
