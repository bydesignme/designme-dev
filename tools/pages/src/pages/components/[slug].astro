---
// /components/<component>: one page per component. The list and the sections live on the homepage
import ComponentPage from '../../components/ComponentPage.astro';
import { COMPONENTS } from '../../lib/data.mjs';
export function getStaticPaths(){
  return COMPONENTS.map(c => ({ params:{ slug:c.slug }, props:{ c } }));
}
const { c } = Astro.props;
---
<ComponentPage c={c} />
