<script is:inline>try{var t=localStorage.getItem('dmui-theme');if(t)document.documentElement.setAttribute('data-theme',t);var s=localStorage.getItem('dmui-style')||((t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'))==='dark'?'bp':'soft');if(s==='soft'||s==='mine')document.documentElement.setAttribute('data-style','soft')}catch(e){}</script>
<script is:inline set:html={THEME_JS} />
<script is:inline>
/* the accent picked on any page of the site (dmui-accent, as the homepage's picker saves it), applied before the page paints.
   One colour becomes the accent's roles in the style and theme you're looking at, worked out the way the homepage's picker
   does it: the fill (--accent, and --accent-2 for hover), what sits on it (--on-accent, white or near-black, whichever APCA
   says reads better), text and icons (--accent-fg, 4.5:1 and Lc 60), lines and marks (--accent-mark, 3:1) and the tint */
(function(){
  var W = [255,255,255], K = [0,0,0], KEYS = ['--dm-accent','--dm-accent-2','--dm-accent-bg','--dm-on-accent','--dm-accent-fg','--dm-accent-mark'];
  function rgb(h){ h = h.replace('#',''); if (h.length === 3) h = h.split('').map(function(c){ return c + c; }).join(''); return [parseInt(h.slice(0,2),16), parseInt(h.slice(2,4),16), parseInt(h.slice(4,6),16)]; }
  function mix(a, b, t){ return [0,1,2].map(function(i){ return Math.round(a[i] + (b[i] - a[i]) * t); }); }
  function hex(c){ return '#' + c.map(function(v){ return v.toString(16).padStart(2,'0'); }).join(''); }
  function rgba(c, a){ return 'rgba(' + c.join(',') + ',' + a + ')'; }
  function lum(c){ var v = c.map(function(x){ x /= 255; return x <= .03928 ? x / 12.92 : Math.pow((x + .055) / 1.055, 2.4); }); return .2126 * v[0] + .7152 * v[1] + .0722 * v[2]; }
  function ratio(a, b){ var x = lum(a), y = lum(b); return (Math.max(x, y) + .05) / (Math.min(x, y) + .05); }
  function apca(t, b){ var y = function(c){ var Y = .2126729 * Math.pow(c[0] / 255, 2.4) + .7151522 * Math.pow(c[1] / 255, 2.4) + .072175 * Math.pow(c[2] / 255, 2.4); return Y < .022 ? Y + Math.pow(.022 - Y, 1.414) : Y; };
    var yt = y(t), yb = y(b); if (Math.abs(yb - yt) < .0005) return 0; var s = yb > yt ? (Math.pow(yb, .56) - Math.pow(yt, .57)) * 1.14 : (Math.pow(yb, .65) - Math.pow(yt, .62)) * 1.14;
    return Math.abs(s) < .1 ? 0 : (s > 0 ? s - .027 : s + .027) * 100; }
  window.dmAccentRoles = function(base, soft, dark){
    var c = rgb(base), v = {};
    if (!soft && !dark) v['--dm-accent'] = hex(mix(c, K, .06));
    if (!soft && dark) v['--dm-accent'] = hex(mix(c, W, .1));
    if (soft && !dark) v['--dm-accent'] = base;
    if (soft && dark) v['--dm-accent'] = hex(mix(c, W, .2));
    var fl = rgb(v['--dm-accent'] || base), INK = [18,10,2], useW = Math.abs(apca(W, fl)) >= Math.abs(apca(INK, fl)), onC = useW ? W : INK;
    for (var j = 0; j <= 40; j += 2){ var f2 = mix(fl, useW ? K : W, j / 100); if (ratio(onC, f2) >= 4.5 && Math.abs(apca(onC, f2)) >= 60){ fl = f2; break; } }
    v['--dm-accent'] = hex(fl); v['--dm-on-accent'] = useW ? '#ffffff' : '#120a02';
    // the hover fill and the tint, as the shared core works them out from the accent (core.css, --accent-2 and --accent-bg):
    // the fill moved 14% away from its text colour, and the accent at 9% (13% in dark mode). dmAccent leaves them to the core;
    // the docs' accent preview shows them
    v['--dm-accent-2'] = hex(mix(fl, onC.map(function(x){ return 255 - x; }), .14)); v['--dm-accent-bg'] = rgba(fl, dark ? .13 : .09);
    var fill = fl, chip = dark ? [52,52,52] : [236,236,236], to = dark ? W : K;
    function reach(need, cap, on, lc){ for (var i = 0; i <= 100; i += 2){ var m = mix(fill, to, i / 100); if (ratio(m, on) >= need && (!lc || Math.abs(apca(m, on)) >= lc)) return i / 100 <= cap ? hex(m) : null; } return null; }
    v['--dm-accent-mark'] = reach(3, 1, chip); v['--dm-accent-fg'] = reach(4.5, .4, mix(chip, fill, .12), 60) || (dark ? '#f2f2f2' : '#121212');
    return v;
  };
  window.dmAccent = function(base){
    var r = document.documentElement, s = r.style;
    KEYS.forEach(function(k){ s.removeProperty(k); });
    if (!base || base === 'default') return;
    var t = r.getAttribute('data-theme'), dark = t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    var v = window.dmAccentRoles(base, r.getAttribute('data-style') === 'soft', dark);
    // the hover fill and the tint follow the accent in the shared core, as on the homepage
    delete v['--dm-accent-2']; delete v['--dm-accent-bg'];
    for (var k in v) if (v[k]) s.setProperty(k, v[k]);
  };
  try { var a = localStorage.getItem('dmui-accent'); if (a && a !== 'default') window.dmAccent(a); } catch(e){}
})();
</script>
{jsonld.map(j => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)} />)}
<slot name="head" />
<style is:inline set:html={FONT_CSS} />
<style is:global>
:root{--pg-bg:#fff;--pg-fg:#121212;--pg-dim:#525252;--pg-muted:#6a6a6a;--pg-line:rgba(18,18,18,.08);--pg-line2:rgba(18,18,18,.14);--pg-soft:#fafafa;--pg-chip:#f1f1f1;--pg-ink:#121212;--pg-on-ink:#fff;--pg-top:rgba(255,255,255,.86);
  --pg-sans:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--pg-mono:"JetBrains Mono",ui-monospace,SFMono-Regular,Menlo,monospace;--pg-head:53px}
/* dark mode uses the homepage's neutral greys: #111111 for the page and #1c1c1c for the stage the component sits on */
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--pg-bg:#111111;--pg-fg:#f2f2f2;--pg-dim:#c9c9c9;--pg-muted:#c0c0c0;--pg-line:rgba(255,255,255,.08);--pg-line2:rgba(255,255,255,.14);--pg-soft:#1c1c1c;--pg-chip:rgba(255,255,255,.06);--pg-ink:#f5f5f4;--pg-on-ink:#121212;--pg-top:rgba(17,17,17,.86);color-scheme:dark}}
:root[data-theme="dark"]{--pg-bg:#111111;--pg-fg:#f2f2f2;--pg-dim:#c9c9c9;--pg-muted:#c0c0c0;--pg-line:rgba(255,255,255,.08);--pg-line2:rgba(255,255,255,.14);--pg-soft:#1c1c1c;--pg-chip:rgba(255,255,255,.06);--pg-ink:#f5f5f4;--pg-on-ink:#121212;--pg-top:rgba(17,17,17,.86);color-scheme:dark}
*{box-sizing:border-box}
/* in-page links (On this page, a section's heading, a component page's section bar) glide to their section, which lands
   under the sticky header: every target keeps the header's height and a little more clear above it (scroll-margin-top; a
   page's sections set their own), and so do the page's own controls when the focus moves to them. With reduced motion
   they jump */
/* the page keeps the scrollbar's room whether or not it scrolls, as the homepage does (make-patches.py), so the 1400px row is
   centred in the same width on every page and the header and sidebar never shift between them */
html{-webkit-text-size-adjust:100%;scrollbar-gutter:stable}
/* --pg-bar: the height of a page's sticky section bar (SectionBar), which a target clears too */
:where(.pg-main [id]:not([data-c] *), .pg-main :is(a[href],button,summary,input):not([data-c] *)){scroll-margin-top:calc(var(--pg-head) + var(--pg-bar, 0px) + 24px)}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
body{margin:0;background:var(--pg-bg);color:var(--pg-fg);font:14px/1.6 var(--pg-sans);letter-spacing:-.006em;-webkit-font-smoothing:antialiased}
a{color:inherit}
/* the page's own ring, from the keyboard only: 2px of the stronger grey (3:1 on the page), never the accent and never black.
   A field shows its focus with its edge instead, which steps up from the dimmed grey (--pg-field) to the same grey. A
   component draws its own (--focus), the same way, so this one stays out of it */
/* React's mark beside its install command: the darker teal react.dev uses on a light page, its cyan on a dark one */
:root{--pg-react:#087ea4}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--pg-react:#61dafb}}
:root[data-theme="dark"]{--pg-react:#61dafb}
:root{--pg-field:#d4d4d4;--pg-focus:#858585}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--pg-field:#424242;--pg-focus:#808080}}
:root[data-theme="dark"]{--pg-field:#424242;--pg-focus:#808080}
:focus-visible:not([data-c] *){outline:2px solid var(--pg-focus);outline-offset:2px}
:is(input:not([type="checkbox"],[type="radio"],[type="range"],[type="color"],[type="file"]),textarea):focus-visible:not([data-c] *){outline:0}

/* header: the logo, which leads home, then the GitHub pill and the style and theme switches, in a 1400px row with a line under
   it across the whole window. It has no links: the site's pages are in the sidebar, as on the homepage. 53px tall like the
   homepage's, and 61px on a tablet or phone */
.pg-top{position:sticky;top:0;z-index:50;height:var(--pg-head);background:var(--pg-top);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--pg-line)}
.pg-top-in{height:100%;max-width:1464px;margin:0 auto;padding:0 32px;display:flex;align-items:center;gap:6px}
.pg-logo{display:block;color:var(--pg-fg)}
.pg-notr,.pg-notr *,.pg-notr *::before,.pg-notr *::after{transition:none!important}
/* the control that changed the theme still moves (owner, 10 Nov): a switch's knob slides while the rest of the page changes at once */
.pg-notr .toggle,.pg-notr .toggle::after{transition:background .15s ease,transform .3s cubic-bezier(.22,1,.36,1)!important}
.pg-notr .pg-seg .pg-k{transition:transform .32s cubic-bezier(.22,1,.36,1),width .32s cubic-bezier(.22,1,.36,1)!important}
/* the header's switches (style, theme): a knob slides to the pick */
.pg-seg{position:relative}
.pg-seg button{z-index:1}
.pg-seg .pg-k{position:absolute;top:2px;bottom:2px;left:0;width:0;border-radius:999px;background:var(--pg-bg);box-shadow:0 1px 2px rgba(18,18,18,.08),0 0 0 .5px rgba(18,18,18,.06);pointer-events:none;transition:transform .32s cubic-bezier(.22,1,.36,1),width .32s cubic-bezier(.22,1,.36,1)}
.pg-seg.has-k button[aria-checked="true"]{background:none;box-shadow:none}
@media (prefers-reduced-motion:reduce){.pg-seg .pg-k,.pg-notr .pg-seg .pg-k,.pg-notr .toggle,.pg-notr .toggle::after{transition:none!important}}
/* an app page (the templates) fills the window, so its header does too: the smiley sits over the sidebar's workspace tile
   (14px in) and the style and theme switches end where the dashboard's top bar does (16px in) (owner, 9 Nov) */
.pg-top.app .pg-top-in{max-width:none;padding:0 16px 0 14px}
.pg-logo.pg-smile{transform:none;display:grid;place-items:center;width:28px;height:28px;margin-right:var(--pg-smile-gap,10px);border-radius:8px}
.pg-logo.pg-smile svg{width:24px;height:20px}
/* the homepage's logo, at its sizes: 26px scaled to .88 from its left edge, and 18, 16 and 14px on phones */
.pg-logo{transform:scale(.88);transform-origin:left center}
.pg-logo svg{display:block;height:26px;width:auto}
@media (max-width:640px){.pg-logo svg{height:18px}}
@media (max-width:420px){.pg-logo svg{height:16px}}
@media (max-width:340px){.pg-logo svg{height:14px}}
/* the logo, option 3: the wordmark's paths as a hairline between its guides, filling in from D to E on hover or keyboard
   focus; solid on phones and touch screens. The same styles as the homepage (make-patches.py, #logo-o3) */
.lg svg.L{overflow:visible}
.lg .L .wm{fill:currentColor}
.lg .L .wm .ch{fill-opacity:0;stroke:currentColor;stroke-width:1px;vector-effect:non-scaling-stroke;transition:fill-opacity .2s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 45ms),stroke-opacity .2s cubic-bezier(.2,.7,.2,1) calc(var(--i) * 45ms)}
.lg .L .dev{fill:var(--dm-accent-fg,currentColor)}
.lg .L .cons{fill:none;stroke:var(--dm-accent-mark,currentColor);transition:opacity .3s cubic-bezier(.2,.7,.2,1)}
.lg .L .cons path{stroke-width:1px;vector-effect:non-scaling-stroke}
.lg .L .cons .cl{stroke-opacity:.45}
.lg:focus-visible .L .wm .ch{fill-opacity:1;stroke-opacity:0}
.lg:focus-visible .L .cons{opacity:.3}
@media (hover:hover) and (pointer:fine){.lg:hover .L .wm .ch{fill-opacity:1;stroke-opacity:0}.lg:hover .L .cons{opacity:.3}}
@media (hover:none),(max-width:640px){.lg .L .wm .ch{fill-opacity:1;stroke:none}.lg .L .cons{opacity:.3}}
@media (prefers-reduced-motion:reduce){.lg .L .wm .ch{transition-delay:0s}}
.pg-sp{flex:1}
/* the templates' accent picker: a dot in the header that opens the homepage's swatches (owner, 10 Nov) */
.pg-acc{position:relative;display:flex}
.pg-acc-b{display:grid;place-items:center;width:28px;height:28px;margin-left:2px;padding:0;border:0;border-radius:999px;background:var(--pg-chip);cursor:pointer}
.pg-acc-dot{display:block;width:14px;height:14px;border-radius:50%;background:var(--pg-acc,#116ff8);box-shadow:0 0 0 3px color-mix(in srgb,var(--pg-acc,#116ff8) 22%,transparent);transition:background .25s,box-shadow .25s}
.pg-acc-pop{position:absolute;top:calc(100% + 10px);right:0;z-index:80;display:flex;flex-direction:column;gap:12px;width:max-content;padding:14px;border-radius:16px;background:var(--pg-bg);border:1px solid var(--pg-line);box-shadow:0 1px 2px rgba(17,19,24,.05),0 24px 48px -20px rgba(17,19,24,.28);opacity:0;visibility:hidden;transform:translateY(-4px);transition:opacity .15s ease,transform .25s cubic-bezier(.16,1,.3,1),visibility 0s .25s}
.pg-acc-pop.open{opacity:1;visibility:visible;transform:none;transition:opacity .2s ease,transform .35s cubic-bezier(.16,1,.3,1),visibility 0s}
.pg-acc-t{font:500 13px/1.3 var(--pg-sans);color:var(--pg-fg)}
.pg-acc .dc-acc{display:flex;gap:8px}
.pg-acc .dc-sw{position:relative;flex:none;width:24px;height:24px;padding:0;border:0;border-radius:50%;background:var(--sw,#d4f84a);cursor:pointer;transition:transform .2s cubic-bezier(.34,1.56,.64,1),box-shadow .2s}
.pg-acc .dc-sw[data-acc="default"]{--sw:#d4f84a}
:root[data-style="soft"] .pg-acc .dc-sw[data-acc="default"]{--sw:#116ff8}
:root:not([data-style="soft"]) .pg-acc .dc-sw[data-acc="#d4f84a"],:root[data-style="soft"] .pg-acc .dc-sw[data-acc="#116ff8"]{display:none}
.pg-acc .dc-sw[aria-checked="true"],.pg-acc .dc-sw.any.on{box-shadow:0 0 0 2px var(--pg-bg),0 0 0 4px var(--pg-fg)}
.pg-acc .dc-sw.any{background:conic-gradient(#ff4d4d,#ffb84d,#f4e04d,#4dd47a,#4dc3ff,#7a6bff,#ff4dd8,#ff4d4d)}
.pg-acc .dc-sw.any.on{background:var(--sw)}
.pg-acc .dc-sw.any input{position:absolute;inset:0;width:100%;height:100%;margin:0;padding:0;border:0;opacity:0;cursor:pointer}
.pg-acc .dc-sw:focus-visible,.pg-acc .dc-sw.any:has(input:focus-visible),.pg-acc-b:focus-visible{outline:2px solid var(--pg-focus);outline-offset:3px}
@media (hover:hover) and (pointer:fine){.pg-acc .dc-sw:hover{transform:scale(1.12)}}
@media (prefers-reduced-motion:reduce){.pg-acc-pop,.pg-acc-pop.open,.pg-acc .dc-sw{transition:none}}
.pg-seg{display:inline-flex;padding:2px;border-radius:999px;background:var(--pg-chip)}
.pg-seg button{height:24px;padding:0 10px;border:0;border-radius:999px;background:none;color:var(--pg-dim);font:500 13px/1 var(--pg-sans);cursor:pointer;transition:color .2s}
/* on a touch screen the header's small switches and the GitHub pill get a 44px tall tap area, drawn by nothing (they look the same) */
@media (pointer:coarse){.pg-seg button,.pg-gh{position:relative}.pg-seg button::after,.pg-gh::after{content:"";position:absolute;left:0;right:0;top:50%;height:44px;margin-top:-22px}}
.pg-seg button:hover{color:var(--pg-fg)}
.pg-seg button[aria-checked="true"]{background:var(--pg-bg);color:var(--pg-fg);box-shadow:0 1px 2px rgba(18,18,18,.08),0 0 0 .5px rgba(18,18,18,.06)}
/* dark mode: the switch is a track a few tones darker than the header, outlined as a whole, and a lighter knob with no
   outline, as in the templates (owner, 12 Nov) */
:root[data-theme="dark"] .pg-seg{background:#0a0a0a;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}
:root[data-theme="dark"] :is(.pg-seg .pg-k,.pg-seg:not(.has-k) button[aria-checked="true"]){background:#2c2c2c;box-shadow:none}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pg-seg{background:#0a0a0a;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12)}:root:not([data-theme="light"]) :is(.pg-seg .pg-k,.pg-seg:not(.has-k) button[aria-checked="true"]){background:#2c2c2c;box-shadow:none}}
.pg-seg svg{display:block;width:14px;height:14px}
.pg-seg.icons button{width:26px;padding:0;display:grid;place-items:center}
/* the GitHub pill: GitHub's mark and the star count, or "Star on GitHub" when there is no count to show */
.pg-gh{flex:none;display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 11px 0 9px;margin-right:6px;border-radius:999px;background:var(--pg-bg);box-shadow:inset 0 0 0 1px var(--pg-line2);color:var(--pg-dim);font:500 13px/1 var(--pg-sans);text-decoration:none;white-space:nowrap;transition:color .2s,background-color .2s}
.pg-gh:hover{color:var(--pg-fg);background:var(--pg-chip)}
.pg-gh svg{display:block;width:14px;height:14px;flex:none}
.pg-gh-n{color:var(--pg-fg);font-variant-numeric:tabular-nums}
.pg-gh.has-n .pg-gh-l{display:none}

/* the column of a page without the sidebar: 960px of content */
.pg-wrap{max-width:1024px;margin:0 auto;padding:0 32px}
.pg-main{padding:40px 0 96px}
.pg-crumbs{display:flex;flex-wrap:wrap;gap:6px;font-size:13px;color:var(--pg-muted)}
.pg-crumbs a{color:var(--pg-dim);text-decoration:none}
.pg-crumbs a:hover{color:var(--pg-fg)}
.pg-h1{margin:14px 0 0;font-size:20px;line-height:1.3;font-weight:500;letter-spacing:-.022em;color:var(--pg-fg);text-wrap:balance}
.pg-lead{margin:8px 0 0;font-size:14px;line-height:1.6;color:var(--pg-dim);max-width:72ch}
.pg-lead code,.pg-code{font:500 12.5px/1.4 var(--pg-mono);font-variant-ligatures:none;background:var(--pg-chip);padding:2px 6px;border-radius:6px;color:var(--pg-fg)}
/* the install line under a heading, like the homepage's */
.pg-cmd{display:inline-flex;align-items:center;gap:8px;min-height:32px;margin:16px 0 0;padding:4px 6px 4px 10px;border-radius:9px;box-shadow:inset 0 0 0 1px var(--pg-line2);background:var(--pg-bg);font:500 12px/1 var(--pg-mono);font-variant-ligatures:none;max-width:100%}
.pg-cmd .d{color:var(--pg-muted)}
/* the command wraps at a space when it doesn't fit, so no part of it hides behind the copy button */
.pg-cmd .c{min-width:0;color:var(--pg-fg);line-height:1.5;overflow-wrap:anywhere}
.pg-cmd .c span{white-space:nowrap}
.pg-cmd button{flex:none}
.pg-cmd button{display:grid;place-items:center;width:24px;height:24px;border:0;border-radius:6px;background:none;color:var(--pg-muted);cursor:pointer}
.pg-cmd button:hover{color:var(--pg-fg);background:var(--pg-chip)}
.pg-cmd svg{width:14px;height:14px}
/* section header: the number and the heading on one line, what the section is under them */
.pg-sh{display:flex;align-items:baseline;flex-wrap:wrap;gap:2px 10px;padding:56px 0 18px;margin:0 0 24px;border-bottom:1px solid var(--pg-line)}
.pg-sh .n{font:500 12px/1.5 var(--pg-mono);color:var(--pg-muted)}
.pg-sh h2{margin:0;font-size:14px;line-height:20px;font-weight:500;letter-spacing:0}
.pg-sh p{flex-basis:100%;margin:0;font-size:14px;line-height:20px;color:var(--pg-dim)}
.pg-t{font-size:14px;line-height:20px;font-weight:500;letter-spacing:0;color:var(--pg-fg)}
.pg-d{font-size:14px;line-height:20px;color:var(--pg-dim)}
/* a component card: a light frame with its picture on the grey stage, and its name and one line under it. The name is the
   link, stretched over the whole card, so the picture (which can be a live component) is never inside a link */
.pg-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.pg-card{display:flex;flex-direction:column;padding:5px;border-radius:16px;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--pg-line) 50%,transparent);text-decoration:none;transition:box-shadow .16s ease}
.pg-card:hover{box-shadow:inset 0 0 0 1px var(--pg-line)}
.pg-card .pg-thumb{order:-1}
.pg-card{position:relative}
.pg-card .pg-t{margin:10px 6px 0;text-decoration:none}
.pg-link::after{content:"";position:absolute;inset:0;z-index:2;border-radius:16px}
.pg-card .pg-d{margin:0 6px 6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pg-thumb{position:relative;aspect-ratio:16/10;border-radius:12px;background:var(--pg-soft);overflow:hidden}
.pg-thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s cubic-bezier(.16,1,.3,1)}
.pg-card:hover .pg-thumb img{transform:scale(1.025)}
.pg-thumb .dk{display:none}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .pg-thumb .lt{display:none}:root:not([data-theme="light"]) .pg-thumb .dk{display:block}}
:root[data-theme="dark"] .pg-thumb .lt{display:none}
:root[data-theme="dark"] .pg-thumb .dk{display:block}
@media (max-width:860px){.pg-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:520px){.pg-cards{grid-template-columns:minmax(0,1fr)}}

.pg-foot{color:var(--pg-muted);font-size:14px;border-top:1px solid var(--pg-line)}
/* the footer spans the header's 1400px row, like the sidebar and the page above it */
.pg-foot .pg-wrap{max-width:1464px}
.pg-foot-in{padding-block:28px 40px;display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between}
.pg-foot nav{display:flex;flex-wrap:wrap;gap:18px}
.pg-foot a{color:var(--pg-dim);text-decoration:none}
.pg-foot a:hover{color:var(--pg-fg)}
/* a link inside the sentence is underlined, as in the docs, so it reads as a link without its colour */
.pg-foot-in > span a{text-decoration:underline;text-decoration-color:var(--pg-line2);text-underline-offset:3px;transition:text-decoration-color .16s}
.pg-foot-in > span a:hover{text-decoration-color:currentColor}
/* the page's edges: 24px on a tablet and 16px on a phone, as on the homepage; a section starts 40px under the last */
@media (max-width:960px){:root{--pg-head:61px}.pg-top-in{padding:0 24px}.pg-wrap{padding:0 24px}.pg-top .pg-style{display:none}.pg-gh{height:32px;padding:0 12px 0 10px}}
@media (max-width:640px){.pg-top-in{padding:0 16px}.pg-wrap{padding:0 16px}.pg-h1{font-size:20px}.pg-main{padding:24px 0 64px}.pg-sh{padding-top:40px;margin-bottom:20px}.pg-foot-in{padding-block:24px 32px}}
@media (max-width:420px){.pg-top-in{gap:4px}.pg-gh{padding:0 9px 0 8px}}
/* tap areas: on a touch screen every control of the page's own (the header, the menu, the sidebar, links and buttons in the
   text) gets a clear area of at least 40px square around it, as the components do (their core's @media (pointer:coarse)),
   without changing how it looks. The tap-area script below shrinks two areas that would overlap, so each tap lands on the
   control nearest to it. It weighs nothing (:where), so a control's own position wins; one that draws with its ::before
   uses its ::after, and a card's stretched link is left as it is. Book a call draws with both, but only on hover, which a
   touch screen doesn't have, so there its ::before is the tap area */
@media (pointer:coarse){
  :where(body) :where(button,a[href],summary,[role="button"],[role="tab"],[role="switch"],[role="radio"],[role="checkbox"],label:has(input[type="color"],input[type="checkbox"],input[type="radio"])):not(:where([data-c],[data-c] *,.pg-link)){position:relative;--dm-hit-w:40px;--dm-hit-h:40px}
  :where(body) :where(button,a[href],summary,[role="button"],[role="tab"],[role="switch"],[role="radio"],[role="checkbox"],label:has(input[type="color"],input[type="checkbox"],input[type="radio"])):not(:where([data-c],[data-c] *,.pg-link,.side-ul .side-a.act,.hire-btn,details.cp-file summary))::before,
  :where(body) :where(button,a[href],summary,[role="button"],[role="tab"],[role="switch"],[role="radio"],[role="checkbox"]):where(.side-ul .side-a.act,details.cp-file summary):not(:where([data-c] *))::after{content:"";position:absolute;inset:min(0px,(100% - var(--dm-hit-h)) / 2) min(0px,(100% - var(--dm-hit-w)) / 2);--dm-hit:1}
  body .hire-btn{overflow:visible}
  body .hire-btn::before{left:auto;top:auto;width:auto;height:auto;margin:0;inset:min(0px,(100% - var(--dm-hit-h)) / 2) min(0px,(100% - var(--dm-hit-w)) / 2);border-radius:0;background:none;opacity:0;transform:none;transition:none;--dm-hit:1}
}
/* Skip to content: out of sight until Tab reaches it (it is the first thing there), then a small pill top left, over the
   header. It moves the focus to the page's heading (#content), which lands under the header like any anchor */
.pg-skip{position:fixed;top:8px;left:16px;z-index:100;display:inline-flex;align-items:center;height:32px;padding:0 12px;border-radius:999px;background:var(--pg-bg);color:var(--pg-fg);box-shadow:inset 0 0 0 1px var(--pg-line2);font:500 13px/1 var(--pg-sans);letter-spacing:0;text-decoration:none;white-space:nowrap;opacity:0;transform:translateY(-48px);pointer-events:none}
.pg-skip:focus{opacity:1;transform:none;pointer-events:auto;outline:2px solid var(--pg-focus);outline-offset:2px}
@media (prefers-reduced-motion:no-preference){.pg-skip{transition:opacity .2s ease,transform .2s cubic-bezier(.16,1,.3,1)}}
#content:focus{outline:none}
/* read out by screen readers, not shown */
.pg-sr{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
</style>
</head>
<body>
<a class="pg-skip" href="#content">Skip to content</a>
<div class="pg-sr" id="pg-live" role="status" aria-live="polite"></div>
<header class={app ? 'pg-top app' : 'pg-top'}><div class="pg-top-in">
  {app ? <a class="pg-logo pg-smile" href="/" aria-label="Designme.dev home" set:html={SMILEY} /> : <a class="pg-logo lg o3" href="/" aria-label="Designme.dev home" set:html={LOGO} />}
  <slot name="top" />
  <span class="pg-sp"></span>
  <a class="pg-gh" href={GITHUB} aria-label="Star designme.dev on GitHub" data-gh-stars><svg viewBox="0 0 24 24" aria-hidden="true" set:html={GH_MARK} /><span class="pg-gh-l">Star on GitHub</span><span class="pg-gh-n" hidden></span></a>
  <div class="pg-seg pg-style" role="radiogroup" aria-label="Style"><button type="button" role="radio" aria-checked="false" data-style-set="bp">Blueprint</button><button type="button" role="radio" aria-checked="false" data-style-set="soft">Soft</button><button type="button" role="radio" aria-checked="false" aria-haspopup="dialog" data-style-set="mine">Your theme</button></div>
  <div class="pg-seg icons" role="radiogroup" aria-label="Theme">
    <button type="button" role="radio" aria-checked="false" data-theme-set="light" aria-label="Light"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
    <button type="button" role="radio" aria-checked="false" data-theme-set="dark" aria-label="Dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
  </div>
  {app && <div class="pg-acc">
    <button type="button" class="pg-acc-b" aria-haspopup="dialog" aria-expanded="false" aria-label="Accent colour"><i class="pg-acc-dot" aria-hidden="true"></i></button>
    <div class="pg-acc-pop" role="dialog" aria-label="Accent colour"><span class="pg-acc-t" id="pg-acc-t">Accent colour</span>
      <div class="dc-acc" role="radiogroup" aria-labelledby="pg-acc-t">{ACCENT_SW.map(([v, n]) => <button type="button" class="dc-sw" role="radio" aria-checked="false" data-acc={v} aria-label={n} title={n} style={v === 'default' ? undefined : `--sw:${v}`}></button>)}<label class="dc-sw any" title="Any colour"><input type="color" value="#ff850d" aria-label="Pick any colour"></label></div>
    </div>
  </div>}
</div></header>
<main class={app ? 'pg-app' : 'pg-main'}><slot /></main>
<footer class="pg-foot"><div class="pg-wrap"><div class="pg-foot-in">
  <span>Free and MIT licensed. Built by <a href="https://designme.agency">DesignMe</a>.</span>
  <nav aria-label="More"><a href="/">All components</a><a href="/docs/introduction">Docs</a><a href="/#/changelog">Changelog</a><a href="/#/roadmap">Roadmap</a><a href="/llms.txt">llms.txt</a><a href="/">Home</a></nav>
</div></div></footer>
<script is:inline>
// Skip to content: the focus moves to the page's heading, which glides (or, with reduced motion, jumps) under the header,
// without changing the address
(function(){
  var s = document.querySelector('.pg-skip'); if (!s) return;
  s.addEventListener('click', function(e){
    var t = document.getElementById('content') || document.querySelector('main'); if (!t) return;
    e.preventDefault(); if (!t.hasAttribute('tabindex')) t.setAttribute('tabindex', '-1');
    t.focus({ preventScroll:true }); t.scrollIntoView({ block:'start' });
  });
})();
// light and dark, and Blueprint or Soft, shared with the rest of the site through the same saved settings
(function(){
  var root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)');
  // Your theme: Soft with a pasted shadcn/Tailwind v4 theme over the demos (window.dmTheme, from the head)
  var mine = function(){ try { return localStorage.getItem('dmui-style') === 'mine'; } catch(e){ return false; } };
  var theme = function(){ return root.getAttribute('data-theme') || (mq.matches ? 'dark' : 'light'); };
  var paint = function(){
    var t = theme(), style = mine() ? 'mine' : root.getAttribute('data-style') === 'soft' ? 'soft' : 'bp';
    // each switch is a set of radio buttons with one Tab stop, the one that's picked
    (function(){ function knob(seg){ var k = seg.querySelector('.pg-k'), b = seg.querySelector('[aria-checked="true"]'); if (!b) return;
        if (!k){ k = document.createElement('span'); k.className = 'pg-k'; k.setAttribute('aria-hidden', 'true'); seg.prepend(k); seg.classList.add('has-k'); k.style.transition = 'none'; }
        // the knob sits exactly under the picked button: measured from the switch's own box, to the subpixel, so it keeps
        // the switch's 2px inset on every side (it used to start 2px left of the button, touching the track's edge)
        var sr = seg.getBoundingClientRect(), br = b.getBoundingClientRect();
        k.style.width = br.width + 'px'; k.style.transform = 'translateX(' + (br.left - sr.left - seg.clientLeft) + 'px)'; if (k.style.transition){ void k.offsetWidth; k.style.transition = ''; } }
      document.querySelectorAll('.pg-seg').forEach(function(seg){ new MutationObserver(function(){ knob(seg); }).observe(seg, { subtree:true, attributes:true, attributeFilter:['aria-checked'] }); requestAnimationFrame(function(){ knob(seg); }); if (window.ResizeObserver) new ResizeObserver(function(){ knob(seg); }).observe(seg); }); })();
    document.querySelectorAll('[data-theme-set]').forEach(function(b){ var on = b.dataset.themeSet === t; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
    document.querySelectorAll('[data-style-set]').forEach(function(b){ var on = b.dataset.styleSet === style; b.setAttribute('aria-checked', String(on)); b.tabIndex = on ? 0 : -1; });
  };
  // the arrow keys move between the two and pick
  document.querySelectorAll('.pg-seg[role="radiogroup"]').forEach(function(g){ g.addEventListener('keydown', function(e){
    var d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
    var bs = [].slice.call(g.querySelectorAll('[role="radio"]')), i = bs.indexOf(document.activeElement);
    if (!d || i < 0) return; e.preventDefault();
    var n = bs[(i + d + bs.length) % bs.length]; n.click(); n.focus();
  }); });
  document.querySelectorAll('[data-theme-set]').forEach(function(b){ b.addEventListener('click', function(){
    var next = b.dataset.themeSet, sys = mq.matches ? 'dark' : 'light';
    // for the moment the theme changes nothing animates its colours, so no button shows the old theme's grey for a frame
    root.classList.add('pg-notr'); requestAnimationFrame(function(){ requestAnimationFrame(function(){ root.classList.remove('pg-notr'); }); });
    if (next === sys){ root.removeAttribute('data-theme'); try { localStorage.removeItem('dmui-theme'); } catch(e){} }
    else { root.setAttribute('data-theme', next); try { localStorage.setItem('dmui-theme', next); } catch(e){} }
    paint();
  }); });
  var softBtn = function(){ return [].slice.call(document.querySelectorAll('[data-style-set="soft"]')).filter(function(x){ return x.offsetParent; })[0] || document.querySelector('[data-style-set="soft"]'); };
  document.querySelectorAll('[data-style-set]').forEach(function(b){ b.addEventListener('click', function(e){
    var v = b.dataset.styleSet;
    // Your theme opens its panel on every click, Enter or Space, so the theme can be changed or reset (Reset goes back to Soft);
    // arrowing onto it (the arrow keys click it from the script) only picks it, so the arrows carry on through the switch
    var panel = function(){ if (v === 'mine' && e.isTrusted && window.dmTheme) window.dmTheme.open(b, function(){ var s = softBtn(); if (s) s.click(); }); };
    if (b.getAttribute('aria-checked') === 'true'){ panel(); return; }
    if (v === 'bp') root.removeAttribute('data-style'); else root.setAttribute('data-style', 'soft');
    try { localStorage.setItem('dmui-style', v); } catch(e){}
    if (window.dmTheme) window.dmTheme.apply(v === 'mine');
    paint(); document.dispatchEvent(new CustomEvent('pg-style'));
    panel();
  }); });
  // a theme previewed from the panel starts the demo again, as a new style does
  document.addEventListener('dm-theme', function(){ paint(); document.dispatchEvent(new CustomEvent('pg-style')); });
  mq.addEventListener('change', paint);
  paint();
  // the GitHub pill shows the repository's stars when GitHub answers, once a session; until then, or if it doesn't (a
  // private repository answers 404), it reads "Star on GitHub". The browser still logs a failed request on its own
  (function(){
    var pills = document.querySelectorAll('[data-gh-stars]'), KEY = 'dm-gh-stars';
    if (!pills.length) return;
    var fmt = function(n){ return n < 1000 ? String(n) : n < 1e6 ? (Math.floor(n / 100) / 10) + 'k' : (Math.floor(n / 1e5) / 10) + 'm'; };
    var show = function(n){ pills.forEach(function(a){ var c = a.querySelector('.pg-gh-n'); c.textContent = fmt(n); c.hidden = false; a.classList.add('has-n'); a.setAttribute('aria-label', 'Star designme.dev on GitHub, ' + n.toLocaleString('en') + ' stars'); }); };
    var saved = null; try { saved = sessionStorage.getItem(KEY); } catch(e){}
    if (saved !== null){ if (/^\d+$/.test(saved) && +saved > 0) show(+saved); return; }
    if (!window.fetch) return;
    var keep = function(v){ try { sessionStorage.setItem(KEY, v); } catch(e){} };
    fetch('https://api.github.com/repos/bydesignme/designme-dev').then(function(r){ return r.ok ? r.json() : null; }).then(function(d){
      var n = d && typeof d.stargazers_count === 'number' ? d.stargazers_count : null;
      keep(n === null ? '-' : String(n)); if (n) show(n);
    }).catch(function(){ keep('-'); });
  })();
  // copy buttons: the text goes to the clipboard, or through a hidden field where the browser won't allow that. The button
  // says Copied for a moment and a half (its word changes, and its icon turns into a check), and a polite live region says
  // what was copied for screen readers
  var live = document.getElementById('pg-live');
  var CHECK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  var viaField = function(text){ var t = document.createElement('textarea'); t.value = text; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.top = '0'; t.style.opacity = '0'; document.body.appendChild(t); t.select(); var ok = false; try { ok = document.execCommand('copy'); } catch(e){} t.remove(); return ok; };
  var write = function(text){ return navigator.clipboard && navigator.clipboard.writeText ? navigator.clipboard.writeText(text).then(function(){ return true; }, function(){ return viaField(text); }) : Promise.resolve(viaField(text)); };
  var say = function(msg){ if (!live) return; live.textContent = ''; setTimeout(function(){ live.textContent = msg; }, 60); };
  document.querySelectorAll('[data-copy]').forEach(function(b){ b.addEventListener('click', function(){
    write(b.dataset.copy).then(function(ok){
      if (!ok){ say("Couldn't copy. Select the text and copy it instead"); return; }
      var html = b._html || (b._html = b.innerHTML), label = b.dataset.label, at = label ? html.lastIndexOf(label) : -1;
      var on = html.replace(/<svg[\s\S]*?<\/svg>/, CHECK); if (at >= 0) on = on.slice(0, on.lastIndexOf(label)) + 'Copied' + on.slice(on.lastIndexOf(label) + label.length);
      var what = (b.getAttribute('aria-label') || '').replace(/^Copy\s*/i, '');
      clearTimeout(b._t); b.innerHTML = on; b.classList.add('done');
      say(what ? what.charAt(0).toUpperCase() + what.slice(1) + ' copied' : 'Copied');
      b._t = setTimeout(function(){ b.innerHTML = html; b.classList.remove('done'); }, 1500);
    });
  }); });
})();
</script>
<script is:inline>
// the menu's settings on a phone or tablet: Blueprint or Soft (the header's script above handles every [data-style-set]), the
// accent and sound, saved under the homepage's own keys so a choice made on one page holds on every other: the accent in
// local storage (dmui-accent), sound in session storage (dmui-sound), so it starts muted in a new tab, as on the homepage
(function(){
  var root = document.documentElement;
  // ---- the accent: the same swatches as the homepage's picker, and the colour worked out again when the style or theme changes
  var sws = [].slice.call(document.querySelectorAll('[data-acc]')), any = document.querySelector('.dc-sw.any'), anyIn = any && any.querySelector('input');
  var cur = 'default'; try { cur = localStorage.getItem('dmui-accent') || 'default'; } catch(e){}
  var apply = function(){ if (window.dmAccent) window.dmAccent(cur === 'default' ? null : cur); };
  // the swatch the style hides, as its Default is the same colour
  var twin = function(b){ return b.dataset.acc === (root.getAttribute('data-style') === 'soft' ? '#116ff8' : '#d4f84a'); };
  var mark = function(){
    var known = sws.some(function(b){ return b.dataset.acc === cur; });
    sws.forEach(function(b){ b.setAttribute('aria-checked', String(b.dataset.acc === cur)); });
    if (any){ any.classList.toggle('on', !known); if (!known) any.style.setProperty('--sw', cur); else any.style.removeProperty('--sw'); }
    // one Tab stop per row of swatches: the picked one, or the first shown when the colour is one picked from the wheel
    [].slice.call(document.querySelectorAll('.dc-acc')).forEach(function(g){
      var all = [].slice.call(g.querySelectorAll('[data-acc]')), vis = all.filter(function(b){ return !twin(b); });
      var on = vis.filter(function(b){ return b.dataset.acc === cur; })[0] || vis[0];
      all.forEach(function(b){ b.tabIndex = b === on ? 0 : -1; });
    });
  };
  var commit = function(v){ cur = v; try { localStorage.setItem('dmui-accent', v); } catch(e){} apply(); mark(); Snd.play('select'); };
  sws.forEach(function(b){ b.addEventListener('click', function(){ commit(b.dataset.acc); }); });
  // the arrow keys, Home and End move through the swatches shown and pick
  [].slice.call(document.querySelectorAll('.dc-acc')).forEach(function(g){ g.addEventListener('keydown', function(e){
    var b = e.target.closest('[data-acc]'); if (!b) return;
    var vis = [].slice.call(g.querySelectorAll('[data-acc]')).filter(function(x){ return !twin(x); }), i = vis.indexOf(b);
    var d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
    var n = d ? vis[(i + d + vis.length) % vis.length] : e.key === 'Home' ? vis[0] : e.key === 'End' ? vis[vis.length - 1] : null;
    if (!n) return; e.preventDefault(); commit(n.dataset.acc); n.focus();
  }); });
  var accB = document.querySelector('.pg-acc-b'), accP = document.querySelector('.pg-acc-pop');
  var dot = function(){ var c = document.querySelector('[data-c]') || root, v = getComputedStyle(c).getPropertyValue('--dm-accent').trim(); if (v && root.style.getPropertyValue('--pg-acc') !== v) root.style.setProperty('--pg-acc', v); };
  if (accB && accP){
    var accOpen = function(on){ accP.classList.toggle('open', on); accB.setAttribute('aria-expanded', String(on)); if (on){ var f = accP.querySelector('[data-acc][tabindex="0"]'); if (f) f.focus({ preventScroll:true }); } };
    accB.addEventListener('click', function(){ accOpen(!accP.classList.contains('open')); });
    document.addEventListener('pointerdown', function(e){ if (accP.classList.contains('open') && !e.target.closest('.pg-acc')) accOpen(false); });
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && accP.classList.contains('open')){ accOpen(false); accB.focus(); } });
    new MutationObserver(function(){ requestAnimationFrame(dot); }).observe(root, { attributes:true, attributeFilter:['data-style', 'data-theme', 'style'] });
    requestAnimationFrame(dot);
  }
  if (anyIn){ anyIn.addEventListener('input', function(){ cur = anyIn.value; apply(); mark(); }); anyIn.addEventListener('change', function(){ commit(anyIn.value); }); }
  new MutationObserver(function(){ apply(); mark(); }).observe(root, { attributes:true, attributeFilter:['data-style', 'data-theme'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', apply);
  mark();

  // ---- sound: the homepage's recordings (sounds/ui.wav, which sounds/ui.json maps), fetched once sound is on
  var Snd = (function(){
    var on = false; try { on = sessionStorage.getItem('dmui-sound') === 'on'; } catch(e){}
    var ctx = null, master = null, buf = null, map = null, loading = null, last = 0, VARY = { hover:.05, click:.04, tick:.04, tab:.03 };
    function load(){
      if (loading || !ctx) return loading;
      loading = Promise.all([fetch('/sounds/ui.json').then(function(r){ return r.json(); }), fetch('/sounds/ui.wav').then(function(r){ return r.arrayBuffer(); })])
        .then(function(x){ return new Promise(function(res, rej){ ctx.decodeAudioData(x[1], res, rej); }).then(function(b){ buf = b; map = x[0]; }); })
        .catch(function(){ loading = null; });
      return loading;
    }
    function ensure(){
      if (!ctx){ var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return; ctx = new AC(); master = ctx.createGain(); master.gain.value = .7; var comp = ctx.createDynamicsCompressor(); master.connect(comp); comp.connect(ctx.destination); }
      if (ctx.state === 'suspended') ctx.resume();
      if (on) load();
    }
    function sample(n){
      var s = map && map[n]; if (!s || !on || !ctx || ctx.state !== 'running') return;
      var src = ctx.createBufferSource(), g = ctx.createGain(), v = VARY[n] || 0;
      src.buffer = buf; src.playbackRate.value = 1 + (Math.random() * 2 - 1) * v; g.gain.value = s[2];
      src.connect(g); g.connect(master); src.start(ctx.currentTime, s[0], s[1]);
    }
    return {
      ensure: ensure, get on(){ return on; }, get last(){ return last; },
      play: function(n){ last = performance.now(); try { if (buf) sample(n); else if (on && load()){ var t = last; loading.then(function(){ if (performance.now() - t < 400) sample(n); }); } } catch(e){} },
      set: function(v){ on = v; try { sessionStorage.setItem('dmui-sound', v ? 'on' : 'off'); } catch(e){} if (v) ensure(); }
    };
  })();
  ['pointerdown', 'keydown'].forEach(function(ev){ document.addEventListener(ev, function(){ Snd.ensure(); }, { capture:true }); });
  // every click and hover gets a sound, as on the homepage: anything with a pointer cursor counts, a switch or a checkbox says on
  // or off, typing fields stay quiet, and hovers tick once per control, never while the page scrolls, and only for a mouse
  var FIELD = 'input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="color"]),textarea,select,[contenteditable="true"]';
  var live = function(el){ return !(el.disabled || el.getAttribute('aria-disabled') === 'true'); };
  var control = function(t){ for (var el = t, k = 0; el && el.nodeType === 1 && k < 6; el = el.parentElement, k++){ if (el.matches(FIELD)) return null; var c = getComputedStyle(el).cursor; if (c === 'pointer') return el; if (c === 'not-allowed') return null; } return null; };
  document.addEventListener('click', function(e){
    if (!Snd.on || !e.isTrusted) return;
    var el = control(e.target); if (!el || !live(el)) return;
    var t0 = performance.now();
    setTimeout(function(){
      if (Snd.last >= t0) return;
      var sw = el.closest('[role="switch"],[role="checkbox"],[role="menuitemcheckbox"],input[type="checkbox"]');
      if (sw) Snd.play(sw.matches('input') ? (sw.checked ? 'on' : 'off') : sw.getAttribute('aria-checked') === 'true' ? 'on' : 'off');
      else Snd.play('click');
    }, 0);
  }, true);
  var over = null, lastHover = 0, still = 0;
  var moved = function(){ still = performance.now(); over = null; };
  addEventListener('scroll', moved, { capture:true, passive:true }); addEventListener('wheel', moved, { passive:true });
  document.addEventListener('pointerover', function(e){
    if (!Snd.on || e.pointerType !== 'mouse') return;
    var el = control(e.target); if (el === over) return; over = el;
    var now = performance.now(); if (!el || !live(el) || now - still < 180 || now - lastHover < 60) return;
    lastHover = now; Snd.play('hover');
  }, { passive:true });
  // the switch in the menu
  var sb = [].slice.call(document.querySelectorAll('.dc-snd'));
  var paint = function(){ sb.forEach(function(b){ b.setAttribute('aria-pressed', String(Snd.on)); b.setAttribute('aria-label', Snd.on ? 'Mute sounds' : 'Turn sounds on'); b.title = Snd.on ? 'Sound on' : 'Sound off'; }); };
  sb.forEach(function(b){ b.addEventListener('click', function(){ Snd.set(!Snd.on); paint(); if (Snd.on) Snd.play('on'); }); });
  paint();
})();
</script>
<script is:inline>
// a code block that scrolls is a Tab stop named after its code (a region), so it can be scrolled from the keyboard; one that
// fits, or is closed away, stays out of the Tab order. Checked again whenever a block changes size (a details opening, a tab,
// a resize) and once the fonts are in
(function(){
  var pres = [].slice.call(document.querySelectorAll('pre[data-name]')); if (!pres.length || !window.ResizeObserver) return;
  var fit = function(p){
    if (p.scrollWidth > p.clientWidth + 1 || p.scrollHeight > p.clientHeight + 1){ p.tabIndex = 0; p.setAttribute('role', 'region'); p.setAttribute('aria-label', p.dataset.name); }
    else { p.removeAttribute('tabindex'); p.removeAttribute('role'); p.removeAttribute('aria-label'); }
  };
  var ro = new ResizeObserver(function(es){ es.forEach(function(e){ fit(e.target); }); });
  pres.forEach(function(p){ ro.observe(p); });
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ pres.forEach(fit); });
})();
</script>
