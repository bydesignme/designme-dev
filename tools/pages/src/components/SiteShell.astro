---
// The frame of a docs page and a component page, laid out like the homepage: the sidebar on the left (the site's pages,
// then every component group), the page in the middle, and on wide screens what is on this page on the right, with the
// section you're reading marked as you scroll. Below 960px the sidebar gives way to a menu above the page, as the docs had.
//   doc   the docs page this is (its slug), or
//   reg   the component this is
//   where and title   the menu's label on smaller screens: "Docs / Theming", "Conversation / Composer"
//   toc   [{ id, label }], the sections in order
import SideNav from './SideNav.astro';
import { icon } from '../lib/data.mjs';
const { doc = null, reg = null, where, title, toc = [] } = Astro.props;
const chev = icon('expand_more');
---
<style is:global>
  /* the sidebar and the page side by side, in the header's 1400px row: the sidebar is 232px with its line on the right, as on
     the homepage, and the page starts 48px after it */
  .dc{display:grid;grid-template-columns:232px minmax(0,1fr);max-width:1400px;margin:0 auto;padding:0 32px}
  .pg-main:has(.dc){padding:0}
  .dc-side{position:sticky;top:var(--pg-head);align-self:start;height:calc(100vh - var(--pg-head));overflow-y:auto;padding:28px 20px 40px 0;border-right:1px solid var(--pg-line);scrollbar-width:thin;scrollbar-color:var(--pg-line2) transparent;overscroll-behavior:contain}
  /* the site's pages: an icon and a name, like the homepage's sidebar. The section you're in reads in medium text */
  .dc-pages{display:flex;flex-direction:column;gap:1px;margin:0 0 20px}
  .dc-p{display:flex;align-items:center;gap:10px;height:32px;padding:0 10px;border-radius:8px;font-size:14px;color:var(--pg-dim);text-decoration:none;transition:background-color .16s ease,color .16s ease}
  .dc-p:hover{background:var(--pg-chip);color:var(--pg-fg)}
  .dc-p.on{color:var(--pg-fg);font-weight:500}
  .dc-ic{display:grid;place-items:center;width:16px;height:16px;flex:none;color:var(--pg-muted)}
  .dc-ic svg{display:block;width:16px;height:16px;transition:transform .42s cubic-bezier(.34,1.56,.64,1)}
  .dc-p.on .dc-ic{color:var(--pg-fg)}
  /* the icons move on hover, as on the homepage: the grid turns, the page lifts, the clock winds back, the arrow climbs, the
     question mark tilts */
  .dc-p[data-p="dashboard"]:hover .dc-ic svg{transform:rotate(90deg)}
  .dc-p[data-p="description"]:hover .dc-ic svg{transform:translateY(-2px)}
  .dc-p[data-p="history"]:hover .dc-ic svg{transform:rotate(-50deg)}
  .dc-p[data-p="trending_up"]:hover .dc-ic svg{transform:translate(2px,-2px)}
  .dc-p[data-p="help"]:hover .dc-ic svg{animation:dc-tilt .6s cubic-bezier(.36,0,.2,1)}
  @keyframes dc-tilt{30%{transform:rotate(-16deg)}65%{transform:rotate(10deg)}100%{transform:none}}
  /* a list hangs off a thin rail. The page you're on has a light fill and a short bright segment on the rail, level with it */
  .dc-ul{display:flex;flex-direction:column;gap:1px;margin:2px 0 8px 17px;padding-left:10px;border-left:1px solid var(--pg-line2)}
  .dc-ul a{position:relative;display:block;padding:5px 10px;border-radius:8px;font-size:14px;line-height:20px;color:var(--pg-dim);text-decoration:none;transition:color .16s ease,background-color .16s ease}
  .dc-ul a:hover{color:var(--pg-fg);background:var(--pg-chip)}
  .dc-ul a[aria-current="page"]{color:var(--pg-fg);background:var(--pg-chip)}
  .dc-ul a[aria-current="page"]::before{content:"";position:absolute;left:-11px;top:7px;bottom:7px;width:2px;border-radius:2px;background:var(--accent-mark,var(--pg-fg))}
  /* the component groups: a name, a chevron and a count, as on the homepage */
  .dc-lbl{padding:14px 10px 6px;font-size:12px;font-weight:500;color:var(--pg-muted)}
  .dc-grp{margin:0 0 2px}
  .dc-grp>summary{display:flex;align-items:center;gap:6px;height:34px;padding:0 6px 0 4px;border-radius:8px;font-size:14px;font-weight:500;color:var(--pg-fg);cursor:pointer;list-style:none;user-select:none}
  .dc-grp>summary::-webkit-details-marker{display:none}
  .dc-grp>summary:hover{background:var(--pg-chip)}
  .dc-chev{display:grid;place-items:center;width:18px;height:18px;flex:none;margin:0 2px 0 0;color:var(--pg-muted);transform:rotate(-90deg);transition:transform .3s cubic-bezier(.16,1,.3,1)}
  .dc-chev svg{width:14px;height:14px}
  .dc-grp[open]>summary .dc-chev{transform:none}
  .dc-grp>summary .nm{flex:1}
  .dc-grp .dc-ul{margin-left:13px}
  .dc-n{display:inline-grid;place-items:center;min-width:24px;height:22px;padding:0 6px;border-radius:11px;box-shadow:inset 0 0 0 1px var(--pg-line);font-size:12px;font-weight:500;color:var(--pg-dim);font-variant-numeric:tabular-nums}

  /* the page, and on wide screens what is on it, on the right */
  .dc-main{min-width:0;display:grid;grid-template-columns:minmax(0,760px);align-items:start;padding:40px 0 96px 48px}
  .dc-body{min-width:0}
  .dc-toc{display:none}
  @media (min-width:1200px){
    .dc-main{grid-template-columns:minmax(0,760px) 184px;justify-content:space-between;column-gap:48px}
    .dc-toc{display:block;position:sticky;top:calc(var(--pg-head) + 40px);max-height:calc(100vh - var(--pg-head) - 80px);overflow-y:auto;scrollbar-width:none}
  }
  .dc-toc-h{margin:0 0 10px;font-size:13px;font-weight:500;color:var(--pg-fg)}
  .dc-toc-ul{position:relative;display:flex;flex-direction:column;border-left:1px solid var(--pg-line2)}
  .dc-toc-ul a{display:block;padding:4px 0 4px 14px;font-size:13px;line-height:20px;color:var(--pg-dim);text-decoration:none;transition:color .16s ease}
  .dc-toc-ul a:hover,.dc-toc-ul a.on{color:var(--pg-fg)}
  /* the marker: one segment that slides along the rail to the section you're reading */
  .dc-toc-ind{position:absolute;left:-1px;top:0;width:2px;height:0;opacity:0;pointer-events:none;transition:transform .32s cubic-bezier(.16,1,.3,1),height .32s cubic-bezier(.16,1,.3,1),opacity .2s}
  .dc-toc-ind::before{content:"";position:absolute;inset:6px 0;border-radius:2px;background:var(--accent-mark,var(--pg-fg))}
  .dc-toc-ind.on{opacity:1}

  /* previous and next: two cards at the end of the page */
  .dc-pn{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:64px}
  .dc-pn a{display:flex;flex-direction:column;gap:2px;padding:14px 16px;border-radius:12px;box-shadow:inset 0 0 0 1px var(--pg-line);text-decoration:none;transition:box-shadow .16s ease,background-color .16s ease}
  .dc-pn a:hover{box-shadow:inset 0 0 0 1px var(--pg-line2);background:var(--pg-soft)}
  .dc-pn .n{grid-column:2;align-items:flex-end;text-align:right}
  .dc-pn .pg-d{display:inline-flex;align-items:center;gap:6px;font-size:13px}
  .dc-pn .pg-d svg{width:14px;height:14px}

  /* the menu for screens without the sidebar */
  .dc-mnav{display:none;margin:0 0 24px;border-radius:12px;box-shadow:inset 0 0 0 1px var(--pg-line2)}
  .dc-mnav>summary{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 14px;cursor:pointer;list-style:none;font-size:14px;color:var(--pg-dim)}
  .dc-mnav>summary::-webkit-details-marker{display:none}
  .dc-mnav>summary b{font-weight:500;color:var(--pg-fg)}
  .dc-mnav>summary .dc-chev{margin-left:auto;transform:none}
  .dc-mnav[open]>summary .dc-chev{transform:rotate(180deg)}
  .dc-mnav-in{padding:8px 8px 4px;border-top:1px solid var(--pg-line)}
  .dc-mnav-in .dc-pages{margin-bottom:8px}
  .dc-mnav-in .dc-lbl{padding-top:6px}
  /* in the menu, the current component's group only: its name lines up with the pages above, its list under their icons */
  .dc-grp-h{display:flex;align-items:center;gap:6px;height:34px;padding:0 6px 0 10px;font-size:14px;font-weight:500;color:var(--pg-fg)}
  .dc-grp-h .nm{flex:1}
  .dc-grp-only .dc-ul{margin-left:17px}
  @media (prefers-reduced-motion:reduce){.dc-chev,.dc-ic svg,.dc-toc-ind{transition:none!important;animation:none!important}}
  @media (max-width:960px){
    .dc{display:block;padding:0 24px}
    .dc-side{display:none}
    .dc-main{display:block;padding:28px 0 72px}
    .dc-mnav{display:block}
    /* the menu already says where you are */
    .dc-body>.pg-crumbs{display:none}
    .dc-body>.pg-h1{margin-top:0}
  }
  @media (max-width:640px){
    .dc{padding:0 16px}
    .dc-main{padding:24px 0 64px}
    .dc-pn{grid-template-columns:minmax(0,1fr);gap:12px;margin-top:48px}
    .dc-pn .n{grid-column:1}
  }
</style>
<div class="dc">
  <aside class="dc-side" id="dc-side" aria-label="Site and components"><SideNav doc={doc} reg={reg} /></aside>
  <script is:inline>
  // the sidebar opens scrolled so the page you're on is in view, a third of the way down
  (function(){ var s = document.getElementById('dc-side'), a = s && s.querySelector('a[aria-current="page"]'); if (!a) return;
    var r = a.getBoundingClientRect(), b = s.getBoundingClientRect(); if (r.bottom > b.bottom - 24) s.scrollTop += r.top - b.top - b.height / 3; })();
  </script>
  <div class="dc-main">
    <div class="dc-body">
      <details class="dc-mnav"><summary>{where}<span aria-hidden="true">/</span><b>{title}</b><span class="dc-chev" set:html={chev} /></summary>
        <div class="dc-mnav-in"><SideNav doc={doc} reg={reg} groups="current" /></div>
      </details>
      <slot />
    </div>
    {toc.length > 1 && <nav class="dc-toc" aria-label="On this page"><p class="dc-toc-h">On this page</p>
      <div class="dc-toc-ul">{toc.map(t => <a href={`#${t.id}`}>{t.label}</a>)}<span class="dc-toc-ind" aria-hidden="true"></span></div>
    </nav>}
  </div>
</div>
<script is:inline>
// On this page: the section you're reading is the last one whose top has passed a line 120px under the header,
// or the last section once the page can't scroll further; its link turns dark and the marker slides to it. A section you
// jump to, from its link or the address, stays marked while it is still in the top half of the window, even if it is too
// short to reach that line
(function(){
  var toc = document.querySelector('.dc-toc'); if (!toc) return;
  var links = [].slice.call(toc.querySelectorAll('a')), ind = toc.querySelector('.dc-toc-ind');
  var secs = links.map(function(a){ return document.getElementById(decodeURIComponent(a.hash.slice(1))); });
  var cur = -2, pin = -1;
  var mark = function(){
    if (!toc.offsetParent) return;
    var head = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--pg-head')) || 53, y = head + 120, on = 0;
    secs.forEach(function(s, i){ if (s && s.getBoundingClientRect().top <= y) on = i; });
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) on = secs.length - 1;
    if (pin > -1){ var t = secs[pin].getBoundingClientRect().top; if (t >= -8 && t <= innerHeight / 2) on = pin; else pin = -1; }
    if (on === cur) return; cur = on;
    links.forEach(function(a, i){ a.classList.toggle('on', i === on); if (i === on) a.setAttribute('aria-current', 'location'); else a.removeAttribute('aria-current'); });
    var a = links[on]; ind.style.transform = 'translateY(' + a.offsetTop + 'px)'; ind.style.height = a.offsetHeight + 'px'; ind.classList.add('on');
  };
  var jump = function(hash){ var i = links.findIndex(function(a){ return a.hash === hash; }); if (i > -1){ pin = i; cur = -2; } };
  links.forEach(function(a){ a.addEventListener('click', function(){ jump(a.hash); setTimeout(mark, 50); }); });
  addEventListener('hashchange', function(){ jump(location.hash); mark(); });
  jump(location.hash);
  addEventListener('scroll', mark, { passive:true });
  addEventListener('resize', function(){ cur = -2; mark(); });
  mark();
})();
</script>
