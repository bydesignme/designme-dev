---
// One component: its live demo (the same HTML, CSS and JS that npx designme add installs), how to install it, what it is
// for, how to use it in React, its props, its code, questions, and the components beside it. Every section opens with
// the homepage's section header, and a bar of links to them sticks under the header as you scroll.
import Page from '../layouts/Page.astro';
import { SITE, COMPONENTS, borrows } from '../lib/data.mjs';
// the cards under More in … play their component live while they're on screen; one that tells its story with other
// components (Agent harness) keeps its picture
const full = x => COMPONENTS.find(y => y.reg === x.reg);
const live = x => !!full(x) && !borrows(full(x)).length;
const { c } = Astro.props;
const sec = c.section, copy = c.copy || {}, rx = c.react;
const agent = sec.grp === 'agent';
const title = `${c.title}: ${agent ? 'AI agent UI component' : 'free UI component'} for React and HTML | Designme.dev`;
const description = `${c.desc} Free and MIT licensed, as HTML or a typed React component, in two styles with light and dark mode.`;
const lent = borrows(c);
const others = sec.cards.filter(x => x.reg !== c.reg), shown = others.slice(0, 8);
const cmdHtml = `npx designme add ${c.reg}`, cmdReact = `npx designme add ${c.reg} --react`;
const importLine = rx ? `import { ${rx.component} } from '@/components/designme/${c.reg}/${rx.component}';` : '';
const [ha, , , , he] = c.height;
const about = copy.summary ? [['When to use it', copy.use], ['What it does', copy.features], ['Accessibility', copy.a11y]].filter(([, l]) => l && l.length) : [];
// the sections, in order: each one gets its number, its link in the bar and its header
const SECS = [
  ['install', 'Install', 'Add it to your project with the CLI.'],
  copy.summary && ['about', 'About', 'What it is for and what it does.'],
  rx && ['usage', 'Usage', 'Import it and drive it from your own state.'],
  rx && rx.props.length && ['props', 'Props', `Everything ${rx.component} takes.`],
  ['code', 'Code', 'The full source, as the CLI installs it.'],
  copy.faq && copy.faq.length && ['questions', 'Questions', 'What people ask about it.'],
  others.length && ['more', `More in ${sec.title}`, sec.about],
].filter(Boolean).map((s, i) => ({ id:s[0], name:s[1], line:s[2], n:String(i + 1).padStart(2, '0') }));
const S = Object.fromEntries(SECS.map(s => [s.id, s]));
const jsonld = [
  { '@context':'https://schema.org', '@type':'SoftwareSourceCode', name:c.title, description:copy.summary || c.desc, url:SITE + c.url,
    image:`${SITE}/components/og/${c.reg}.jpg`,
    programmingLanguage:['HTML', 'CSS', 'JavaScript', 'TypeScript'], runtimePlatform:'Web browser', license:'https://opensource.org/licenses/MIT',
    isAccessibleForFree:true, keywords:[c.title, sec.title, agent ? 'AI agent UI' : 'UI component', 'React component', 'HTML component'].join(', '),
    author:{ '@type':'Organization', name:'DesignMe', url:'https://designme.agency' },
    isPartOf:{ '@type':'WebSite', name:'Designme.dev', url:SITE + '/' } },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Library', item:SITE + '/' },
    { '@type':'ListItem', position:2, name:sec.title, item:SITE + sec.url },
    { '@type':'ListItem', position:3, name:c.title, item:SITE + c.url } ] },
  ...(copy.faq && copy.faq.length ? [{ '@context':'https://schema.org', '@type':'FAQPage', mainEntity:copy.faq.map(f => ({ '@type':'Question', name:f.q.replace(/`/g, ''), acceptedAnswer:{ '@type':'Answer', text:f.a.replace(/`/g, '') } })) }] : []),
];
// `code` in the written copy becomes <code>
const md = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const files = [
  ...(rx ? [{ name:rx.tsxPath.split('/').pop(), lang:'React', code:rx.tsx }, { name:(rx.cssPath || '').split('/').pop(), lang:'React', code:rx.css }] : []),
  { name:`${c.reg}.html`, lang:'HTML', code:c.html.html }, { name:`${c.reg}.css`, lang:'HTML', code:c.html.css }, { name:`${c.reg}.js`, lang:'HTML', code:c.html.js },
].filter(f => f.name && f.code);
const copyIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></svg>';
const lines = s => s.split('\n').length;
---
<Page title={title} description={description} path={c.url} jsonld={jsonld} image={`/components/og/${c.reg}.jpg`}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/components/assets/core.css">
    {lent.map(x => <style is:inline set:html={x.html.css} />)}
    <style is:inline set:html={c.html.css} />
    <style is:global>
      .cp-demo{position:relative;margin:28px 0 0;border-radius:14px;background:var(--pg-soft);overflow:hidden}
      .cp-anim{position:absolute;top:12px;right:12px;z-index:3;display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 11px;border:0;border-radius:999px;background:var(--pg-bg);box-shadow:inset 0 0 0 1px var(--pg-line);color:var(--pg-dim);font:500 13px/1 var(--pg-sans);cursor:pointer;transition:color .2s}
      .cp-anim:hover{color:var(--pg-fg)}
      .cp-anim svg{width:14px;height:14px}
      /* the demo keeps the tallest the component gets, so nothing below moves while it plays; the card fills that space,
         so it is on screen (and starts) as soon as the demo is */
      .pg-demo{display:grid;grid-template-columns:minmax(0,1fr);justify-items:center;padding:56px 24px;min-height:var(--h-a)}
      .pg-demo>.card{min-width:0;align-self:stretch;display:grid;place-items:center}
      /* the links to each section stick under the header, in the content's column, and so does the line under them */
      .cp-bar{position:sticky;top:var(--pg-head);z-index:40;margin-top:40px;background:var(--pg-top);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}
      .cp-bar nav{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;box-shadow:inset 0 -1px 0 var(--pg-line)}
      .cp-bar nav::-webkit-scrollbar{display:none}
      .cp-bar a{position:relative;flex:none;display:inline-flex;align-items:center;height:46px;padding:0 10px;font-size:14px;font-weight:400;color:var(--pg-dim);text-decoration:none;transition:color .2s}
      .cp-bar a:first-child{margin-left:-10px}
      .cp-bar a:hover,.cp-bar a.on{color:var(--pg-fg)}
      .cp-bar a::after{content:"";position:absolute;left:10px;right:10px;bottom:0;height:2px;border-radius:2px;background:var(--pg-fg);transform:scaleX(0);transition:transform .3s cubic-bezier(.16,1,.3,1)}
      .cp-bar a.on::after{transform:scaleX(1)}
      .cp-sec{scroll-margin-top:calc(var(--pg-head) + 48px);padding-bottom:24px}
      .cp-sec:first-child .pg-sh{padding-top:36px}
      .cp-sec h3{margin:0 0 10px}
      .cp-sec p{margin:0;max-width:72ch}
      .cp-sec .pg-sh p{max-width:none}
      .cp-sec ul{margin:0;padding-left:18px;color:var(--pg-dim)}
      .cp-sec li{margin:0 0 8px}
      .cp-sec li::marker{color:var(--pg-muted)}
      .cp-sec code{font:500 12.5px/1.4 var(--pg-mono);font-variant-ligatures:none;background:var(--pg-chip);padding:1px 5px;border-radius:5px;color:var(--pg-fg)}
      .cp-gap{margin-top:28px}
      /* install: the two commands side by side */
      .cp-two{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
      .cp-box{display:flex;flex-direction:column;gap:10px;min-width:0}
      .cp-line{display:flex;align-items:center;gap:10px;min-width:0;height:44px;padding:0 6px 0 14px;border-radius:12px;background:var(--pg-soft);box-shadow:inset 0 0 0 1px var(--pg-line)}
      .cp-line .d{color:var(--pg-muted);font:500 13px/1 var(--pg-mono)}
      .cp-line code{flex:1;min-width:0;overflow-x:auto;white-space:nowrap;font:500 13px/1 var(--pg-mono);font-variant-ligatures:none;background:none;padding:0;scrollbar-width:none}
      .cp-copy{flex:none;display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 11px;border:0;border-radius:999px;background:var(--pg-bg);color:var(--pg-fg);box-shadow:inset 0 0 0 1px var(--pg-line2);font:500 13px/1 var(--pg-sans);cursor:pointer;transition:background-color .2s}
      .cp-copy:hover{background:var(--pg-chip)}
      .cp-note{margin-top:20px!important;color:var(--pg-dim);font-size:14px}
      /* about: the summary, then When to use it, What it does and Accessibility as plain text tabs, one list at a time */
      .cp-sum{font-size:14px;line-height:1.7}
      .cp-tl{display:flex;gap:4px;margin:0 0 18px;overflow-x:auto;scrollbar-width:none;box-shadow:inset 0 -1px 0 var(--pg-line)}
      .cp-tl button:first-child{padding-left:0}
      .cp-tl button:first-child::after{left:0}
      .cp-tl button{position:relative;flex:none;height:36px;padding:0 10px;border:0;background:none;color:var(--pg-dim);font:400 14px/1 var(--pg-sans);cursor:pointer;transition:color .16s ease}
      .cp-tl button:hover,.cp-tl button[aria-selected="true"]{color:var(--pg-fg)}
      .cp-tl button::after{content:"";position:absolute;left:10px;right:10px;bottom:0;height:2px;border-radius:2px;background:var(--pg-fg);transform:scaleX(0);transition:transform .32s cubic-bezier(.16,1,.3,1)}
      .cp-tl button[aria-selected="true"]::after{transform:scaleX(1)}
      .cp-tp ul{max-width:72ch}
      /* code */
      .cp-pre{margin:0;max-height:480px;overflow:auto;padding:16px 18px;border-radius:12px;background:var(--pg-soft);box-shadow:inset 0 0 0 1px var(--pg-line);font:500 12.5px/1.65 var(--pg-mono);font-variant-ligatures:none;tab-size:2;color:var(--pg-fg)}
      .cp-pre code{background:none;padding:0;font:inherit}
      .cp-files{display:grid;gap:8px}
      details.cp-file{border-radius:12px;box-shadow:inset 0 0 0 1px var(--pg-line)}
      details.cp-file summary{display:flex;align-items:center;gap:12px;height:48px;padding:0 16px;cursor:pointer;list-style:none;font:500 13px/1 var(--pg-mono)}
      details.cp-file summary::-webkit-details-marker{display:none}
      details.cp-file summary::before{content:"";flex:none;width:6px;height:6px;border-right:1.5px solid var(--pg-muted);border-bottom:1.5px solid var(--pg-muted);transform:rotate(-45deg);transition:transform .2s}
      details.cp-file[open] summary::before{transform:rotate(45deg)}
      details.cp-file summary .l{margin-left:auto;font:13px/1 var(--pg-sans);color:var(--pg-muted)}
      details.cp-file .cp-pre{border-radius:0 0 12px 12px;box-shadow:none;border-top:1px solid var(--pg-line);max-height:560px}
      /* props */
      .cp-props{overflow-x:auto}
      .cp-props+.cp-props,.cp-props+h3{margin-top:28px}
      .cp-props table{width:100%;min-width:620px;border-collapse:collapse;font-size:14px}
      .cp-props th{text-align:left;font-weight:500;font-size:14px;color:var(--pg-muted);padding:0 12px 10px 0;border-bottom:1px solid var(--pg-line)}
      .cp-props td{padding:12px 12px 12px 0;border-bottom:1px solid var(--pg-line);vertical-align:top;color:var(--pg-dim)}
      .cp-props td:first-child{white-space:nowrap;width:1%}
      .cp-props td:nth-child(2){width:34%}
      .cp-props td:nth-child(2) code{white-space:normal;word-break:break-word;background:none;padding:0;color:var(--pg-dim)}
      .cp-props .opt{display:block;margin-top:2px;font-size:13px;color:var(--pg-muted)}
      .cp-ext{margin-top:12px!important;color:var(--pg-dim);font-size:14px}
      /* questions: one column, with room between them */
      .cp-qs{display:flex;flex-direction:column;gap:32px;max-width:72ch;margin:0}
      .cp-qs dt{margin:0 0 6px}
      .cp-qs dd{margin:0;color:var(--pg-dim)}
      .cp-all{display:inline-block;margin-top:28px;font-size:14px;font-weight:500;color:var(--pg-dim);text-decoration:none}
      .cp-all:hover{color:var(--pg-fg)}
      /* previous and next */
      .cp-pn{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:64px;padding-top:24px;border-top:1px solid var(--pg-line)}
      .cp-pn a{display:flex;flex-direction:column;gap:2px;text-decoration:none}
      .cp-pn .n{align-items:flex-end;text-align:right}
      .cp-pn a:hover .pg-t{text-decoration:underline;text-decoration-color:var(--pg-line2);text-underline-offset:3px}
      /* a live preview inside a card: the component at its own size, scaled to fit the picture's box, over the picture */
      .pg-thumb .pg-live{position:absolute;left:50%;top:50%;width:var(--vw);min-height:0;padding:0;display:block;transform:translate(-50%,-50%) scale(var(--k));pointer-events:none;opacity:0;transition:opacity .32s ease}
      .pg-thumb .pg-live.on{opacity:1}
      .pg-thumb img{transition:opacity .32s ease}
      .pg-thumb:has(.pg-live.on) img{opacity:0}
      .pg-live .hand{display:none}
      @media (max-width:900px){.cp-two{grid-template-columns:minmax(0,1fr)}}
      @media (max-width:640px){.pg-demo{padding:52px 12px 28px;min-height:var(--h-e)}.cp-bar{margin-top:28px}}
    </style>
  </Fragment>

  <div class="pg-wrap">
    <nav class="pg-crumbs" aria-label="Breadcrumb"><a href="/">Library</a><span>/</span><a href={sec.url}>{sec.title}</a></nav>
    <h1 class="pg-h1">{c.title}</h1>
    <p class="pg-lead">{c.desc} Free and MIT licensed, as HTML or a typed React component, in two styles with light and dark mode.</p>
    <div class="pg-cmd"><span class="d">$</span><span class="c">{cmdHtml}</span><button type="button" data-copy={cmdHtml} aria-label="Copy install command" set:html={copyIcon} /></div>

    <section class="cp-demo" aria-label={`${c.title} demo`}>
      <button type="button" class="cp-anim" id="cp-replay"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>Animate</button>
      <div class="pg-demo stage-inner" style={`--h-a:${ha}px;--h-e:${he}px`} set:html={c.html.html} />
    </section>
    {lent.length > 0 && <div hidden aria-hidden="true" set:html={lent.map(x => x.html.html).join('\n')} />}
  </div>

  <div class="cp-bar"><div class="pg-wrap"><nav aria-label="On this page">{SECS.map(s => <a href={`#${s.id}`}>{s.id === 'more' ? 'More' : s.name}</a>)}</nav></div></div>

  <div class="pg-wrap">
    <section class="cp-sec" id="install">
      <div class="pg-sh"><span class="n">{S.install.n}</span><h2>{S.install.name}</h2><p>{S.install.line}</p></div>
      <div class="cp-two">
        <div class="cp-box"><h3 class="pg-t">HTML, CSS and JavaScript</h3><div class="cp-line"><span class="d">$</span><code>{cmdHtml}</code><button class="cp-copy" type="button" data-copy={cmdHtml} data-label="Copy">Copy</button></div></div>
        <div class="cp-box"><h3 class="pg-t">React</h3><div class="cp-line"><span class="d">$</span><code>{cmdReact}</code><button class="cp-copy" type="button" data-copy={cmdReact} data-label="Copy">Copy</button></div></div>
      </div>
      <p class="cp-note">The CLI copies the source into your project, so you own it and can change anything. The HTML version lands in <code>./designme</code> with the shared core and a <code>demo.html</code>. The React version lands in <code>src/components/designme</code> and needs React 19; it works in Next.js, Vite and Astro.</p>
    </section>

    {S.about && <section class="cp-sec" id="about">
      <div class="pg-sh"><span class="n">{S.about.n}</span><h2>{S.about.name}</h2><p>{S.about.line}</p></div>
      <p class="cp-sum" set:html={md(copy.summary)} />
      {about.length > 0 && <div class="cp-gap">
        <div class="cp-tl" role="tablist" aria-label="About">{about.map(([h], i) => <button type="button" role="tab" id={`ab-t${i}`} aria-controls={`ab-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{h}</button>)}</div>
        {about.map(([, list], i) => <div class="cp-tp" role="tabpanel" id={`ab-p${i}`} aria-labelledby={`ab-t${i}`} hidden={i !== 0}><ul>{list.map(x => <li set:html={md(x)} />)}</ul></div>)}
      </div>}
    </section>}

    {S.usage && <section class="cp-sec" id="usage">
      <div class="pg-sh"><span class="n">{S.usage.n}</span><h2>{S.usage.name}</h2><p>{S.usage.line}</p></div>
      <div class="cp-box"><h3 class="pg-t">Import</h3><pre class="cp-pre"><code>{importLine}</code></pre></div>
      {rx.example && <div class="cp-box cp-gap"><h3 class="pg-t">Example</h3><p class="pg-d">The demo above as a React component, {lines(rx.example)} lines you can copy.</p><pre class="cp-pre"><code>{rx.example}</code></pre></div>}
    </section>}

    {S.props && <section class="cp-sec" id="props">
      <div class="pg-sh"><span class="n">{S.props.n}</span><h2>{S.props.name}</h2><p>{S.props.line}</p></div>
      {rx.props.map(iface => <>
        {rx.props.length > 1 && <h3 class="pg-t"><code>{iface.name}</code></h3>}
        {iface.doc && <p class="pg-d" style="margin-bottom:10px">{iface.doc}</p>}
        <div class="cp-props"><table>
          <thead><tr><th>Prop</th><th>Type</th><th>What it does</th></tr></thead>
          <tbody>{iface.props.map(p => <tr><td><code>{p.name}</code>{!p.optional && <span class="opt">required</span>}</td><td><code>{p.type}</code></td><td>{p.doc}</td></tr>)}</tbody>
        </table></div>
        {iface.extends && <p class="cp-ext">Also takes the props of <code>{iface.extends}</code>.</p>}
      </>)}
    </section>}

    <section class="cp-sec" id="code">
      <div class="pg-sh"><span class="n">{S.code.n}</span><h2>{S.code.name}</h2><p>{S.code.line}</p></div>
      <div class="cp-files">{files.map(f => <details class="cp-file"><summary>{f.name}<span class="l">{f.lang} · {lines(f.code)} lines</span></summary><pre class="cp-pre"><code>{f.code}</code></pre></details>)}</div>
    </section>

    {S.questions && <section class="cp-sec" id="questions">
      <div class="pg-sh"><span class="n">{S.questions.n}</span><h2>{S.questions.name}</h2><p>{S.questions.line}</p></div>
      <dl class="cp-qs">{copy.faq.map(f => <div><dt class="pg-t" set:html={md(f.q)} /><dd set:html={md(f.a)} /></div>)}</dl>
    </section>}

    {S.more && <section class="cp-sec" id="more">
      <div class="pg-sh"><span class="n">{S.more.n}</span><h2>{S.more.name}</h2><p>{S.more.line}</p></div>
      <div class="pg-cards">{shown.map(x => <div class="pg-card">
        <a class="pg-t pg-link" href={`/components/${x.reg}`}>{x.title}</a><span class="pg-d">{x.desc}</span>
        <span class="pg-thumb" data-reg={live(x) ? x.reg : undefined} data-h={full(x) ? full(x).height[0] : 420} data-wide={x.wide ? '1' : undefined}><img class="lt" src={`/components/thumbs/${x.reg}-light.webp`} alt="" width="640" height="400" loading="lazy" decoding="async"><img class="dk" src={`/components/thumbs/${x.reg}-dark.webp`} alt="" width="640" height="400" loading="lazy" decoding="async"></span>
      </div>)}</div>
      {others.length > shown.length && <a class="cp-all" href={sec.url}>All {sec.cards.length} in {sec.title} →</a>}
    </section>}

    <nav class="cp-pn" aria-label="Previous and next component">
      <a href={c.prev.url} rel="prev"><span class="pg-d">Previous</span><span class="pg-t">{c.prev.title}</span></a>
      <a href={c.next.url} rel="next" class="n"><span class="pg-d">Next</span><span class="pg-t">{c.next.title}</span></a>
    </nav>
  </div>

  <Fragment slot="end">
    <script is:inline src="/components/assets/core.js"></script>
    {lent.map(x => <script is:inline set:html={x.html.js} />)}
    <script is:inline set:html={c.html.js} />
    <script is:inline>
    (function(){
      var card = document.querySelector('.pg-demo > .card[data-c]');
      var replay = function(){ if (card && typeof DM !== 'undefined') DM.mount(card); };
      document.getElementById('cp-replay').addEventListener('click', replay);
      // a new style starts the demo again
      document.addEventListener('pg-style', replay);
      // the link of the section on screen is marked in the bar
      var links = [].slice.call(document.querySelectorAll('.cp-bar a')), secs = links.map(function(a){ return document.querySelector(a.getAttribute('href')); });
      var mark = function(){
        var y = (parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--pg-head')) || 61) + 120, on = -1;
        secs.forEach(function(s, i){ if (s && s.getBoundingClientRect().top <= y) on = i; });
        if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) on = secs.length - 1;
        links.forEach(function(a, i){ a.classList.toggle('on', i === on); });
        var cur = links[on]; if (cur && cur.dataset.seen !== '1'){ links.forEach(function(a){ a.dataset.seen = ''; }); cur.dataset.seen = '1'; var nav = cur.parentNode; if (cur.offsetLeft < nav.scrollLeft || cur.offsetLeft + cur.offsetWidth > nav.scrollLeft + nav.clientWidth) nav.scrollTo({ left:cur.offsetLeft - 16, behavior:'smooth' }); }
      };
      addEventListener('scroll', mark, { passive:true }); addEventListener('resize', mark); mark();
      // the cards under More in …: each plays its component, scaled into its picture, while it's on screen, and stops when it
      // leaves. The component's files come from the registry (/r/<name>.json), once each
      var REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches, got = {};
      var files = function(reg){ return got[reg] || (got[reg] = fetch('/r/' + reg + '.json').then(function(r){ return r.json(); }).then(function(d){
        var f = function(ext){ var x = d.files.filter(function(x){ return x.path.slice(-ext.length) === ext; })[0]; return x ? x.content : ''; };
        var st = document.createElement('style'); st.textContent = f('.css'); document.head.appendChild(st);
        var sc = document.createElement('script'); sc.textContent = f('.js'); document.body.appendChild(sc);
        return f('.html');
      })); };
      var fit = function(t){ var box = t.querySelector('.pg-live'); if (!box) return; var vw = t.dataset.wide ? 920 : 560, h = +t.dataset.h || 420;
