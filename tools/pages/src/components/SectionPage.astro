---
// One section of components, like Agent status: what it covers, every component in it as a card with its picture, and
// the other sections.
import Page from '../layouts/Page.astro';
import { SITE, SECTIONS } from '../lib/data.mjs';
const { s } = Astro.props;
const title = `${s.title}: ${s.cards.length} ${s.grp === 'agent' ? 'AI agent UI components' : 'UI components'} for React and HTML | Designme.dev`;
const description = `${s.about} ${s.cards.length} free, MIT-licensed components, as HTML or typed React, in two styles with light and dark mode.`;
const jsonld = [
  { '@context':'https://schema.org', '@type':'CollectionPage', name:s.title, description:s.about, url:SITE + s.url,
    mainEntity:{ '@type':'ItemList', itemListElement:s.cards.map((c, i) => ({ '@type':'ListItem', position:i + 1, name:c.title, url:`${SITE}/components/${c.reg}` })) } },
  { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[
    { '@type':'ListItem', position:1, name:'Components', item:SITE + '/components' }, { '@type':'ListItem', position:2, name:s.title, item:SITE + s.url } ] },
];
const others = SECTIONS.filter(x => x !== s);
const no = n => String(n).padStart(2, '0');
---
<Page title={title} description={description} path={s.url} jsonld={jsonld} image={`/components/og/${s.cards[0].reg}.jpg`}>
  <Fragment slot="head"><style is:global>
    .sp-rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:40px;border-top:1px solid var(--pg-line)}
    .sp-rows a{display:flex;align-items:baseline;gap:12px;padding:14px 0;border-bottom:1px solid var(--pg-line);text-decoration:none}
    .sp-rows a:hover .pg-t{text-decoration:underline;text-decoration-color:var(--pg-line2);text-underline-offset:3px}
    .sp-rows .pg-d{margin-left:auto}
    @media (max-width:760px){.sp-rows{grid-template-columns:minmax(0,1fr)}}
  </style></Fragment>
  <div class="pg-wrap">
    <nav class="pg-crumbs" aria-label="Breadcrumb"><a href="/components">Components</a><span>/</span><span>{s.set}</span></nav>
    <h1 class="pg-h1">{s.title}</h1>
    <p class="pg-lead">{s.about} {s.cards.length === 1 ? 'One component' : `${s.cards.length} components`}, each as plain HTML, CSS and JavaScript or as a typed React component, in two styles with light and dark mode.</p>

    <section>
      <div class="pg-sh"><span class="n">{no(SECTIONS.indexOf(s) + 1)}</span><h2>{s.title}</h2><p>{s.cards.length === 1 ? '1 component' : `${s.cards.length} components`}</p></div>
      <div class="pg-cards">{s.cards.map(x => <a class="pg-card" href={`/components/${x.reg}`}>
        <span class="pg-t">{x.title}</span><span class="pg-d">{x.desc}</span>
        <span class="pg-thumb"><img class="lt" src={`/components/thumbs/${x.reg}-light.webp`} alt="" width="640" height="400" loading="lazy" decoding="async"><img class="dk" src={`/components/thumbs/${x.reg}-dark.webp`} alt="" width="640" height="400" loading="lazy" decoding="async"></span>
      </a>)}</div>
    </section>

    <section>
      <div class="pg-sh" style="margin-top:32px"><h2>Other sections</h2><p>{others.length} more, {others.reduce((n, x) => n + x.cards.length, 0)} components.</p></div>
      <div class="sp-rows">{others.map(x => <a href={x.url}><span class="pg-t">{x.title}</span><span class="pg-d">{x.cards.length}</span></a>)}</div>
    </section>
  </div>
</Page>
