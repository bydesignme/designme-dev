---
// The site's navigation, as the homepage's sidebar has it: Library, Docs, Changelog, Roadmap and FAQ, with the homepage's
// icons, then (in the sidebar) every component group. The page you're on is marked the same way everywhere: the section it
// belongs to in medium text, and the page itself with a light fill and a short segment on the rail its list hangs from.
// Docs opens into its pages on a docs page; a component's group opens on its page. `groups` is 'all' in the sidebar, and
// 'current' in the menu that replaces it on smaller screens (the current component's group only)
import { SECTIONS, SETS, icon } from '../lib/data.mjs';
import { DOCS } from '../lib/docs.mjs';
const { doc = null, reg = null, groups = 'all' } = Astro.props;
const curSec = reg ? SECTIONS.find(s => s.cards.some(c => c.reg === reg)) : null;
const pages = [
  { href:'/', label:'Library', ic:'dashboard', on:!!reg },
  { href:'/docs/introduction', label:'Docs', ic:'description', on:!!doc },
  { href:'/#/changelog', label:'Changelog', ic:'history' },
  { href:'/#/roadmap', label:'Roadmap', ic:'trending_up' },
  { href:'/#/faq', label:'FAQ', ic:'help' },
];
const sets = Object.keys(SETS).map(g => ({ g, name:SETS[g], secs:SECTIONS.filter(s => s.grp === g && (groups === 'all' || s === curSec)) })).filter(s => s.secs.length);
const chev = icon('expand_more');
---
<nav class="dc-pages" aria-label="Site">
  {pages.map(p => <>
    <a class:list={['dc-p', { on:p.on }]} href={p.href} data-p={p.ic}><span class="dc-ic" set:html={icon(p.ic)} />{p.label}</a>
    {p.ic === 'description' && doc && <div class="dc-ul">{DOCS.map(x => <a href={x.url} aria-current={x.slug === doc ? 'page' : undefined}>{x.title}</a>)}</div>}
  </>)}
</nav>
{sets.map(s => <>
  <div class="dc-lbl">{s.name}</div>
  {s.secs.map(sec => groups === 'all' ? <details class="dc-grp" open={sec === curSec}>
    <summary><span class="dc-chev" set:html={chev} /><span class="nm">{sec.title}</span><span class="dc-n">{sec.cards.length}</span></summary>
    <nav class="dc-ul" aria-label={sec.title}>{sec.cards.map(c => <a href={`/components/${c.reg}`} aria-current={c.reg === reg ? 'page' : undefined}>{c.title}</a>)}</nav>
  </details> : <div class="dc-grp dc-grp-only">
    <div class="dc-grp-h"><span class="nm">{sec.title}</span><span class="dc-n">{sec.cards.length}</span></div>
    <nav class="dc-ul" aria-label={sec.title}>{sec.cards.map(c => <a href={`/components/${c.reg}`} aria-current={c.reg === reg ? 'page' : undefined}>{c.title}</a>)}</nav>
  </div>)}
</>)}
