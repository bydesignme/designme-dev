---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Automation canvas: A trigger, a few agent steps, and a run you can watch flow through.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change automation-canvas.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './automation-canvas.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="automation-canvas" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="acx" data-reveal="flat">
  <div class="acx-top"><span class="acx-name">Weekly design QA</span><span class="tag ok acx-on">On</span></div>
  <div class="acx-cv" tabindex="0" role="group" aria-roledescription="canvas" aria-label="Automation canvas">
    <div class="acx-vp"><div class="acx-world"><svg class="acx-svg" aria-hidden="true"></svg><div class="acx-nodes"></div></div><div class="acx-mq" hidden></div></div>
    <div class="acx-bar"><button class="pill primary sm acx-run"><svg class="i xs"><use href="#i-play"/></svg>Test run</button><span class="muted acx-st">Every Monday, 9:00</span></div>
    <div class="acx-zm" role="toolbar" aria-label="Zoom">
      <button class="acx-zb acx-zo" aria-label="Zoom out" data-tip="Zoom out" data-tip-k="−"><svg class="i s"><use href="#i-minus"/></svg></button>
      <button class="acx-zl num" aria-label="Zoom 100%, reset to 100%" data-tip="Zoom to 100%">100%</button>
      <button class="acx-zb acx-zi" aria-label="Zoom in" data-tip="Zoom in" data-tip-k="+"><svg class="i s"><use href="#i-plus"/></svg></button>
      <span class="acx-zs"></span>
      <button class="acx-zb acx-fit" aria-label="Fit to screen" data-tip="Fit to screen" data-tip-k="0"><svg class="i s"><use href="#i-fit"/></svg></button>
    </div>
    <span class="acx-sr">Drag the empty canvas or scroll to move around, and Control or Command with the scroll wheel, or a pinch, to zoom. With the canvas focused the arrow keys move the view, plus and minus zoom, and 0 or 1 fits it. Shift-click a step to add it to the selection, and Escape clears it.</span>
    <div class="pop acx-pop" role="dialog"></div>
    <div class="pop acx-pk" role="dialog" aria-label="Add a step">
      <div class="acx-q"><svg class="i xs"><use href="#i-search"/></svg><input class="acx-qi" type="text" role="combobox" aria-expanded="true" aria-autocomplete="list" placeholder="Search steps" aria-label="Search steps" autocomplete="off" spellcheck="false"></div>
      <div class="acx-ls" role="listbox" aria-label="Steps"></div>
      <p class="acx-pd" aria-hidden="true"></p>
    </div>
  </div>
  <p class="acx-live" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './automation-canvas.js';
</script>
