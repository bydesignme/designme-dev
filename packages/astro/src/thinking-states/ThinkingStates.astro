---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Thinking states: Six thinking indicators to pick from, each with a status line.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change thinking-states.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './thinking-states.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', 'bare', className]} data-c="thinking-states" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ths-dm dm"><div class="dm-main">
  <div class="ths" data-v="orbit">
    <div class="ths-row">
      <span class="ths-mk" aria-hidden="true"></span>
      <span class="ths-l" aria-hidden="true"><span class="ths-tx shim">Thinking</span><span class="ths-car" hidden></span></span>
      <span class="ths-t num" aria-hidden="true">0s</span>
    </div>
    <span class="ths-sr" role="status" aria-live="polite">Thinking</span>
  </div>
  </div>
  <div class="demo"><div class="seg2" role="group" aria-label="Thinking state"><button aria-pressed="true" data-v="orbit">Orbit</button><button aria-pressed="false" data-v="morph">Morph</button><button aria-pressed="false" data-v="scan">Scan</button><button aria-pressed="false" data-v="stream">Stream</button><button aria-pressed="false" data-v="matrix">Matrix</button><button aria-pressed="false" data-v="stack">Stack</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './thinking-states.js';
</script>
