---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Reactions: Quick reactions on an agent update, with counts that pop.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change reactions.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './reactions.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="reactions" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rxx">
  <div class="rxx-m"><span class="rxx-ic"><svg class="i xs"><use href="#i-spark"/></svg></span><div class="rxx-b"><span class="rxx-n"><b>Design agent</b><span class="muted">10:42</span></span><p>Shipped the pricing update to staging. Trial to paid preview is up 8.1 points against last month.</p></div></div>
  <div class="rxx-row"><div class="rxx-list"></div><button class="rxx-add" data-pop=".rxx-pk" aria-label="Add reaction" data-tip="Add reaction"><svg class="i xs"><use href="#i-smile"/></svg></button></div>
  <div class="pop rxx-pk" role="menu"><div class="rxx-grid"></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './reactions.js';
</script>
