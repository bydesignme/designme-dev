---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Proposal card: A suggested change with confidence, alternatives and undo.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change proposal-card.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './proposal-card.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="proposal-card" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="prx">
  <div class="prx-h"><span class="prx-ic"><svg class="i s"><use href="#i-wand"/></svg></span><div class="prx-ht"><b>Raise contrast on the secondary button</b><span class="muted">Pricing, frame 2 of 3</span></div></div>
  <div class="prx-diff"><div class="prx-sw"><span class="prx-c" style="background:#c9cfd8"></span><span class="num">#C9CFD8</span><span class="tag bad">2.1 : 1</span></div><span class="prx-ar"><svg class="i xs"><use href="#i-right"/></svg></span><div class="prx-sw prx-new"><span class="prx-c" style="background:#5b6472"></span><span class="num">#5B6472</span><span class="tag ok"><span class="prx-rt">5.9 : 1</span></span></div></div>
  <div class="prx-cf"><span class="muted">Confidence</span><div class="prx-seg"><i></i><i></i><i></i><i></i><i></i></div><span class="num prx-pc">0%</span></div>
  <button class="prx-alt-t"><svg class="i xs"><use href="#i-chev-r"/></svg><span>2 other options</span></button>
  <div class="fold shut prx-alt"><div><div class="prx-alts"></div></div></div>
  <div class="prx-f"><button class="pill ghost sm prx-no">Not now</button><button class="pill primary sm prx-ok">Accept</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './proposal-card.js';
</script>
