---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Plan review: Check the agent's plan, edit steps, then let it run.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change plan-review.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './plan-review.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="plan-review" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="plx">
  <div class="plx-h"><span class="think plx-mk"><i></i><i></i><i></i><i></i></span><div class="plx-ht"><b>Plan: redesign the pricing page</b><span class="muted plx-st">5 steps, about 4 min</span></div><span class="plx-tm num" aria-label="Elapsed"></span></div>
  <ol class="plx-list"></ol>
  <button class="plx-add"><svg class="i xs"><use href="#i-plus"/></svg>Add a step</button>
  <div class="plx-f"><span class="muted plx-n">Click a step to edit it</span><button class="pill ghost sm plx-chg">Ask for changes</button><button class="pill primary sm plx-go">Approve plan</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './plan-review.js';
</script>
