---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// File explorer: Project files, with the ones the agent touched marked.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change file-explorer.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './file-explorer.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="file-explorer" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="fxp panel" data-reveal="flat">
  <div class="fxp-h"><div class="fxp-s"><svg class="i xs"><use href="#i-search"/></svg><input placeholder="Filter files" aria-label="Filter files" spellcheck="false"></div><button class="ib fxp-ch" aria-label="Only changed" data-tip="Only changed files"><svg class="i xs"><use href="#i-filter"/></svg></button></div>
  <div class="fxp-tree" role="tree"></div>
  <div class="fxp-f muted"><span class="fxp-st"></span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './file-explorer.js';
</script>
