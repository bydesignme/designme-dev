---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Steering: Change the agent's course while it works, without starting over.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change steering.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './steering.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="steering" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ste panel">
  <div class="ste-h"><b>Redesign the pricing page</b><span class="muted ste-st"><span class="m" aria-live="polite">Step 2 of 4</span> · <span class="num ck">0:00</span></span></div>
  <ol class="ste-steps" aria-label="Steps"></ol>
  <div class="ste-log" aria-live="polite"></div>
  <form class="ste-box"><input placeholder="Steer the agent while it works" aria-label="Message the agent" spellcheck="false" autocomplete="off"><button class="ste-go" aria-label="Send" disabled><svg class="i xs"><use href="#i-up"/></svg></button></form>
</div>
  </Fragment></div>
</div>
<script>
  import './steering.js';
</script>
