---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Web search: The agent's searches as a trail: what it asked, what came back, what it read or skipped, and the answer with its sources.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change web-search.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './web-search.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="web-search" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="wsx panel">
  <button class="wsx-h" aria-expanded="true"><span class="wsx-ic"><span class="spin"></span></span><span class="wsx-st shim">Searching the web</span><span class="wsx-marks" aria-hidden="true"></span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
  <div class="fold wsx-fold"><div><div class="wsx-list"></div></div></div>
  <div class="wsx-ans"></div>
  <p class="wsx-sr" role="status"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './web-search.js';
</script>
