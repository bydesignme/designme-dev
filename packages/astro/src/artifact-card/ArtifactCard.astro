---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Artifact card: A file the agent made, with its versions, Open, Copy and Download.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change artifact-card.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './artifact-card.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="artifact-card" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="afx dm">
  <div class="dm-main afx-main"></div>
  <div class="demo"><div class="seg2" role="group" aria-label="Variant"><button aria-pressed="true" data-v="compact">Compact</button><button aria-pressed="false" data-v="preview">Preview</button><button aria-pressed="false" data-v="inline">Inline</button><button aria-pressed="false" data-v="stack">Stack</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './artifact-card.js';
</script>
