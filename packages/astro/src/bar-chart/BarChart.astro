---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Bar chart: Weekly agent runs, split by outcome, with a range switch.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change bar-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './bar-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="bar-chart" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="bcx panel">
  <div class="bcx-h"><div><span class="muted">Agent runs</span><b class="num bcx-v">0</b></div><div class="seg2 bcx-rg" role="group" aria-label="Range"><button aria-pressed="true" data-v="w">Week</button><button aria-pressed="false" data-v="m">Month</button></div></div>
  <div class="bcx-ch"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './bar-chart.js';
</script>
