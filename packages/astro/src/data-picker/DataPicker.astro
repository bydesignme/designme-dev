---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Data picker: Map a field from earlier steps into a step's input.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change data-picker.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './data-picker.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="data-picker" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="fpk">
  <div class="fpk-hd"><span class="fpk-ti" data-k="app" aria-hidden="true"><svg class="i s"><use href="#i-mail"/></svg></span><b>Send the reply</b><span class="muted">Step 6 of 7</span></div>
  <div class="fpk-f" data-f="to"><span class="fpk-l">To</span><div class="fpk-box" role="group" aria-label="To"></div></div>
  <div class="fpk-f" data-f="subject"><span class="fpk-l">Subject</span><div class="fpk-box" role="group" aria-label="Subject"></div></div>
  <div class="fpk-f" data-f="body"><span class="fpk-l">Body</span><div class="fpk-box" role="group" aria-label="Body"></div></div>
  <div class="pop fpk-pop" role="dialog" aria-label="Pick data from an earlier step">
    <div class="fpk-q"><svg class="i s"><use href="#i-search"/></svg><input type="text" role="combobox" aria-expanded="true" aria-autocomplete="list" placeholder="Find a field" aria-label="Find a field" autocomplete="off" spellcheck="false"></div>
    <div class="fpk-ls" role="listbox" aria-label="Fields from earlier steps"></div>
    <p class="fpk-ft"><span>From the 4 steps before Send the reply</span><span class="kh" aria-hidden="true"><span class="kbd">↑</span> <span class="kbd">↓</span> <span class="kbd">↵</span></span></p>
  </div>
  <p class="fpk-live" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './data-picker.js';
</script>
