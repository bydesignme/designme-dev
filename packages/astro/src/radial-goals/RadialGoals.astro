---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Radial goals: Each agent's share of its own target as a ring, with the overall score in the middle.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change radial-goals.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './radial-goals.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="radial-goals" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rgx panel">
  <div class="rgx-h">
    <div class="rgx-t"><b>Agent goals</b><span class="muted rgx-sub">This week</span></div>
    <div class="seg2 rgx-sg" role="group" aria-label="Range"><button aria-pressed="true" data-v="w">Week</button><button aria-pressed="false" data-v="m">Month</button></div>
  </div>
  <div class="rgx-b">
    <div class="rgx-ring"><svg viewBox="0 0 180 180" aria-hidden="true"></svg><div class="rgx-c"><b class="num">0%</b><span class="muted">of targets</span></div></div>
    <div class="rgx-lg"></div>
  </div>
  <div class="rgx-sr"><table><caption>Agent goals</caption><thead><tr><th>Agent</th><th>Done</th><th>Target</th><th>Share</th></tr></thead><tbody></tbody></table></div>
</div>
  </Fragment></div>
</div>
<script>
  import './radial-goals.js';
</script>
