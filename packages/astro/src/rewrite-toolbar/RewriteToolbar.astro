---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Rewrite toolbar: Select a sentence and let the agent rewrite it in place.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change rewrite-toolbar.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './rewrite-toolbar.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="rewrite-toolbar" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rwx panel">
  <div class="rwx-h"><span class="ft">DOC</span><span>Onboarding intro</span><span class="muted rwx-st">Click a sentence</span></div>
  <div class="rwx-doc"></div>
  <div class="rwx-tb" role="toolbar" aria-label="Rewrite">
    <button class="rwx-b" data-k="clear"><svg class="i xs"><use href="#i-spark"/></svg>Clearer</button><button class="rwx-b" data-k="short">Shorter</button><button class="rwx-b" data-k="warm">Friendlier</button><span class="rwx-sep"></span><button class="rwx-b ic" aria-label="Ask the agent" data-tip="Ask the agent" data-tip-k="⌘K"><svg class="i xs"><use href="#i-wand"/></svg></button>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './rewrite-toolbar.js';
</script>
