---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Field extraction: The agent pulls fields out of a document and shows where each came from.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change field-extraction.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './field-extraction.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="field-extraction" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="fex">
  <div class="fex-doc">
    <div class="fex-pg">
      <div class="fex-top"><b>Northwind Studio</b><span class="muted">Invoice</span></div>
      <div class="fex-z" data-z="no"><span class="muted">Invoice no.</span> <span class="num">NW-2041</span></div>
      <div class="fex-z" data-z="date"><span class="muted">Issued</span> <span class="num">3 Oct 2026</span></div>
      <div class="fex-tb">
        <div class="fex-li"><span>Design system audit</span><span class="num">$4,800.00</span></div>
        <div class="fex-li"><span>Pricing page redesign</span><span class="num">$6,200.00</span></div>
        <div class="fex-li"><span>Agent setup, 2 seats</span><span class="num">$480.00</span></div>
      </div>
      <div class="fex-z fex-tot" data-z="total"><span>Total due</span><span class="num">$11,480.00</span></div>
      <div class="fex-z fex-smudge" data-z="due"><span class="muted">Due by</span> <span class="num">1? Nov 2026</span></div>
    </div>
  </div>
  <div class="fex-side panel">
    <div class="fex-sh"><b>Extracted fields</b><span class="muted fex-st">Reading page 1</span></div>
    <div class="fex-list"></div>
    <div class="fex-f"><button class="pill primary sm fex-go" disabled>Send to Sheets</button></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './field-extraction.js';
</script>
