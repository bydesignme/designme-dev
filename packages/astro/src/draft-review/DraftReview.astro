---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Draft review: An email the agent drafted, to check and edit before it sends.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change draft-review.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './draft-review.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="draft-review" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="drf panel">
  <div class="drf-h"><span class="drf-ag"><svg class="i s"><use href="#i-spark"/></svg></span><div class="drf-ht"><b>Draft from the agent</b><span class="muted">After the pricing review with Maya</span></div><span class="tag drf-tag">Not sent</span></div>
  <div class="drf-fs">
    <div class="drf-r"><span class="drf-l">To</span><span class="drf-p"><span class="av" style="background:var(--dm-av-l);color:var(--dm-av-l-ink)">MK</span>Maya Kim</span></div>
    <label class="drf-r"><span class="drf-l">Subject</span><input class="drf-s" value="Pricing v4: what changed" aria-label="Subject"></label>
  </div>
  <div class="drf-b" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Message" spellcheck="false">Hi Maya,<br><br>Here's what changed on the pricing page: one button per plan, the yearly price first, and the FAQ under the comparison table. The full list is in the attached summary.<br><br>Ready for your sign-off when you are.</div>
  <div class="drf-att"></div>
  <div class="fold shut drf-wf"><div><div class="drf-w"><p><svg class="i xs"><use href="#i-alert"/></svg><span>You mention an attachment, but nothing is attached.</span></p><div class="drf-wa"><button class="pill ghost sm drf-any">Send anyway</button><button class="pill primary sm drf-at"><svg class="i xs"><use href="#i-clip"/></svg>Attach the summary</button></div></div></div></div>
  <div class="drf-f">
    <button class="pill ghost sm drf-x"><svg class="i xs"><use href="#i-trash"/></svg>Discard</button><span class="sp"></span><span class="muted drf-when"></span>
    <div class="drf-mg"><button class="pill primary sm drf-go"><svg class="i xs"><use href="#i-send"/></svg>Send</button><button class="pill primary sm drf-dd" aria-label="When to send" aria-haspopup="menu" aria-expanded="false" data-pop=".drf-pop" data-pop-align="end"><svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
  </div>
  <div class="pop drf-pop" role="menu" aria-label="When to send">
    <button class="mi" role="menuitemradio" aria-checked="true" data-close data-w="now"><span>Send now</span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-w="Tomorrow at 09:00"><span>Tomorrow at 09:00<span class="d">The start of Maya's day</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-w="Monday at 09:00"><span>Monday at 09:00<span class="d">The start of next week</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './draft-review.js';
</script>
