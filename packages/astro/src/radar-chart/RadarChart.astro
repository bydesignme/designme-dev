---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Eval radar: This run against the baseline on six eval scores, with the weak ones flagged.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change radar-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './radar-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="radar-chart" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rdx panel">
  <div class="rdx-h">
    <div class="rdx-t"><b>Eval scores</b><span class="muted">Run 48 against run 41</span></div>
    <div class="rdx-lg"><button class="rdx-k" aria-pressed="true" data-s="cur"><i class="c"></i>This run</button><button class="rdx-k" aria-pressed="true" data-s="base"><i class="b"></i>Baseline</button></div>
  </div>
  <div class="rdx-ch" role="group" aria-label="Scores by axis. Left and Right move between axes">
    <svg class="rdx-svg" aria-hidden="true"></svg>
    <span class="rdx-avg num"><b>0</b><span class="muted">average</span></span>
  </div>
  <div class="rdx-ro" aria-live="polite"><span></span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './radar-chart.js';
</script>
