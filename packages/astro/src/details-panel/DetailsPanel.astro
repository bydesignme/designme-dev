---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Details panel: Properties of a run you can change in place.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change details-panel.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './details-panel.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="details-panel" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="dtp panel">
  <div class="dtp-h"><span class="ft">RUN</span><b>Pricing page redesign</b><button class="ib dtp-cp" aria-label="Copy run ID" data-tip="Copy run ID"><svg class="i xs"><use href="#i-link"/></svg></button></div>
  <div class="dtp-sec">
    <button class="dtp-sh" aria-expanded="true"><svg class="i xs"><use href="#i-chev-r"/></svg><span>Properties</span></button>
    <div class="fold dtp-f1"><div><div class="dtp-rows">
      <div class="dtp-r"><span class="k">Status</span><button class="dtp-v dtp-stat" data-pop=".dtp-pst"><span class="dot" style="color:var(--dm-accent-mark,var(--dm-accent))"></span><span>In review</span></button>
        <div class="pop dtp-pst" role="menu"><button class="mi" role="menuitem" data-close data-s="In progress" data-col="var(--dm-py)"><span class="dot" style="color:var(--dm-py)"></span><span>In progress</span></button><button class="mi" role="menuitem" data-close data-s="In review" data-col="var(--dm-accent-mark,var(--dm-accent))"><span class="dot" style="color:var(--dm-accent-mark,var(--dm-accent))"></span><span>In review</span></button><button class="mi" role="menuitem" data-close data-s="Shipped" data-col="var(--dm-ok)"><span class="dot" style="color:var(--dm-ok)"></span><span>Shipped</span></button></div></div>
      <div class="dtp-r"><span class="k">Owner</span><button class="dtp-v dtp-own" data-pop=".dtp-pow"><span class="av" style="background:var(--dm-av-l);color:var(--dm-av-l-ink)">MK</span><span>Maya Kim</span></button>
        <div class="pop dtp-pow" role="menu"><button class="mi" role="menuitem" data-close data-o="Maya Kim" data-i="MK" data-col="var(--dm-av-l)"><span class="av" style="background:var(--dm-av-l);color:var(--dm-av-l-ink)">MK</span><span>Maya Kim</span></button><button class="mi" role="menuitem" data-close data-o="Jon Ortiz" data-i="JO" data-col="var(--dm-av-m)"><span class="av" style="background:var(--dm-av-m);color:var(--dm-av-m-ink)">JO</span><span>Jon Ortiz</span></button><button class="mi" role="menuitem" data-close data-o="Design agent" data-i="DA" data-col="var(--dm-av-b)"><span class="av" style="background:var(--dm-av-b);color:var(--dm-av-b-ink)">DA</span><span>Design agent</span></button></div></div>
      <div class="dtp-r"><span class="k">Model</span><button class="dtp-v" data-pop=".dtp-pmo"><span class="dtp-mo">Opus</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
        <div class="pop dtp-pmo" role="menu"><button class="mi" role="menuitem" data-close data-m="Opus"><span>Opus<span class="d">Best for design</span></span></button><button class="mi" role="menuitem" data-close data-m="Sonnet"><span>Sonnet<span class="d">Faster, cheaper</span></span></button><button class="mi" role="menuitem" data-close data-m="Haiku"><span>Haiku<span class="d">Quick edits</span></span></button></div></div>
      <div class="dtp-r"><span class="k">Due</span><span class="dtp-v num">Oct 24</span></div>
      <div class="dtp-r"><span class="k">Labels</span><span class="dtp-tags"><span class="tag b">Pricing</span><span class="tag p">Web</span><button class="dtp-add" aria-label="Add label" data-tip="Add label"><svg class="i xs"><use href="#i-plus"/></svg></button></span></div>
    </div></div></div>
  </div>
  <div class="dtp-sec">
    <button class="dtp-sh" aria-expanded="true"><svg class="i xs"><use href="#i-chev-r"/></svg><span>Usage</span></button>
    <div class="fold dtp-f2"><div><div class="dtp-rows">
      <div class="dtp-r"><span class="k">Tokens</span><span class="dtp-v num dtp-tok">0</span></div>
      <div class="dtp-r"><span class="k">Cost</span><span class="dtp-v num dtp-cost">$0.00</span></div>
      <div class="dtp-r"><span class="k">Run time</span><span class="dtp-v num">4m 12s</span></div>
    </div></div></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './details-panel.js';
</script>
