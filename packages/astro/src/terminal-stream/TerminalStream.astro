---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Terminal stream: Shell commands the agent runs, with their output as it streams in.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change terminal-stream.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './terminal-stream.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="terminal-stream" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tmx panel" data-reveal="flat">
  <div class="tmx-h"><span class="tmx-ic"><svg class="i s"><use href="#i-term"/></svg></span><span class="tmx-cwd">~/acme/web</span><span class="tmx-st"><span class="g"><span class="spin"></span></span><span class="tmx-sv num">Starting</span></span><span class="sp"></span><button class="pill ghost sm tmx-stop" aria-label="Stop the running command"><svg class="i xs"><use href="#i-stop"/></svg>Stop</button><button class="ib tmx-cp" aria-label="Copy the output" data-tip="Copy"><svg class="i s"><use href="#i-copy"/></svg></button></div>
  <div class="tmx-body" role="log" aria-label="Terminal output" tabindex="0"></div>
  <div class="fold shut tmx-ff"><div><div class="tmx-f"><span class="g"></span><span class="tmx-fs num"></span></div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './terminal-stream.js';
</script>
