---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Change review: Accept or reject each change the agent made, file by file.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change change-review.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './change-review.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="change-review" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="crx panel">
  <div class="crx-side">
    <div class="crx-sh"><b>3 files changed</b><span class="muted crx-tot num"></span></div>
    <div class="crx-files"></div>
  </div>
  <div class="crx-main">
    <div class="crx-mh"><span class="crx-fn num"></span><span class="crx-sp"></span><button class="pill ghost sm crx-rej">Undo all</button><button class="pill primary sm crx-ok">Keep all</button></div>
    <div class="crx-diff"></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './change-review.js';
</script>
