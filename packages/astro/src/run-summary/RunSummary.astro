---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Run summary: What the agent did, what changed and what needs you.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change run-summary.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './run-summary.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="run-summary" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rsu panel">
  <div class="rsu-h"><span class="rsu-g"><svg class="i s"><use href="#i-check"/></svg></span><div><div class="rsu-t">Run complete</div><div class="rsu-s muted">Finished in 12m 40s</div></div><button class="ib rsu-more" aria-label="More" data-tip="Run details"><svg class="i s"><use href="#i-more"/></svg></button></div>
  <p class="rsu-title">Pricing cards now use spacing tokens</p>
  <div class="rsu-stats">
    <span><b class="num" data-n="6">0</b> files</span>
    <span><b class="num" data-n="14">0</b> steps</span>
    <span><b class="num" data-n="182" data-u="k">0</b> tokens</span>
    <span><b class="num" data-n="0.84" data-p="$">0</b> cost</span>
  </div>
  <div class="rsu-sec"><div class="rsu-l">What changed</div>
    <div class="rsu-it"><span class="mono">PricingCard.tsx</span><span class="num"><i class="a">+24</i> <i class="x">−18</i></span></div>
    <div class="rsu-it"><span class="mono">tokens.css</span><span class="num"><i class="a">+9</i> <i class="x">−2</i></span></div>
    <div class="rsu-it"><span class="mono">Pricing.test.tsx</span><span class="num"><i class="a">+31</i> <i class="z">−0</i></span></div>
  </div>
  <div class="rsu-sec"><div class="rsu-l">Needs you</div>
    <div class="rsu-it rsu-need"><span class="dot" style="color:var(--dm-warn-mark)"></span><span class="rsu-nt">The yearly badge overlaps the price on mobile</span><button class="pill soft sm rsu-fix">Review</button></div>
  </div>
  <div class="rsu-acts"><button class="pill primary sm">Open changes</button><button class="pill ghost sm rsu-undo">Undo all</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './run-summary.js';
</script>
