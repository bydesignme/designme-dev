---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agent harness: Every component working together in one agent app.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agent-harness.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agent-harness.css';
import ActionLog from '../action-log/ActionLog.astro';
import AgentLanes from '../agent-lanes/AgentLanes.astro';
import ArtifactCard from '../artifact-card/ArtifactCard.astro';
import ChangeReview from '../change-review/ChangeReview.astro';
import Composer from '../composer/Composer.astro';
import ContextMeter from '../context-meter/ContextMeter.astro';
import DecisionPrompt from '../decision-prompt/DecisionPrompt.astro';
import ErrorRecovery from '../error-recovery/ErrorRecovery.astro';
import LiveAnswer from '../live-answer/LiveAnswer.astro';
import PermissionGate from '../permission-gate/PermissionGate.astro';
import PlanReview from '../plan-review/PlanReview.astro';
import RunSummary from '../run-summary/RunSummary.astro';
import SourceStack from '../source-stack/SourceStack.astro';
import Thinking from '../thinking/Thinking.astro';
import ToolCall from '../tool-call/ToolCall.astro';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="harness" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ahx panel">
  <aside class="ahx-side" aria-label="Chats">
    <div class="ahx-ws">
      <button class="ahx-wsb" data-pop=".ahx-wsp" aria-haspopup="menu"><span class="ahx-lg">D</span><span class="t">DesignMe Studio</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
      <button class="ib ahx-hide" aria-label="Hide chats" data-tip="Hide chats"><svg class="i s"><use href="#i-panel"/></svg></button>
    </div>
    <button class="ahx-nav ahx-new"><svg class="i s"><use href="#i-edit"/></svg><span>New chat</span></button>
    <div class="ahx-lh"><span>Chats</span><button class="ib ahx-sb" aria-label="Search chats" data-tip="Search chats"><svg class="i s"><use href="#i-search"/></svg></button></div>
    <div class="fold shut ahx-sf"><div><input class="ahx-si" type="search" placeholder="Search chats" aria-label="Search chats"></div></div>
    <div class="ahx-list"><p class="ahx-none" hidden>No chats match</p></div>
  </aside>
  <div class="ahx-main home">
    <div class="ahx-top">
      <button class="ib ahx-menu" aria-label="Show chats" data-tip="Show chats"><svg class="i s"><use href="#i-panel"/></svg></button>
      <div class="ahx-tabs" role="group" aria-label="Open chats"></div>
      <button class="ahx-tn" data-pop=".ahx-tp" data-pop-align="end" aria-haspopup="menu" aria-label="Open chats" data-tip="Open chats" hidden><span class="num">1</span></button>
      <button class="ib ahx-plus" aria-label="New chat" data-tip="New chat"><svg class="i s"><use href="#i-plus"/></svg></button>
      <div class="spl ahx-spl"><div class="spl-pill" aria-live="polite"><div class="spl-in"></div></div></div>
    </div>
    <div class="ahx-body">
      <div class="ahx-feed"><div class="ahx-cols"></div></div>
      <div class="ahx-bot"></div>
      <div class="ahx-home">
        <div class="ahx-hw">
          <div class="ahx-hi"><span>Hello</span><h4>What should the agent work on?</h4></div>
        </div>
      </div>
    </div>
  </div>
  <aside class="ahx-pane" aria-label="Artifact" aria-hidden="true"><div class="ahx-pi">
    <div class="ahx-ph"><svg class="i s"><use href="#i-file-text"/></svg><span class="t"></span><button class="ib ahx-pl" aria-label="Copy link" data-tip="Copy link"><svg class="i s"><use href="#i-link"/></svg></button><button class="ib ahx-px" aria-label="Close panel" data-tip="Close"><svg class="i s"><use href="#i-x"/></svg></button></div>
    <div class="ahx-pb"></div>
  </div></aside>
  <div class="ahx-scrim"></div>
  <div class="pop ahx-wsp" role="menu"></div>
  <div class="pop ahx-tp" role="menu" aria-label="Open chats"></div>
</div>
  </Fragment></div>
</div>
<!-- the components it tells its story with: their markup, hidden, where its script finds it -->
<div hidden aria-hidden="true">
  <ActionLog />
  <AgentLanes />
  <ArtifactCard />
  <ChangeReview />
  <Composer />
  <ContextMeter />
  <DecisionPrompt />
  <ErrorRecovery />
  <LiveAnswer />
  <PermissionGate />
  <PlanReview />
  <RunSummary />
  <SourceStack />
  <Thinking />
  <ToolCall />
</div>
<script>
  import './agent-harness.js';
</script>
