---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Canvas toolbar: A floating toolbar for a workflow canvas: run, pick a tool, comment, fit and zoom.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change canvas-toolbar.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './canvas-toolbar.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="canvas-toolbar" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ctb" data-tool="select" data-reveal="flat">
  <div class="ctb-cv" tabindex="0" role="group" aria-roledescription="canvas" aria-label="Workflow canvas" aria-describedby="">
    <div class="ctb-world"><svg class="ctb-w" aria-hidden="true"></svg><div class="ctb-nodes"></div></div>
    <svg class="ctb-lz" aria-hidden="true"><path d=""/></svg>
    <div class="ctb-mq" hidden></div>
    <span class="ctb-sr">V, H and L pick a tool, C adds a comment, Shift 1 fits the workflow to the screen, minus and plus zoom, and the arrow keys move the view.</span>
  </div>
  <div class="ctb-bar" role="toolbar" aria-label="Canvas tools">
    <button class="pill primary ctb-run"><svg class="i xs"><use href="#i-play"/></svg><span>Run</span></button>
    <span class="ctb-sep"></span>
    <div class="ctb-tools" role="radiogroup" aria-label="Tool">
      <button class="ctb-b" role="radio" aria-checked="true" data-t="select" aria-label="Select" data-tip="Select" data-tip-k="V"><svg class="i s"><use href="#i-cursor"/></svg></button>
      <button class="ctb-b" role="radio" aria-checked="false" tabindex="-1" data-t="hand" aria-label="Hand" data-tip="Pan" data-tip-k="H"><svg class="i s"><use href="#i-hand"/></svg></button>
      <button class="ctb-b" role="radio" aria-checked="false" tabindex="-1" data-t="lasso" aria-label="Lasso" data-tip="Lasso select" data-tip-k="L"><svg class="i s"><use href="#i-lasso"/></svg></button>
    </div>
    <span class="ctb-sep" data-ovf="1"></span>
    <button class="ctb-b ctb-cm" data-ovf="1" aria-pressed="false" aria-label="Comment" data-tip="Comment" data-tip-k="C"><svg class="i s"><use href="#i-comment"/></svg></button>
    <button class="ctb-b ctb-fit" data-ovf="1" aria-label="Fit to screen" data-tip="Fit to screen" data-tip-k="⇧1"><svg class="i s"><use href="#i-fit"/></svg></button>
    <span class="ctb-sep" data-ovf="2"></span>
    <button class="ctb-b ctb-zo" data-ovf="2" aria-label="Zoom out" data-tip="Zoom out" data-tip-k="−"><svg class="i s"><use href="#i-minus"/></svg></button>
    <button class="ctb-z num" data-ovf="2" aria-label="Zoom 100%, reset to 100%" data-tip="Zoom to 100%" data-tip-k="⇧0">100%</button>
    <button class="ctb-b ctb-zi" data-ovf="2" aria-label="Zoom in" data-tip="Zoom in" data-tip-k="+"><svg class="i s"><use href="#i-plus"/></svg></button>
    <button class="ctb-b ctb-more" aria-label="More tools" aria-haspopup="menu" aria-expanded="false" data-pop=".ctb-menu" data-pop-pos="up" data-pop-align="end" data-tip="More"><svg class="i s"><use href="#i-more"/></svg></button>
  </div>
  <div class="pop ctb-menu" role="menu" aria-label="More tools">
    <button class="mi" role="menuitemcheckbox" aria-checked="false" tabindex="-1" data-a="comment" data-ovf="1" data-close><svg class="i s"><use href="#i-comment"/></svg><span>Comment</span><span class="kbd">C</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="fit" data-ovf="1" data-close><svg class="i s"><use href="#i-fit"/></svg><span>Fit to screen</span><span class="kbd">⇧1</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="out" data-ovf="2"><svg class="i s"><use href="#i-minus"/></svg><span>Zoom out</span><span class="kbd">−</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="in" data-ovf="2"><svg class="i s"><use href="#i-plus"/></svg><span>Zoom in</span><span class="kbd">+</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="reset" data-ovf="2" data-close><svg class="i s"><use href="#i-search"/></svg><span>Zoom to 100%</span><span class="r num ctb-zl">100%</span></button>
  </div>
  <div class="pop ctb-cp" role="dialog" aria-label="Comment"><b class="ctb-ct"></b><p class="ctb-cw"></p><button class="pill line sm ctb-del"><svg class="i xs"><use href="#i-trash"/></svg>Delete</button></div>
  <p class="ctb-live" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './canvas-toolbar.js';
</script>
