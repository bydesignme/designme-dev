---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Knowledge sources: The files, sites and folders the agent knows, and how far each is indexed.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change knowledge-sources.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './knowledge-sources.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="knowledge-sources" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ksx panel" data-reveal="flat">
  <div class="ksx-h"><div><b>Knowledge sources</b><span class="muted ksx-st" aria-live="polite"></span></div></div>
  <div class="ksx-list" role="list" aria-label="Sources"></div>
  <button class="ksx-add" data-pop=".ksx-pop" data-pop-pos="up" aria-haspopup="menu" aria-expanded="false"><svg class="i xs"><use href="#i-plus"/></svg>Add source</button>
  <div class="pop ksx-pop" role="menu" aria-label="Add source"></div>
  <div class="pop ksx-mpop" role="menu" aria-label="Source actions"><button class="mi ksx-rs" role="menuitem" data-close><svg class="i xs"><use href="#i-refresh"/></svg>Re-sync</button><div class="sep"></div><button class="mi del ksx-rm" role="menuitem" data-close><svg class="i xs"><use href="#i-trash"/></svg>Remove</button></div>
  <input class="ksx-file" type="file" multiple hidden>
</div>
  </Fragment></div>
</div>
<script>
  import './knowledge-sources.js';
</script>
