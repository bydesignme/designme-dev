---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Knowledge sources: The files, sites and folders the agent knows, and how far each is indexed.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change knowledge-sources.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './knowledge-sources.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="knowledge-sources" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ksx panel mx-grow" data-reveal="flat">
  <div class="ksx-h"><span class="ksx-hi" aria-hidden="true"><svg class="i xs"><use href="#i-book"/></svg></span><div><b>Knowledge sources</b><span class="muted ksx-st" aria-live="polite"></span></div></div>
  <div class="ksx-list mx-glide" role="list" aria-label="Sources"></div>
  <div class="ksx-em"><span class="ksx-em-art" aria-hidden="true"></span><b>No sources yet</b><span>Add files, a website or a folder, and the agent reads them.</span><button class="pill line sm ksx-add2 mx-press" data-pop=".ksx-pop" aria-haspopup="menu" aria-expanded="false"><svg class="i xs"><use href="#i-plus"/></svg>Add source</button></div>
  <div class="ksx-ft"><button class="ksx-add mx-press" data-pop=".ksx-pop" aria-haspopup="menu" aria-expanded="false"><svg class="i xs"><use href="#i-plus"/></svg>Add source</button></div>
  <div class="pop ksx-pop mx-pop mx-rows mx-glide" role="menu" aria-label="Add source"></div>
  <div class="pop ksx-mpop mx-pop mx-rows mx-glide" role="menu" aria-label="Source actions"><button class="mi ksx-rs mx-press" role="menuitem" data-close><svg class="i xs"><use href="#i-refresh"/></svg>Re-sync</button><div class="sep"></div><button class="mi del ksx-rm mx-press" role="menuitem" data-close><svg class="i xs"><use href="#i-trash"/></svg>Remove</button></div>
  <input class="ksx-file" type="file" multiple hidden>
</div>
  </Fragment></div>
</div>
<script>
  import './knowledge-sources.js';
</script>
