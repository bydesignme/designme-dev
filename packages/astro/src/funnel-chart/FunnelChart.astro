---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Funnel chart: Signup to paid, with the biggest drop called out by the agent.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change funnel-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './funnel-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="funnel" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="fnx panel">
  <div class="fnx-h"><b>Signup to paid</b><div class="seg2 fnx-sg" role="group" aria-label="Segment"><button aria-pressed="true" data-v="all">All</button><button aria-pressed="false" data-v="team">Teams</button><button aria-pressed="false" data-v="solo">Solo</button></div></div>
  <div class="fnx-rows"></div>
  <div class="fnx-ins"><span class="fnx-ic"><svg class="i xs"><use href="#i-spark"/></svg></span><span class="fnx-t"></span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './funnel-chart.js';
</script>
