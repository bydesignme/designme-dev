---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Inline text diff: The agent's edits to a piece of copy, accepted or rejected one by one.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change inline-text-diff.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './inline-text-diff.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="inline-text-diff" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="itd panel">
  <div class="itd-h"><div class="itd-ht"><b>Pricing intro</b><span class="muted itd-st">4 edits to review</span></div><div class="itd-a"><button class="pill ghost sm itd-no">Reject all</button><button class="pill primary sm itd-ok">Accept all</button></div></div>
  <p class="itd-t"></p>
  <p class="itd-f muted" aria-live="polite"></p>
  <div class="itd-bar" role="dialog" aria-label="Edit">
    <p class="itd-why"><svg class="i xs"><use href="#i-alert"/></svg><span></span></p>
    <div class="itd-bb"><button class="pill primary sm itd-acc"><svg class="i xs"><use href="#i-check"/></svg>Accept</button><button class="pill ghost sm itd-rej"><svg class="i xs"><use href="#i-x"/></svg>Reject</button></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './inline-text-diff.js';
</script>
