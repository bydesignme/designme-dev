---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Design review: Checks run, a teammate asks for a change, the agent makes it, and you ship.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change design-review.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './design-review.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="design-review" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="drv panel">
  <div class="drv-h"><span class="drv-ic"><svg class="i s"><use href="#i-palette"/></svg></span><div class="drv-ht"><b>Pricing page v4</b><span class="muted">6 screens · sent for review by the design agent</span></div><span class="tag b drv-tag">In review</span></div>
  <div class="drv-b">
    <div class="drv-col"><span class="drv-lb">Checks</span><div class="drv-checks"></div></div>
    <div class="drv-col"><span class="drv-lb">Review</span><div class="drv-rv" aria-live="polite"><span class="muted drv-wt">Maya reviews once the checks pass</span></div></div>
  </div>
  <div class="drv-f">
    <span class="muted drv-st">Waiting on checks</span>
    <div class="drv-mg"><button class="pill accent sm drv-go" disabled>Ship to everyone</button><button class="pill accent sm drv-dd" aria-label="How it ships" data-pop=".drv-pop" data-pop-align="end" disabled><svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
    <div class="pop drv-pop" role="menu">
      <button class="mi" role="menuitemradio" data-close data-m="Ship to everyone" aria-checked="true"><span>Ship to everyone<span class="d">Every visitor sees it now</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
      <button class="mi" role="menuitemradio" data-close data-m="Ship to 10% first" aria-checked="false"><span>Ship to 10% first<span class="d">Everyone else after a day</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
      <button class="mi" role="menuitemradio" data-close data-m="Ship on Monday" aria-checked="false"><span>Ship on Monday<span class="d">At 09:00 your time</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    </div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './design-review.js';
</script>
