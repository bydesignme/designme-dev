---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Rich text editor: A minimal editor with an inline AI menu that streams a suggestion to accept or discard.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change rich-text-editor.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './rich-text-editor.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="rich-text-editor" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rte" data-st="edit">
  <div class="rte-tb" role="toolbar" aria-label="Formatting">
    <button class="rte-b" data-f="h2" aria-pressed="false" aria-label="Heading" data-tip="Heading" data-k="mod alt 1"><svg class="i "><use href="#i-heading"/></svg></button>
    <button class="rte-b" data-f="b" aria-pressed="false" aria-label="Bold" data-tip="Bold" data-k="mod B"><svg class="i "><use href="#i-bold"/></svg></button>
    <button class="rte-b" data-f="i" aria-pressed="false" aria-label="Italic" data-tip="Italic" data-k="mod I"><svg class="i "><use href="#i-italic"/></svg></button>
    <button class="rte-b" data-f="code" aria-pressed="false" aria-label="Inline code" data-tip="Inline code" data-k="mod E"><svg class="i "><use href="#i-code"/></svg></button>
    <button class="rte-b" data-f="a" aria-haspopup="dialog" aria-expanded="false" aria-label="Link" data-tip="Link" data-k="mod K"><svg class="i "><use href="#i-link"/></svg></button>
    <span class="rte-sep" aria-hidden="true"></span>
    <button class="rte-b" data-f="ul" aria-pressed="false" aria-label="Bulleted list" data-tip="Bulleted list" data-k="mod shift 8"><svg class="i "><use href="#i-list"/></svg></button>
    <button class="rte-b" data-f="ol" aria-pressed="false" aria-label="Numbered list" data-tip="Numbered list" data-k="mod shift 7"><svg class="i "><use href="#i-list-ol"/></svg></button>
    <button class="rte-b" data-f="quote" aria-pressed="false" aria-label="Quote" data-tip="Quote" data-k="mod shift 9"><svg class="i "><use href="#i-quote"/></svg></button>
    <span class="sp"></span>
    <button class="rte-ai" aria-haspopup="menu" aria-expanded="false" aria-label="Ask AI" data-tip="Edit or write with AI" data-k="mod J"><svg class="i s"><use href="#i-spark"/></svg><span>Ask AI</span></button>
  </div>
  <div class="rte-body empty" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Draft" aria-placeholder="Write a draft, or type / on a new line for AI" data-placeholder="Write a draft, or type / on a new line for AI" spellcheck="true"><p><br></p></div>
  <div class="rte-ft">
    <div class="rte-idle"><span class="rte-wc num">0 words</span><span class="rte-hint">Select text to ask AI</span><span class="sp"></span><button class="ib rte-un" aria-label="Undo" data-tip="Undo" data-k="mod Z" disabled><svg class="i s"><use href="#i-undo"/></svg></button><button class="ib rte-re" aria-label="Redo" data-tip="Redo" data-k="redo" disabled><svg class="i s"><use href="#i-redo"/></svg></button></div>
    <div class="rte-rev"><span class="rte-st"></span><span class="sp"></span><button class="pill ghost sm rte-no">Discard<span class="kbd">Esc</span></button><button class="pill accent sm rte-ok" disabled>Accept<span class="kbd">Tab</span></button></div>
  </div>
  <button class="rte-ask" tabindex="-1" aria-label="Ask AI about the selection"><svg class="i s"><use href="#i-spark"/></svg><span>Ask AI</span></button>
  <div class="pop rte-menu" role="menu">
    <div class="ph">Edit the selection</div>
    <button class="mi" role="menuitem" tabindex="-1" data-a="improve"><svg class="i s"><use href="#i-wand"/></svg><span>Improve writing</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="shorter"><svg class="i s"><use href="#i-minus"/></svg><span>Make shorter</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="grammar"><svg class="i s"><use href="#i-check"/></svg><span>Fix grammar</span></button>
    <button class="mi" role="menuitem" tabindex="-1" data-a="continue"><svg class="i s"><use href="#i-edit"/></svg><span>Continue writing</span></button>
  </div>
  <div class="pop rte-lnk" role="dialog" aria-label="Link">
    <input class="rte-url" type="url" placeholder="Paste or type a link" aria-label="Link address" autocomplete="off" spellcheck="false">
    <button class="pill accent sm rte-lok">Apply</button>
    <button class="ib rte-lrm" aria-label="Remove link" data-tip="Remove link"><svg class="i s"><use href="#i-trash"/></svg></button>
  </div>
  <p class="rte-live" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './rich-text-editor.js';
</script>
