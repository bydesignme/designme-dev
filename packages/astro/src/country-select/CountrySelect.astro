---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Country select: A searchable select with country codes, currency and keyboard support.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change country-select.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './country-select.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="country-select" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="csx">
  <label class="csx-l">Billing country</label>
  <button class="csx-f" aria-haspopup="listbox" aria-expanded="false"><span class="csx-fl"></span><span class="csx-v"></span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
  <div class="csx-pop"><input class="csx-q" placeholder="Search countries" aria-label="Search countries" spellcheck="false"><div class="csx-list" role="listbox"></div></div>
  <span class="muted csx-h">Used for tax and currency</span>
</div>
  </Fragment></div>
</div>
<script>
  import './country-select.js';
</script>
