---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Task table: Agent tasks in a sortable table with bulk actions.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change task-table.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './task-table.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="task-table" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ttx panel" data-reveal="flat">
  <div class="ttx-hd">
    <div class="ttx-ti"><b>Agent tasks</b><span class="muted num ttx-sum">6 tasks, 2 running</span></div>
    <div class="ttx-sb" inert><span class="ttx-n num">2 selected</span><button class="pill ghost sm" data-a="pause"><svg class="i xs"><use href="#i-pause"/></svg>Pause</button><button class="pill ghost sm" data-a="retry"><svg class="i xs"><use href="#i-refresh"/></svg>Retry</button><button class="pill ghost sm ttx-del" data-a="cancel"><svg class="i xs"><use href="#i-x"/></svg>Cancel</button><span class="ttx-sp"></span><button class="pill ghost sm ttx-clr">Clear</button></div>
  </div>
  <div class="ttx-sc"><table class="ttx-t">
    <thead><tr><th class="ck"><button class="ttx-cb ttx-all" role="checkbox" aria-checked="false" aria-label="Select all"></button></th><th><button class="ttx-s" data-k="0">Task</button></th><th><button class="ttx-s" data-k="1">Status</button></th><th><button class="ttx-s" data-k="2">Agent</button></th><th class="r"><button class="ttx-s" data-k="3">Cost</button></th><th class="r"><button class="ttx-s" data-k="4">Updated</button></th></tr></thead>
    <tbody></tbody>
  </table></div>
</div>
  </Fragment></div>
</div>
<script>
  import './task-table.js';
</script>
