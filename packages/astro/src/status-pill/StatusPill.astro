---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Status pill: One live line for what the agent is doing right now.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change status-pill.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './status-pill.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="status-pill" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="spl dm">
  <div class="spl-stage dm-main">
    <div class="spl-pill" aria-live="polite"><div class="spl-in"></div></div>
  </div>
  <div class="demo"><div class="seg2" role="group" aria-label="Variant"><button aria-pressed="true" data-v="pill">Pill</button><button aria-pressed="false" data-v="bar">Bar</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './status-pill.js';
</script>
