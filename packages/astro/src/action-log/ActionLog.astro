---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Action log: Every read, search, edit and command, logged as it runs.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change action-log.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './action-log.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="action-log" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="alg panel">
  <div class="alg-h"><span class="alg-t">Agent activity</span><span class="alg-st"><span class="spin"></span><span class="alg-sum">Running</span></span></div>
  <ol class="alg-list"></ol>
</div>
  </Fragment></div>
</div>
<script>
  import './action-log.js';
</script>
