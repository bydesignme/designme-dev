---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Tools and connections: The tools the agent can reach, and how much it may do with each.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change tool-connections.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './tool-connections.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="tool-connections" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="hnx panel" data-reveal="flat">
  <div class="hnx-h"><span class="hnx-hi" aria-hidden="true"><svg class="i xs"><use href="#i-link"/></svg></span><div class="hnx-ht"><b>Tools and connections</b></div><button class="pill ghost sm hnx-test"><svg class="i xs"><use href="#i-refresh"/></svg><span>Test all</span></button></div>
  <div class="hnx-list" role="list" aria-label="Tools"></div>
  <div class="hnx-ft"><button class="hnx-add" data-pop=".hnx-pop" aria-haspopup="menu" aria-expanded="false"><svg class="i xs"><use href="#i-plus"/></svg>Connect a tool</button><span class="muted hnx-st" aria-live="polite"></span></div>
  <div class="pop hnx-pop" role="menu" aria-label="Connect a tool"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './tool-connections.js';
</script>
