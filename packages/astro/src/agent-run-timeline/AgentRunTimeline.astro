---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agent run timeline: Every model and tool step of a run on one time axis.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agent-run-timeline.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agent-run-timeline.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', 'bare', className]} data-c="agent-run-timeline" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="art panel">
  <div class="art-h"><div class="art-hd"><div class="art-t">Run 4821, update the pricing page</div><div class="art-s muted num">Starting</div></div><span class="art-tag tag"><span class="spin" aria-hidden="true"></span>Running</span></div>
  <div class="art-key num" role="list" aria-label="Time by kind of step"></div>
  <div class="art-grid">
    <div class="art-axis" aria-hidden="true"><span></span><div class="art-ticks"></div><span></span></div>
    <div class="art-past" aria-hidden="true"></div>
    <div class="art-rows"></div>
    <div class="art-head" aria-hidden="true"><i></i><span class="art-now num">0.0s</span></div>
  </div>
  <div class="art-f muted num"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './agent-run-timeline.js';
</script>
