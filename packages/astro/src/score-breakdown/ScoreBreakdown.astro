---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Score breakdown: A score out of 100 whose gauge is split by what goes into it, with the weakest part flagged and a fix to try.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change score-breakdown.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './score-breakdown.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="score-breakdown" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="sbx panel">
  <div class="sbx-top">
    <div class="sbx-g" role="meter" aria-label="Quality score" aria-valuemin="0" aria-valuemax="100"><svg viewBox="0 0 200 108" aria-hidden="true"></svg><div class="sbx-v"><b class="num">0</b><span class="muted">of 100</span></div></div>
    <div class="sbx-s"><b>Support agent quality</b><span class="sbx-band"><span class="muted sbx-bw">Scoring</span><span class="tag ok num sbx-ch" hidden></span></span></div>
  </div>
  <div class="sbx-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './score-breakdown.js';
</script>
