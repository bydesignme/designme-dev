---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agent builder: Describe an agent in a sentence and it drafts the rest: who it is, what it may do, what it knows, when it runs. Test it, save it, publish it.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agent-builder.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agent-builder.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="agent-builder" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="abx panel"><div class="abx-g">
  <div class="abx-f">
    <div class="abx-ask"><label class="abx-l" for="abx-desc">Describe your agent</label><div class="abx-askr"><input class="abx-in" id="abx-desc" autocomplete="off" placeholder="What should it do?"><button class="pill primary sm abx-go"><svg class="i xs"><use href="#i-spark"/></svg>Draft</button></div></div>
    <div class="abx-s" data-s="id" role="group" aria-label="Identity"><div class="abx-sh"><span>Identity</span></div>
      <div class="abx-idr"><span class="abx-av"></span><input class="abx-in abx-name" aria-label="Name" placeholder="Name" autocomplete="off">
        <div class="abx-look"><div class="abx-sw" role="radiogroup" aria-label="Colour"></div><div class="seg2 abx-shp" role="radiogroup" aria-label="Shape"></div></div></div>
      <span class="abx-err" hidden><svg class="i xs"><use href="#i-alert"/></svg>Give it a name to save it</span>
      <input class="abx-in abx-purp" aria-label="Purpose" placeholder="What it is for" autocomplete="off">
    </div>
    <div class="abx-s" data-s="ins" role="group" aria-label="Instructions"><div class="abx-sh"><span>Instructions</span></div><textarea class="abx-ta" rows="3" aria-label="Instructions" placeholder="How it should work"></textarea></div>
    <div class="abx-s" data-s="model" role="group" aria-label="Model and effort"><div class="abx-sh"><span>Model and effort</span></div>
      <div class="abx-mr"><select class="abx-in abx-sel" aria-label="Model"><option>Haiku 5</option><option>Sonnet 5</option><option>Opus 5.5</option></select><div class="seg2 abx-eff" role="group" aria-label="Effort"><button aria-pressed="false" data-v="low">Low</button><button aria-pressed="true" data-v="med">Medium</button><button aria-pressed="false" data-v="high">High</button></div></div>
    </div>
    <div class="abx-s" data-s="tools" role="group" aria-label="Tools"><div class="abx-sh"><span>Tools</span><span class="muted">What it may do in each</span></div><div class="abx-tools"></div></div>
    <div class="abx-s" data-s="know" role="group" aria-label="Knowledge"><div class="abx-sh"><span>Knowledge</span></div><div class="abx-kn"></div></div>
    <div class="abx-s" data-s="trig" role="group" aria-label="Trigger"><div class="abx-sh"><span>Trigger</span></div>
      <div class="abx-tr"><div class="seg2 abx-trs" role="group" aria-label="Starts on"><button aria-pressed="true" data-v="chat">Chat</button><button aria-pressed="false" data-v="sched">Schedule</button><button aria-pressed="false" data-v="event">Event</button></div><span class="muted abx-trd">When someone messages it</span></div>
    </div>
    <div class="abx-bar"><span class="abx-st muted">Not saved</span><span class="sp"></span><button class="pill line sm abx-test"><svg class="i xs"><use href="#i-play"/></svg>Test</button><button class="pill line sm abx-save">Save</button><button class="pill primary sm abx-pub">Publish</button></div>
  </div>
  <div class="abx-c">
    <div class="abx-ch"><div class="abx-cht"><b>Test</b><span class="muted abx-cs">Try it before it goes live</span></div></div>
    <div class="abx-log" aria-live="polite"><p class="muted abx-empty">Draft the agent, then press Test to send it a sample email.</p></div>
  </div>
  </div><p class="abx-sr" role="status"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './agent-builder.js';
</script>
