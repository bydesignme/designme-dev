---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Health score: An account's health: a score ring, four factors that open, and the agent's next move.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change health-score.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './health-score.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="health-score" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="hsc-dm dm"><div class="dm-main">
  <div class="hsc panel" role="group" aria-label="Account health">
    <div class="hsc-ac"><b></b><span></span></div>
    <div class="hsc-h">
      <div class="hsc-ring" role="img" aria-label="Health score"><svg viewBox="0 0 44 44" aria-hidden="true"><circle class="tr" cx="22" cy="22" r="18"/><circle class="fl" cx="22" cy="22" r="18" stroke-dasharray="113.1" stroke-dashoffset="113.1"/></svg><b class="num" aria-hidden="true">0</b></div>
      <div class="hsc-ht"><b class="hsc-vd"></b><span class="hsc-sub"></span></div>
      <span class="hsc-dl num"></span>
    </div>
    <div class="hsc-l"></div>
    <div class="hsc-s"><svg class="i s"><use href="#i-spark"/></svg><span class="hsc-st"></span><button type="button" class="pill primary sm hsc-go"></button></div>
    <p class="hsc-sr" aria-live="polite"></p>
  </div>
  </div>
  <div class="demo"><div class="seg2" role="group" aria-label="Account"><button aria-pressed="false" data-v="0">Healthy</button><button aria-pressed="true" data-v="1">Watch</button><button aria-pressed="false" data-v="2">At risk</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './health-score.js';
</script>
