---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Context switcher: The organisation, project and environment you are in, each part a searchable switcher.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change context-switcher.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './context-switcher.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="context-switcher" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="csw">
  <nav class="csw-bar panel" aria-label="Context">
    <ol class="csw-path">
      <li class="csw-mi"><button class="csw-more" aria-haspopup="menu" aria-expanded="false" aria-label="Organisation and project" data-tip="Organisation and project"><svg class="i s"><use href="#i-more"/></svg></button></li>
      <li class="csw-sep m" aria-hidden="true"><svg class="i s"><use href="#i-crumb"/></svg></li>
      <li class="csw-seg" data-k="org"><button class="csw-tr" aria-haspopup="listbox" aria-expanded="false"><span class="csw-lg"></span><span class="csw-nm"></span><span class="csw-bh"></span><svg class="i xs"><use href="#i-unfold"/></svg></button></li>
      <li class="csw-sep" aria-hidden="true"><svg class="i s"><use href="#i-crumb"/></svg></li>
      <li class="csw-seg" data-k="project"><button class="csw-tr" aria-haspopup="listbox" aria-expanded="false"><span class="csw-nm"></span><span class="csw-bh"></span><svg class="i xs"><use href="#i-unfold"/></svg></button></li>
      <li class="csw-sep" aria-hidden="true"><svg class="i s"><use href="#i-crumb"/></svg></li>
      <li class="csw-seg" data-k="env"><button class="csw-tr" aria-haspopup="listbox" aria-expanded="false"><span class="csw-nm"></span><span class="csw-bh"></span><svg class="i xs"><use href="#i-unfold"/></svg></button></li>
    </ol>
  </nav>
  <div class="pop csw-pop">
    <div class="csw-sf"><svg class="i xs"><use href="#i-search"/></svg><input class="csw-q" role="combobox" aria-autocomplete="list" aria-expanded="false" spellcheck="false" autocomplete="off"></div>
    <div class="csw-list" role="listbox"></div>
  </div>
  <div class="pop csw-mpop" role="menu" aria-label="Organisation and project"></div>
  <p class="csw-live" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './context-switcher.js';
</script>
