---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Comments: A design thread where you can @mention the agent and it replies.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change comments.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './comments.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="comments" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="cmx panel">
  <div class="cmx-h"><span class="cmx-pin" aria-hidden="true">1</span><b>Pricing, frame 2</b><span class="cmx-st num"></span><button class="ib cmx-res" aria-label="Resolve thread" aria-pressed="false" data-tip="Resolve thread"><svg class="i xs"><use href="#i-check"/></svg></button></div>
  <div class="cmx-th" aria-live="polite"></div>
  <div class="cmx-in"><div class="cmx-box"><input placeholder="Reply, or @agent to ask" aria-label="Reply" spellcheck="false" autocomplete="off"><button class="cmx-go" aria-label="Send" disabled><svg class="i xs"><use href="#i-up"/></svg></button></div><div class="pop cmx-men" role="listbox"></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './comments.js';
</script>
