---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Composer: Message input with attachments, what to work on, a mode and dictation.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change composer.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './composer.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="composer" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="cpx">
  <div class="cpx-thread" aria-live="polite"></div>
  <div class="cpx-box" data-mode="idle">
    <div class="cpx-att"></div>
    <textarea class="cpx-ta" rows="1" aria-label="Message" placeholder="Ask the design agent, or attach a frame"></textarea>
    <div class="cpx-rows">
      <div class="cpx-bar">
        <button class="ib cpx-add" aria-label="Attach" data-tip="Attach a file or a frame" data-pop=".pp-plus" data-pop-pos="up"><svg class="i s"><use href="#i-clip"/></svg></button>
        <button class="chip cpx-ctx" data-pop=".pp-ctx" data-pop-pos="up" data-tip="What the agent works on"><svg class="i s"><use href="#i-figma"/></svg><span class="cpx-ctx-n">Pricing v4</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
        <span class="sp"></span>
        <button class="chip cpx-mode" data-pop=".pp-mode" data-pop-pos="up" data-pop-align="end" data-tip="What the agent may do"><svg class="i s"><use href="#i-eye"/></svg><span class="cpx-mode-n">Ask</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
        <button class="ib cpx-mic" aria-label="Dictate" data-tip="Dictate"><svg class="i s"><use href="#i-mic"/></svg></button>
        <button class="cpx-send" aria-label="Send" data-tip="Send" data-tip-k="↵" disabled><svg class="i s"><use href="#i-up"/></svg></button>
      </div>
      <div class="cpx-voice">
        <span class="cpx-rec"><span class="cpx-dot"></span>Listening</span><span class="cpx-tm num muted">0:00</span>
        <span class="sp"></span>
        <button class="pill ghost sm cpx-cancel">Cancel</button>
        <button class="pill primary sm cpx-ok">Done</button>
      </div>
    </div>
    <div class="pop pp-plus" role="menu" aria-label="Attach">
      <button class="mi" role="menuitem" data-close data-add="file"><svg class="i s"><use href="#i-file-text"/></svg><span>Upload a file<span class="d">Images, PDFs or code</span></span></button>
      <button class="mi" role="menuitem" data-close data-add="figma"><svg class="i s"><use href="#i-figma"/></svg><span>Link a Figma frame<span class="d">From any file you can open</span></span></button>
      <button class="mi" role="menuitem" data-close data-add="shot"><svg class="i s"><use href="#i-image"/></svg><span>Add a screenshot<span class="d">Of the window you're in</span></span></button>
    </div>
    <div class="pop pp-ctx" role="menu">
      <div class="ph">Working on</div>
      <button class="mi" role="menuitemradio" aria-checked="true" data-close data-ctx="Pricing v4" data-ic="figma"><svg class="i s"><use href="#i-figma"/></svg><span>Pricing v4<span class="d">Figma, 6 frames</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
      <button class="mi" role="menuitemradio" aria-checked="false" data-close data-ctx="Checkout flow" data-ic="figma"><svg class="i s"><use href="#i-figma"/></svg><span>Checkout flow<span class="d">Figma, 4 frames</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
      <button class="mi" role="menuitemradio" aria-checked="false" data-close data-ctx="Marketing site" data-ic="code"><svg class="i s"><use href="#i-code"/></svg><span>Marketing site<span class="d">Code, main branch</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
    </div>
    <div class="pop pp-mode" role="menu">
      <div class="ph">The agent may</div>
      <button class="mi" role="menuitemradio" aria-checked="true" data-close data-mode="Ask" data-ic="eye"><svg class="i s"><use href="#i-eye"/></svg><span>Ask<span class="d">Answer only, change nothing</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
      <button class="mi" role="menuitemradio" aria-checked="false" data-close data-mode="Edit" data-ic="edit"><svg class="i s"><use href="#i-edit"/></svg><span>Edit<span class="d">Change frames on a new page</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
      <button class="mi" role="menuitemradio" aria-checked="false" data-close data-mode="Plan" data-ic="list"><svg class="i s"><use href="#i-list"/></svg><span>Plan<span class="d">Propose steps before it starts</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
    </div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './composer.js';
</script>
