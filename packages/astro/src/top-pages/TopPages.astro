---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Top pages: Most visited pages with share of traffic and a quick sort.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change top-pages.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './top-pages.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="top-pages" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tpx panel">
  <div class="tpx-h"><div><b>Top pages</b><span class="muted tpx-sub"><span class="num tpx-tot">0</span> views, last 30 days</span></div><div class="seg2 tpx-sg" role="group" aria-label="Sort"><button aria-pressed="true" data-v="v">Views</button><button aria-pressed="false" data-v="c">Change</button></div></div>
  <div class="tpx-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './top-pages.js';
</script>
