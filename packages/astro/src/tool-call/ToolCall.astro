---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Tool call: Each tool the agent calls, with its input and output.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change tool-call.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './tool-call.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="tool-call" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tcx">
  <p class="msg tcx-m1">Checking which plans changed this month before I update the pricing page.</p>
  <div class="tcx-calls"></div>
  <p class="msg tcx-end">Two plans changed. I updated their prices and the yearly saving on the page.</p>
</div>
  </Fragment></div>
</div>
<script>
  import './tool-call.js';
</script>
