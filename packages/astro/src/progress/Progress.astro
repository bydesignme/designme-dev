---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Progress and meter: An agent run's progress and what it costs, with a credits meter that warns as it fills.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change progress.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './progress.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="progress" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="prg panel" data-s="ind">
  <div class="prg-h">
    <span class="prg-ring" role="progressbar" aria-label="Run progress"><svg viewBox="0 0 36 36" aria-hidden="true"><circle class="tr" cx="18" cy="18" r="15"/><circle class="fl" cx="18" cy="18" r="15" pathLength="100"/></svg><span class="prg-pc num"></span></span>
    <div class="prg-t"><b>Indexing the docs</b><span class="muted prg-vt">Preparing the run</span></div>
    <span class="tag prg-st">Starting</span>
    <button class="ib prg-btn" aria-label="Pause" data-tip="Pause"><svg class="i s"><use href="#i-pause"/></svg></button>
  </div>
  <div class="prg-seg" role="progressbar" aria-label="Steps" aria-valuemin="0" aria-valuemax="5"><i><b></b></i><i><b></b></i><i><b></b></i><i><b></b></i><i><b></b></i></div>
  <div class="prg-ll"></div>
  <div class="prg-lin ind" role="progressbar" aria-label="This step" aria-valuemin="0" aria-valuemax="100"><i></i></div>
  <div class="prg-meter">
    <div class="prg-mh"><span>Credits this month</span><span class="num muted"><b class="prg-mv">0</b> of 10,000</span></div>
    <div class="prg-mb" role="meter" aria-label="Credits used" aria-valuemin="0" aria-valuemax="10000"><i class="fl"></i><i class="th" style="left:75%"></i><i class="th" style="left:90%"></i></div>
    <div class="prg-ml"><span class="prg-mw"></span><span class="muted">Resets Dec 1</span></div>
  </div>
  <p class="prg-sr" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './progress.js';
</script>
