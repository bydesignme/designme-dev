---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Voice capture: Talk to the agent, then fix what it misheard before sending.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change voice-capture.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './voice-capture.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="voice-capture" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="vcx panel">
  <div class="vcx-top"><span class="vcx-dot"></span><span class="vcx-st">Listening</span><span class="vcx-t num muted">0:00</span></div>
  <canvas class="vcx-wave" aria-hidden="true"></canvas>
  <p class="vcx-tx" aria-live="polite"></p>
  <div class="vcx-acts">
    <button class="ib fill vcx-pause" aria-label="Pause" data-tip="Pause"><svg class="i s"><use href="#i-pause"/></svg></button>
    <span class="sp"></span>
    <button class="pill ghost sm vcx-x">Cancel</button>
    <button class="pill primary sm vcx-done">Done</button>
  </div>
  <div class="pop vcx-fix" role="menu"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './voice-capture.js';
</script>
