---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agenda: Today's schedule with a live now line and agent prep notes.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agenda.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agenda.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="agenda" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="agx panel">
  <div class="agx-h"><div><b>Today</b><span class="muted">Monday, Oct 19</span></div><span class="tag b agx-n">4 events</span></div>
  <div class="agx-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './agenda.js';
</script>
