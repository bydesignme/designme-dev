---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agent phases: One line for which phase the agent is in, from thinking to done, that stops to ask you, says when it is slow, and folds to how long it took.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agent-phases.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agent-phases.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="agent-phases" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="aph">
  <button class="aph-h" aria-expanded="false" aria-disabled="true"><span class="aph-g"></span><span class="aph-l"></span><span class="aph-t num">0s</span><svg class="i xs aph-chev"><use href="#i-chev-d"/></svg></button>
  <div class="aph-tr" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
  <div class="aph-x"></div>
  <div class="fold shut aph-fold"><div><ol class="aph-list"></ol></div></div>
  <p class="aph-sr" role="status"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './agent-phases.js';
</script>
