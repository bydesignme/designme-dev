---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Stat cards: Four headline numbers with sparklines and a period switch.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change stat-cards.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './stat-cards.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="stat-cards" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="scx">
  <div class="scx-h"><div class="seg2 scx-sg" role="group" aria-label="Period"><button aria-pressed="false" data-v="0">7 days</button><button aria-pressed="true" data-v="1">30 days</button><button aria-pressed="false" data-v="2">Quarter</button></div></div>
  <div class="scx-grid"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './stat-cards.js';
</script>
