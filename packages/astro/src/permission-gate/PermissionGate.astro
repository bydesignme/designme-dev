---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Permission gate: The agent asks before it touches something new.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change permission-gate.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './permission-gate.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="permission-gate" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="pgx panel">
  <div class="pgx-h"><span class="pgx-ic"><svg class="i s"><use href="#i-figma"/></svg></span><div class="pgx-ht"><b>Allow the agent to edit Figma?</b><span class="muted">It needs this to apply the pricing fixes</span></div></div>
  <div class="pgx-sc">
    <label class="pgx-o" data-k="read"><input type="checkbox" checked><span class="bx"><svg class="i xs"><use href="#i-check"/></svg></span><span class="t">Read frames<span class="d">Pricing, Checkout</span></span></label>
    <label class="pgx-o" data-k="edit"><input type="checkbox" checked><span class="bx"><svg class="i xs"><use href="#i-check"/></svg></span><span class="t">Edit frames<span class="d">Only on a new page</span></span></label>
    <label class="pgx-o" data-k="publish"><input type="checkbox"><span class="bx"><svg class="i xs"><use href="#i-check"/></svg></span><span class="t">Publish library<span class="d">Affects 4 other files</span></span><span class="tag warn" data-tip="Checkout, Marketing site, Email kit and Docs use this library">Risky</span></label>
  </div>
  <div class="pgx-f"><button class="pgx-db" aria-haspopup="menu" aria-expanded="false" aria-label="How long" data-pop=".pgx-pop"><span class="pgx-dv">For this task</span><svg class="i xs"><use href="#i-chev-d"/></svg></button><span class="sp"></span><button class="pill ghost sm pgx-no">Not now</button><button class="pill primary sm pgx-ok">Allow 2 scopes</button></div>
  <div class="pop pgx-pop" role="menu" aria-label="How long">
    <button class="mi" role="menuitemradio" aria-checked="true" data-close data-v="This task"><span>For this task<span class="d">Until the pricing fixes are done</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-v="Today"><span>For today<span class="d">Until midnight</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-v="Always"><span>Always<span class="d">Until you revoke it</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './permission-gate.js';
</script>
