---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Line chart: Today so far and projected, against yesterday, with a range switch, a project picker, toggles and a readout.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change line-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './line-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="line-chart" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="lnx panel">
  <div class="lnx-h">
    <div class="lnx-tl"><span class="lnx-t">Active editors</span><button class="lnx-pk" data-pop="#lnx-pp" aria-haspopup="menu" aria-expanded="false"><span class="lnx-mk" aria-hidden="true"></span><span class="lnx-pn"></span><svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
    <div class="seg2 lnx-rg" role="group" aria-label="Range"><button aria-pressed="true" data-v="d">Day</button><button aria-pressed="false" data-v="w">Week</button><button aria-pressed="false" data-v="m">Month</button></div>
  </div>
  <div class="pop lnx-pp" id="lnx-pp" role="menu" aria-label="Project"></div>
  <div class="lnx-pl">
    <div class="lnx-y num" aria-hidden="true"></div>
    <div class="lnx-ch" tabindex="0" role="group" aria-roledescription="line chart"><svg class="lnx-svg" aria-hidden="true"></svg><span class="lnx-x"></span><span class="lnx-pt" style="color:var(--dm-lnx-cmp)"></span><span class="lnx-pt" style="color:var(--dm-lnx-line)"></span><span class="lnx-now"></span><span class="lnx-aim" aria-hidden="true"></span><div class="lnx-tt" aria-hidden="true"><div class="lnx-tt-h"></div><div class="lnx-tt-r"><i></i><span></span><b class="num"></b></div><div class="lnx-tt-r c"><i></i><span></span><b class="num"></b></div></div></div>
    <div class="lnx-ax num" aria-hidden="true"></div>
  </div>
  <div class="lnx-lg"><button class="lnx-k" aria-pressed="true" data-s="a"><i></i><span></span></button><button class="lnx-k p" aria-pressed="true" data-s="p"><i></i><span>Projected</span></button><button class="lnx-k c" aria-pressed="true" data-s="b"><i></i><span></span></button></div>
  <p class="lnx-sr" aria-live="polite"></p>
  <div class="lnx-sr"><table></table></div>
</div>
  </Fragment></div>
</div>
<script>
  import './line-chart.js';
</script>
