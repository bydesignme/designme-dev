---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Line chart: Two series over time with a hover readout and toggles.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change line-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './line-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="line-chart" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="lnx panel">
  <div class="lnx-h"><div><span class="muted">Active editors</span><b class="num lnx-v">0</b></div><div class="lnx-lg"><button class="lnx-k on" data-s="0"><i style="background:var(--dm-accent-mark,var(--dm-accent))"></i>This year</button><button class="lnx-k on" data-s="1"><i style="background:var(--dm-c2)"></i>Last year</button></div></div>
  <div class="lnx-ch"><svg class="lnx-svg" viewBox="0 0 320 140" preserveAspectRatio="none"></svg><div class="lnx-x"></div><div class="lnx-tt"><b class="num"></b><span></span></div></div>
  <div class="lnx-ax muted num"><span>Jan</span><span>Mar</span><span>May</span><span>Jul</span><span>Sep</span><span>Nov</span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './line-chart.js';
</script>
