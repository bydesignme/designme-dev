---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Trace view: One agent run as a waterfall of spans, with latency and tokens.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change trace-view.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './trace-view.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="trace-view" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="trv panel">
  <div class="trv-h"><div class="trv-ht"><b>Pricing research</b><span class="muted trv-st" aria-live="polite"></span></div><span class="trv-tot num">0.00s</span></div>
  <div class="trv-lg" role="list" aria-label="Spans by kind"></div>
  <div class="trv-ax" aria-hidden="true"><span>Span</span><span class="trv-sc"></span><span class="trv-tk">Tokens</span><span class="trv-ms">Time</span></div>
  <div class="trv-rows" role="group" aria-label="Spans"></div>
  <div class="fold shut trv-dt" inert><div><div class="trv-dc" role="region" aria-label="Span details"></div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './trace-view.js';
</script>
