---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Buttons: Every button style, with loading, success and hold-to-confirm states.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change buttons.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './buttons.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="buttons" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="btx">
  <div class="btx-row"><span class="btx-l muted">Styles</span><button class="pill accent btx-trial">Start free trial</button><button class="pill primary btx-run">Run agent</button><button class="pill soft btx-pv" aria-pressed="false">Preview</button><button class="pill line btx-share" data-pop=".btx-sp" aria-haspopup="menu">Share</button><div class="pop btx-sp" role="menu"><button class="mi" role="menuitem" data-close data-a="link"><svg class="i s"><use href="#i-link"/></svg>Copy link</button><button class="mi" role="menuitem" data-close data-a="slack"><svg class="brand" aria-hidden="true" viewBox="0 0 128 128"><path d="M27.255 80.719c0 7.33-5.978 13.317-13.309 13.317C6.616 94.036.63 88.049.63 80.719s5.987-13.317 13.317-13.317h13.309zm6.709 0c0-7.33 5.987-13.317 13.317-13.317s13.317 5.986 13.317 13.317v33.335c0 7.33-5.986 13.317-13.317 13.317-7.33 0-13.317-5.987-13.317-13.317zm0 0" fill="#de1c59"/><path d="M47.281 27.255c-7.33 0-13.317-5.978-13.317-13.309C33.964 6.616 39.951.63 47.281.63s13.317 5.987 13.317 13.317v13.309zm0 6.709c7.33 0 13.317 5.987 13.317 13.317s-5.986 13.317-13.317 13.317H13.946C6.616 60.598.63 54.612.63 47.281c0-7.33 5.987-13.317 13.317-13.317zm0 0" fill="#35c5f0"/><path d="M100.745 47.281c0-7.33 5.978-13.317 13.309-13.317 7.33 0 13.317 5.987 13.317 13.317s-5.987 13.317-13.317 13.317h-13.309zm-6.709 0c0 7.33-5.987 13.317-13.317 13.317s-13.317-5.986-13.317-13.317V13.946C67.402 6.616 73.388.63 80.719.63c7.33 0 13.317 5.987 13.317 13.317zm0 0" fill="#2eb57d"/><path d="M80.719 100.745c7.33 0 13.317 5.978 13.317 13.309 0 7.33-5.987 13.317-13.317 13.317s-13.317-5.987-13.317-13.317v-13.309zm0-6.709c-7.33 0-13.317-5.987-13.317-13.317s5.986-13.317 13.317-13.317h33.335c7.33 0 13.317 5.986 13.317 13.317 0 7.33-5.987 13.317-13.317 13.317zm0 0" fill="#ebb02e"/></svg>Send to Slack<span class="r">#design</span></button><button class="mi" role="menuitem" data-close data-a="pdf"><svg class="i s"><use href="#i-down"/></svg>Export as PDF</button></div><button class="pill ghost">Cancel</button></div>
  <div class="btx-row"><span class="btx-l muted">With icon</span><button class="pill accent btx-ask"><svg class="i xs"><use href="#i-spark"/></svg>Ask agent</button><button class="pill soft btx-fig"><svg class="i xs"><use href="#i-figma"/></svg>Open in Figma</button><button class="ib fill btx-icp" aria-label="Copy" data-tip="Copy"><svg class="i xs"><use href="#i-copy"/></svg></button><button class="ib fill btx-more" aria-label="More" data-tip="More" data-pop=".btx-mp" data-pop-align="end" aria-haspopup="menu"><svg class="i xs"><use href="#i-more"/></svg></button><div class="pop btx-mp" role="menu"><button class="mi" role="menuitem" data-close data-a="Duplicated"><svg class="i s"><use href="#i-copy"/></svg>Duplicate<span class="r">⌘D</span></button><button class="mi" role="menuitem" data-close data-a="Renamed"><svg class="i s"><use href="#i-edit"/></svg>Rename</button><button class="mi" role="menuitem" data-close data-a="Moved to Website"><svg class="i s"><use href="#i-folder"/></svg>Move to…</button><div class="sep"></div><button class="mi del" role="menuitem" data-close data-a="Moved to trash"><svg class="i s"><use href="#i-trash"/></svg>Delete<span class="r">⌫</span></button></div></div>
  <div class="btx-row"><span class="btx-l muted">States</span><button class="pill primary btx-load">Publish</button><button class="pill soft btx-copy"><svg class="i xs"><use href="#i-copy"/></svg>Copy link</button><button class="pill btx-hold"><span class="fill"></span><span class="lb"><svg class="i xs"><use href="#i-trash"/></svg>Hold to delete</span></button><button class="pill accent" disabled>Disabled</button></div>
  <div class="btx-row"><span class="btx-l muted">Sizes</span><button class="pill accent sm">Small</button><button class="pill accent">Default</button><button class="pill accent btx-lg">Large</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './buttons.js';
</script>
