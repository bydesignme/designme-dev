---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Multi-select: A combobox that filters as you type and keeps your picks as chips.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change multi-select.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './multi-select.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="multi-select" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="msc">
  <div class="msc-top"><label class="msc-l">Tags</label><button class="msc-clr" hidden>Clear all</button></div>
  <div class="msc-f"><input class="msc-q" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-haspopup="listbox" placeholder="Add a tag" spellcheck="false" autocomplete="off"><span class="kbd msc-key" aria-hidden="true"></span></div>
  <div class="msc-pop"><div class="msc-list" role="listbox" aria-multiselectable="true" aria-label="Tags"></div></div>
  <span class="muted msc-h">Type to filter. Backspace removes the last tag.</span>
</div>
  </Fragment></div>
</div>
<script>
  import './multi-select.js';
</script>
