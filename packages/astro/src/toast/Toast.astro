---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Toast: One notification that changes shape with its state.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change toast.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './toast.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="toast" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tst dm">
  <div class="dm-main"><div class="tst-slot" aria-live="polite"></div></div>
  <div class="demo"><div class="seg2" role="group" aria-label="State"><button aria-pressed="true" data-v="ok">Success</button><button aria-pressed="false" data-v="err">Error</button><button aria-pressed="false" data-v="info">Info</button><button aria-pressed="false" data-v="load">Loading</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './toast.js';
</script>
