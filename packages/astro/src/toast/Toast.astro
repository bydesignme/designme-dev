---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Toast: A background job in one toast, from start to finish.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change toast.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './toast.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="toast" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tst dm">
  <div class="dm-main"><div class="tst-slot">
    <button type="button" class="pill line sm tst-make"><svg class="i s"><use href="#i-spark"/></svg><span>Make slides</span></button>
    <div class="tst-t" hidden>
      <div class="tst-hd">
        <span class="tst-dk idle" aria-hidden="true"><svg viewBox="0 0 64 40"></svg></span>
        <div class="tst-tx"><span class="tst-ti"></span><span class="tst-de"></span></div>
        <div class="tst-hb">
          <button type="button" class="ib tst-more" aria-expanded="false" aria-label="Show the steps" data-tip="Steps"><svg class="i s"><use href="#i-chev-d"/></svg></button>
          <button type="button" class="ib tst-stop" aria-label="Stop the job" data-tip="Stop"><svg class="i s"><use href="#i-stop"/></svg></button>
          <button type="button" class="ib tst-x" aria-label="Close" data-tip="Close" hidden><svg class="tst-ring" viewBox="0 0 28 28" aria-hidden="true" hidden><rect class="tst-tk" x=".75" y=".75" width="26.5" height="26.5"/><rect class="tst-rn" x=".75" y=".75" width="26.5" height="26.5" pathLength="100"/></svg><svg class="i s"><use href="#i-x"/></svg></button>
        </div>
      </div>
      <div class="fold shut tst-mf"><div><ol class="tst-st" aria-label="Steps"></ol></div></div>
      <div class="fold shut tst-ft"><div><div class="tst-fi"></div></div></div>
    </div>
    <div class="tst-sr" role="status" aria-live="polite"></div>
    <div class="tst-sr" role="alert" aria-live="assertive"></div>
  </div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './toast.js';
</script>
