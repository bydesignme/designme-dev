---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Tooltip: Quiet labels on hover, with shortcuts and a richer preview card.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change tooltip.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './tooltip.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="tooltip" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ttp">
  <div class="ttp-bar panel">
    <button class="ib" aria-label="Undo" data-tip="Undo" data-tip-k="⌘Z"><svg class="i s"><use href="#i-undo"/></svg></button>
    <button class="ib" aria-label="Comment" data-tip="Comment" data-tip-k="C"><svg class="i s"><use href="#i-edit"/></svg></button>
    <button class="ib" aria-label="Ask agent" data-tip="Ask the agent" data-tip-k="⌘J"><svg class="i s"><use href="#i-spark"/></svg></button>
    <span class="ttp-sep"></span>
    <button class="ib" aria-label="Share" data-tip="Share with your team"><svg class="i s"><use href="#i-users"/></svg></button>
    <span class="ttp-sep"></span>
    <span class="ttp-avs"><button class="ttp-av" data-card="0"><span class="av" style="background:var(--dm-av-l);color:var(--dm-av-l-ink)">MK</span></button><button class="ttp-av" data-card="1"><span class="av" style="background:var(--dm-av-b);color:var(--dm-av-b-ink)">DA</span></button></span>
  </div>
  <div class="ttp-card panel"><div class="ttp-ci"></div></div>
  <p class="muted ttp-n">Labels wait a moment, then follow you instantly between buttons.</p>
</div>
  </Fragment></div>
</div>
<script>
  import './tooltip.js';
</script>
