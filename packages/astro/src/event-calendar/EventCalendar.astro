---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Event calendar: A week view where the agent finds a free slot for you.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change event-calendar.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './event-calendar.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="event-calendar" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ecx panel">
  <div class="ecx-h"><b>Oct 19 – 23, 2026</b><span class="ecx-sp"></span><span class="ecx-msg muted"></span><button class="pill soft sm ecx-ask"><svg class="i xs"><use href="#i-spark"/></svg>Find 45 min for a design review</button></div>
  <div class="ecx-days" role="group" aria-label="Day"></div>
  <div class="ecx-sc"><div class="ecx-grid"><div class="ecx-tm"></div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './event-calendar.js';
</script>
