---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Prompt starters: Suggested tasks that fill the composer in one click.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change prompt-starters.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './prompt-starters.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="prompt-starters" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="psx">
  <div class="psx-grid"></div>
  <div class="psx-in"><span class="psx-ph">Pick a starter or type your own</span><span class="psx-tx"></span><button class="psx-go" aria-label="Send" data-tip="Send" disabled><svg class="i s"><use href="#i-up"/></svg></button></div>
  <button class="pill ghost sm psx-sh"><svg class="i xs"><use href="#i-refresh"/></svg>Shuffle</button>
</div>
  </Fragment></div>
</div>
<script>
  import './prompt-starters.js';
</script>
