---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Cost vs quality: Every run as a dot by cost and eval score, sized by tokens, with quadrants and a drag to select.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change scatter-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './scatter-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="scatter-chart" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="cvq panel">
  <div class="cvq-h">
    <div class="cvq-t"><b>Cost vs quality</b><span class="muted">48 runs this week, sized by tokens</span></div>
    <div class="cvq-lg"></div>
  </div>
  <div class="cvq-pl" tabindex="0" role="group" aria-roledescription="scatter chart" aria-label="Runs by cost and eval score. Arrow keys step through the runs">
    <svg class="cvq-svg" aria-hidden="true"></svg>
    <div class="cvq-tt"><b class="num"></b><span></span></div>
  </div>
  <div class="cvq-ft" aria-live="polite"><span class="cvq-msg"></span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './scatter-chart.js';
</script>
