---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Browser session: The agent browsing for you, step by step, with Pause and Take over.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change browser-session.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './browser-session.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="browser-session" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="bws panel">
  <div class="bws-h"><div class="bws-ht"><b>Pricing research</b><span class="muted bws-st" aria-live="polite"></span></div><div class="bws-ctl"><button class="ib bws-pause" aria-label="Pause" data-tip="Pause"><svg class="i s"><use href="#i-pause"/></svg></button><button class="pill line sm bws-take" aria-pressed="false">Take over</button></div></div>
  <div class="bws-win"><div class="bws-bar"><span class="bws-dots" aria-hidden="true"><i></i><i></i><i></i></span><div class="bws-url"><svg class="i xs"><use href="#i-search"/></svg><span></span></div></div><div class="bws-vp"></div></div>
  <ol class="bws-steps" aria-label="Steps"></ol>
</div>
  </Fragment></div>
</div>
<script>
  import './browser-session.js';
</script>
