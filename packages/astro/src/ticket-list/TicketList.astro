---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Ticket list: Support tickets the agent has triaged, with suggested replies.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change ticket-list.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './ticket-list.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="ticket-list" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tkx panel">
  <div class="tkx-h"><b>Support</b><div class="seg2 tkx-sg" role="group" aria-label="Filter"><button aria-pressed="true" data-v="open">Open</button><button aria-pressed="false" data-v="done">Solved</button></div></div>
  <div class="tkx-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './ticket-list.js';
</script>
