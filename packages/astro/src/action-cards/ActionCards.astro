---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Action cards: What is waiting on you, each card with its button and a small picture of what it opens.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change action-cards.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './action-cards.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="action-cards" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="axc">
<div class="axc-row">
  <div class="panel axc-c" data-ax="commit">
    <div class="axc-tx"><b>Submit the Q4 commit</b><p>5 reps to go, due Friday.</p><button class="pill line sm">Review commit</button></div>
    <div class="axc-v" aria-hidden="true"><div class="axc-k"><div class="axc-w"><span class="axc-t">Key accounts</span><span class="axc-r"><span class="axc-l" style="width:60%"></span><span class="axc-m in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></span><span class="axc-r"><span class="axc-l" style="width:44%"></span><span class="axc-m" data-go><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></span></div><div class="axc-w"><span class="axc-t">Growth</span><span class="axc-r"><span class="axc-l" style="width:52%"></span><span class="axc-m in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></span><span class="axc-r"><span class="axc-l" style="width:38%"></span><span class="axc-m" data-go><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></span></div><div class="axc-w"><span class="axc-t">New business</span><span class="axc-r"><span class="axc-l" style="width:56%"></span><span class="axc-m in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></span><span class="axc-r"><span class="axc-l" style="width:46%"></span><span class="axc-m" data-go><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span></span></div></div><svg class="axc-cur" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 2.5l12 6.2-5.3 1.5-2.4 5.1z"/></svg></div>
  </div>
  <div class="panel axc-c" data-ax="dates">
    <div class="axc-tx"><b>Move 4 close dates</b><p>New dates are ready to be approved.</p><button class="pill line sm">Review dates</button></div>
    <div class="axc-v" aria-hidden="true"><div class="axc-k"><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-r);--dm-ai:var(--dm-av-r-ink)"><svg class="i xs"><use href="#i-cal"/></svg></span><span class="axc-n">Renewal</span></span><span class="axc-d"><s class="num">Nov 25</s><svg class="i xs"><use href="#i-right"/></svg><span class="tag axc-g num" data-go>Dec 9</span></span><span class="axc-l" style="width:72%"></span></div><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-r);--dm-ai:var(--dm-av-r-ink)"><svg class="i xs"><use href="#i-cal"/></svg></span><span class="axc-n">Renewal</span></span><span class="axc-d"><s class="num">Nov 23</s><svg class="i xs"><use href="#i-right"/></svg><span class="tag axc-g num" data-go>Dec 11</span></span><span class="axc-l" style="width:72%"></span></div><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-r);--dm-ai:var(--dm-av-r-ink)"><svg class="i xs"><use href="#i-cal"/></svg></span><span class="axc-n">Studio seats</span></span><span class="axc-d"><s class="num">Nov 20</s><svg class="i xs"><use href="#i-right"/></svg><span class="tag axc-g num" data-go>Dec 15</span></span><span class="axc-l" style="width:72%"></span></div><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-r);--dm-ai:var(--dm-av-r-ink)"><svg class="i xs"><use href="#i-cal"/></svg></span><span class="axc-n">Pilot</span></span><span class="axc-d"><s class="num">Nov 17</s><svg class="i xs"><use href="#i-right"/></svg><span class="tag axc-g num" data-go>Dec 17</span></span><span class="axc-l" style="width:72%"></span></div></div><svg class="axc-cur" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 2.5l12 6.2-5.3 1.5-2.4 5.1z"/></svg></div>
  </div>
  <div class="panel axc-c" data-ax="follow">
    <div class="axc-tx"><b>Send 4 follow-ups</b><p>Drafts are ready to send. Review them.</p><button class="pill line sm">Review drafts</button></div>
    <div class="axc-v" aria-hidden="true"><div class="axc-k"><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-b);--dm-ai:var(--dm-av-b-ink)"><svg class="i xs"><use href="#i-mail"/></svg></span><span class="axc-n">Saltmarsh Foods</span></span><span class="axc-l" style="width:88%"></span><span class="axc-r"><span class="tag axc-g dr" data-go><svg class="i xs"><use href="#i-spark"/></svg><span class="sw"><span class="a">Drafted</span><span class="b">Sent</span></span></span></span></div><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-b);--dm-ai:var(--dm-av-b-ink)"><svg class="i xs"><use href="#i-mail"/></svg></span><span class="axc-n">Moss &amp; Ember</span></span><span class="axc-l" style="width:76%"></span><span class="axc-r"><span class="tag axc-g dr" data-go><svg class="i xs"><use href="#i-spark"/></svg><span class="sw"><span class="a">Drafted</span><span class="b">Sent</span></span></span></span></div><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-b);--dm-ai:var(--dm-av-b-ink)"><svg class="i xs"><use href="#i-mail"/></svg></span><span class="axc-n">Marrow &amp; Finch</span></span><span class="axc-l" style="width:82%"></span><span class="axc-r"><span class="tag axc-g dr" data-go><svg class="i xs"><use href="#i-spark"/></svg><span class="sw"><span class="a">Drafted</span><span class="b">Sent</span></span></span></span></div><div class="axc-w"><span class="axc-r"><span class="axc-i" style="--dm-a:var(--dm-av-b);--dm-ai:var(--dm-av-b-ink)"><svg class="i xs"><use href="#i-mail"/></svg></span><span class="axc-n">Arbor &amp; Vine</span></span><span class="axc-l" style="width:70%"></span><span class="axc-r"><span class="tag axc-g dr" data-go><svg class="i xs"><use href="#i-spark"/></svg><span class="sw"><span class="a">Drafted</span><span class="b">Sent</span></span></span></span></div></div><svg class="axc-cur" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 2.5l12 6.2-5.3 1.5-2.4 5.1z"/></svg></div>
  </div>
</div>
</div>
  </Fragment></div>
</div>
<script>
  import './action-cards.js';
</script>
