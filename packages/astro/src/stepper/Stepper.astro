---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Stepper: A multi-step setup with a progress track that fills as you go.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change stepper.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './stepper.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="stepper" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="stx">
  <div class="stx-track"></div>
  <div class="stx-vp"><div class="stx-body"></div></div>
  <div class="stx-f"><button class="pill ghost sm stx-bk">Back</button><button class="pill primary sm stx-nx">Continue</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './stepper.js';
</script>
