---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Payment form: Card details with live formatting, brand detection and a clear total.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change payment-form.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './payment-form.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="payment-form" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="pyx-wrap"><form class="pyx panel" novalidate>
  <div class="pyx-h"><div><b>Pro plan</b><span class="muted">For growing design teams</span></div><div class="seg2 pyx-per" role="group" aria-label="Billing"><button type="button" aria-pressed="false" data-v="m">Monthly</button><button type="button" aria-pressed="true" data-v="y">Yearly</button></div></div>
  <label class="pyx-f"><span>Card number</span><div class="pyx-in"><input class="pyx-cn" inputmode="numeric" placeholder="1234 1234 1234 1234" autocomplete="off"><span class="pyx-br"></span></div></label>
  <div class="pyx-2"><label class="pyx-f"><span>Expiry</span><div class="pyx-in"><input class="pyx-ex" inputmode="numeric" placeholder="MM / YY" autocomplete="off"></div></label><label class="pyx-f"><span>CVC</span><div class="pyx-in"><input class="pyx-cv" inputmode="numeric" placeholder="123" maxlength="4" autocomplete="off"></div></label></div>
  <div class="pyx-sum"><div><span>3 editors × <span class="num pyx-u">$24</span></span><span class="num pyx-s">$72.00</span></div><div class="pyx-dc"><span>Yearly discount</span><span class="num pyx-d">−$14.40</span></div><div class="pyx-t"><b>Due today</b><b class="num pyx-tot">$691.20</b></div></div>
  <button class="pill accent pyx-go" type="submit"><svg class="i xs"><use href="#i-lock"/></svg>Pay <span class="num pyx-gt">$691.20</span></button>
</form>
  <span class="muted pyx-n pyx-out">Demo only. Nothing is charged.</span></div>
  </Fragment></div>
</div>
<script>
  import './payment-form.js';
</script>
