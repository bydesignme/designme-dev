---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Account table: Customer accounts with health, plan and an agent note per row.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change account-table.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './account-table.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="account-table" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="atb panel">
  <div class="atb-h"><div class="atb-s"><svg class="i xs"><use href="#i-search"/></svg><input placeholder="Search accounts" aria-label="Search accounts"></div><div class="atb-fl"><button class="chip sm on" data-p="">All</button><button class="chip sm" data-p="Team">Team</button><button class="chip sm" data-p="Pro">Pro</button><button class="chip sm" data-p="Enterprise">Enterprise</button></div></div>
  <div class="atb-sc"><table><thead><tr><th>Account</th><th>Plan</th><th>Seats</th><th>Health</th><th class="r">MRR</th></tr></thead><tbody></tbody></table></div>
</div>
  </Fragment></div>
</div>
<script>
  import './account-table.js';
</script>
