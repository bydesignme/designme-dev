---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Launch checklist: The agent checks a design before it ships, and fixes what fails.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change launch-checklist.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './launch-checklist.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="launch-checklist" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="lcx panel">
  <div class="lcx-h"><div><b>Ready to ship pricing?</b><span class="muted lcx-st">6 checks</span></div><button class="pill primary sm lcx-run"><svg class="i xs"><use href="#i-play"/></svg>Run checks</button></div>
  <div class="lcx-bar"></div>
  <div class="lcx-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './launch-checklist.js';
</script>
