---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Filter menu: Add filters from a menu, see them as chips, and watch the count change.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change filter-menu.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './filter-menu.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="filter-menu" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="flm panel">
  <div class="flm-bar">
    <button class="pill line sm flm-tr" aria-haspopup="menu" aria-expanded="false" data-pop-pos="down"><svg class="i s"><use href="#i-filter"/></svg>Filter</button>
    <div class="flm-chips" role="list" aria-label="Filters"></div>
  </div>
  <div class="pop flm-pop">
    <div class="flm-lv flm-l1" role="menu" aria-label="Filter by"><div class="ph" role="none">Filter by</div></div>
    <div class="flm-lv flm-l2" role="menu" hidden></div>
  </div>
  <div class="flm-sum"><span class="flm-ct num" aria-live="polite"></span><button class="pill ghost sm flm-clr" hidden>Clear all</button></div>
  <div class="flm-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './filter-menu.js';
</script>
