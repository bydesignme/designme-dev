---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Decision prompt: The agent asks a few quick questions before it starts.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change decision-prompt.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './decision-prompt.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="decision-prompt" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="dpx" tabindex="0">
  <div class="dpx-h"><span class="dpx-k muted num">Question 1 of 3</span><div class="dpx-dots"><i class="on"></i><i></i><i></i></div></div>
  <div class="dpx-body"></div>
  <div class="dpx-f"><button class="pill ghost sm dpx-skip">Skip</button><button class="pill primary sm dpx-go">Continue <span class="kbd">↵</span></button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './decision-prompt.js';
</script>
