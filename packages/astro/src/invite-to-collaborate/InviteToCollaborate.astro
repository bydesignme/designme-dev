---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Invite to collaborate: Add teammates by email as chips, set their role, send.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change invite-to-collaborate.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './invite-to-collaborate.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="invite" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ivx panel">
  <div class="ivx-h"><b>Invite to Pricing refresh</b><span class="muted">They can see frames, the brief and agent runs</span></div>
  <div class="ivx-f"><div class="ivx-chips"></div><input placeholder="name@studio.com" aria-label="Email addresses" spellcheck="false"><button class="ivx-role" data-pop=".ivx-rp" data-pop-align="end"><span>Can edit</span><svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
  <div class="pop ivx-rp" role="menu"><button class="mi" role="menuitemradio" data-close data-r="Can edit" aria-checked="true"><span>Can edit<span class="d">Change frames, run the agent</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button><button class="mi" role="menuitemradio" data-close data-r="Can comment" aria-checked="false"><span>Can comment<span class="d">Leave notes, no edits</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button><button class="mi" role="menuitemradio" data-close data-r="Can view" aria-checked="false"><span>Can view<span class="d">Read only</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button></div>
  <div class="ivx-sg"><span class="muted">Suggested</span></div>
  <div class="ivx-mem"></div>
  <div class="ivx-ft"><button class="pill ghost sm ivx-link"><svg class="i xs"><use href="#i-link"/></svg>Copy link</button><button class="pill primary sm ivx-go" disabled>Send invites</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './invite-to-collaborate.js';
</script>
