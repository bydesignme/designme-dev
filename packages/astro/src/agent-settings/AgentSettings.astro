---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agent settings: How much the agent may do alone, with a save bar for changes.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agent-settings.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agent-settings.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="agent-settings" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="asx panel">
  <div class="asx-r asx-col"><div class="asx-l"><b>Autonomy</b><span class="muted asx-ad">Asks before edits to shared files</span></div>
    <div class="asx-steps" role="radiogroup" aria-label="Autonomy"><span class="asx-knob"></span><button role="radio" data-v="0">Ask</button><button role="radio" data-v="1" aria-checked="true">Balanced</button><button role="radio" data-v="2">Autopilot</button></div></div>
  <div class="asx-r"><div class="asx-l"><b>Use team memory</b><span class="muted">Brand rules and past decisions</span></div><button class="toggle" role="switch" aria-checked="true" aria-label="Use team memory"></button></div>
  <div class="asx-r"><div class="asx-l"><b>Post a summary in Slack</b><span class="muted">#design, after each run</span></div><button class="toggle" role="switch" aria-checked="false" aria-label="Post a summary in Slack"></button></div>
  <div class="asx-r"><div class="asx-l"><b>Spend cap per run</b><span class="muted">Pauses and asks when reached</span></div><div class="asx-cap"><button class="ib fill asx-m" aria-label="Lower cap"><svg class="i xs"><use href="#i-minus"/></svg></button><span class="num asx-v">$5</span><button class="ib fill asx-p" aria-label="Raise cap"><svg class="i xs"><use href="#i-plus"/></svg></button></div></div>
  <div class="asx-r asx-col"><div class="asx-l"><b>Instructions</b></div><textarea class="asx-ta" rows="2" spellcheck="false">Use our tokens only. Keep copy short and friendly.</textarea></div>
  <div class="asx-bar"><span>Unsaved changes</span><button class="pill ghost sm asx-rs">Reset</button><button class="pill accent sm asx-sv">Save</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './agent-settings.js';
</script>
