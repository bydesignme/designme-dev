---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Source stack: Everything the agent read, folded into one quiet pill.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change source-stack.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './source-stack.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="source-stack" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ssx">
  <p class="msg">Annual plans convert about 18% better when the monthly price is shown crossed out next to them.</p>
  <button class="ssx-pill" aria-expanded="false"><span class="ssx-ics"></span><span class="ssx-l">8 sources</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
  <div class="fold shut ssx-box"><div><div class="ssx-in">
    <div class="ssx-fl"><button class="chip sm on" data-f="all">All</button><button class="chip sm" data-f="web">Web</button><button class="chip sm" data-f="file">Files</button><button class="chip sm" data-f="figma">Figma</button></div>
    <div class="ssx-list"></div>
  </div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './source-stack.js';
</script>
