---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Date picker: A field that opens a calendar, with quick picks and natural language.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change date-picker.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './date-picker.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="date-picker" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="dpk">
  <button class="dpk-f" data-pop=".dpk-pop" data-pop-pos="down"><svg class="i xs"><use href="#i-cal"/></svg><span class="dpk-val">Pick a launch date</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
  <div class="pop dpk-pop" role="dialog" aria-label="Choose a date">
    <input class="dpk-nl" placeholder="Try “next friday” or “in 2 weeks”" spellcheck="false">
    <div class="dpk-qk"><button class="chip sm" data-d="0">Today</button><button class="chip sm" data-d="1">Tomorrow</button><button class="chip sm" data-d="7">In a week</button></div>
    <div class="dpk-mh"><button class="ib dpk-pv" aria-label="Previous month"><svg class="i xs"><use href="#i-chev-l"/></svg></button><b class="dpk-m"></b><button class="ib dpk-nx" aria-label="Next month"><svg class="i xs"><use href="#i-chev-r"/></svg></button></div>
    <div class="dpk-wd muted"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div>
    <div class="dpk-vp"><div class="dpk-g"></div></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './date-picker.js';
</script>
