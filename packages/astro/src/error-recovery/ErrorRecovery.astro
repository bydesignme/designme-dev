---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Error and recovery: A failed step with retry, skip or hand over to a person.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change error-recovery.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './error-recovery.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="error-recovery" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="erx panel">
  <div class="erx-h"><span class="erx-t">Sync the pipeline to Sheets</span><span class="erx-s muted">Stopped at step 2</span></div>
  <div class="erx-list"></div>
  <div class="fold erx-box"><div><div class="erx-in">
    <div class="erx-q">How should the agent continue?</div>
    <div class="erx-opts" role="radiogroup">
      <button class="erx-o on" data-o="retry" role="radio" aria-checked="true"><i></i><span>Ask for edit access, then retry</span></button>
      <button class="erx-o" data-o="skip" role="radio" aria-checked="false"><i></i><span>Skip it and post the summary</span></button>
      <button class="erx-o" data-o="hand" role="radio" aria-checked="false"><i></i><span>Hand it over to Maya</span></button>
    </div>
    <button class="pill primary sm erx-go">Continue</button>
  </div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './error-recovery.js';
</script>
