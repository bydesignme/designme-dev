---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Agent tree: An orchestrator and its sub-agents, with cost rolled up per branch.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change agent-tree.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './agent-tree.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="agent-tree" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="atr panel" data-s="run">
  <div class="atr-h"><div class="atr-hd"><b class="atr-t">Redesign the pricing page</b><span class="atr-s"><span class="atr-dot" aria-hidden="true"></span><span class="atr-m">Starting</span><span aria-hidden="true">·</span><span class="atr-time num">0:00</span></span></div><span class="atr-tot num">$0.00</span></div>
  <div class="atr-tree mx-glide" role="tree" aria-label="Agents"><svg class="atr-ln" aria-hidden="true"></svg></div>
  <p class="atr-f"></p>
  <p class="atr-sr" role="status"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './agent-tree.js';
</script>
