---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Citation hover card: Hover a citation to see the exact passage it came from.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change citation-hover-card.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './citation-hover-card.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="citation-hover" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="chx">
  <p class="msg chx-p">Teams that show the annual price first see higher paid conversion<button class="chx-c" data-i="0">1</button>, and the effect is stronger when the monthly price stays visible beside it<button class="chx-c" data-i="1">2</button>. Your own data shows the same pattern since the September update<button class="chx-c" data-i="2">3</button>.</p>
  <div class="chx-card panel keep" role="dialog" aria-label="Source"><div class="chx-in"></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './citation-hover-card.js';
</script>
