---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Kanban board: A sprint board where you and the agent move cards, with filters, details and keyboard moves.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change kanban-board.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './kanban-board.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="kanban" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="kbx">
  <div class="kbx-hd"><div class="kbx-ti"><b>Website refresh</b><span class="num"></span></div><div class="kbx-fp" role="group" aria-label="Filter by person"></div><span class="kbx-sp"></span><label class="kbx-q"><svg class="i xs"><use href="#i-search"/></svg><input type="search" placeholder="Search cards" aria-label="Search cards" autocomplete="off"><button class="ib kbx-qx" aria-label="Clear the search" hidden><svg class="i xs"><use href="#i-x"/></svg></button></label><div class="seg2 kbx-vw" role="group" aria-label="View"><button aria-pressed="true" data-v="board"><svg class="i xs"><use href="#i-grid"/></svg><span class="lb">Board</span></button><button aria-pressed="false" data-v="list"><svg class="i xs"><use href="#i-list"/></svg><span class="lb">List</span></button></div></div>
  <div class="kbx-fl"><button class="pill ghost sm kbx-clr" hidden>Clear</button><span class="kbx-sp"></span><span class="kbx-cnt num"></span></div>
  <div class="kbx-bd"><div class="kbx-cols"></div></div>
  <div class="kbx-sr" aria-live="polite"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './kanban-board.js';
</script>
