---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Metric insight: A number, its trend, and the agent's read on why it moved.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change metric-insight.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './metric-insight.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="metric-insight" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="mix panel">
  <div class="mix-h"><span class="muted">Trial to paid</span><div class="seg2 mix-rg" role="group" aria-label="Range"><button aria-pressed="false" data-v="7">7d</button><button aria-pressed="true" data-v="30">30d</button><button aria-pressed="false" data-v="90">90d</button></div></div>
  <div class="mix-v"><b class="num mix-n">0%</b><span class="tag ok mix-d num">+0.0 pts</span></div>
  <div class="mix-ch"><svg class="mix-svg" viewBox="0 0 300 90" preserveAspectRatio="none"><defs><linearGradient id="mixg" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--dm-accent-mark,var(--dm-accent))" stop-opacity=".18"/><stop offset="1" stop-color="var(--dm-accent-mark,var(--dm-accent))" stop-opacity="0"/></linearGradient></defs><path class="mix-a" fill="url(#mixg)"/><path class="mix-l" fill="none" stroke="var(--dm-accent-mark,var(--dm-accent))" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/><line class="mix-x" y1="0" y2="90" stroke="var(--dm-faint)" stroke-dasharray="2 3" vector-effect="non-scaling-stroke"/></svg><span class="mix-dot"></span><span class="mix-mk" style="left:58%"><b><svg class="i xs"><use href="#i-spark"/></svg>Sep 18</b></span></div>
  <div class="mix-ins"><span class="mix-ic"><svg class="i xs"><use href="#i-spark"/></svg></span><span class="mix-t">Jumped after the pricing page update on Sep 18.</span></div>
  <button class="pill soft sm mix-why">Why did it move?</button>
  <div class="fold shut mix-box"><div><div class="mix-rs"></div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './metric-insight.js';
</script>
