---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Slider: Named stops, a stepped scale and a range, with the agent's recommended value marked on the track.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change slider.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './slider.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="slider" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="sdx panel">
  <div class="sdx-b">
    <div class="sdx-h"><span id="sdx-cr">Creativity</span><span class="sdx-v num"></span></div>
    <div class="sdx-tr" data-s="cr"><span class="sdx-rail"><i class="sdx-fill"></i></span><button class="sdx-rec" aria-label="Use the recommended value" data-tip="Recommended by the agent: 0.4"><svg class="i xs"><use href="#i-spark"/></svg></button><span class="sdx-k" role="slider" tabindex="0" aria-labelledby="sdx-cr"><i class="sdx-kb"></i><span class="sdx-tt num"></span></span></div>
    <div class="sdx-stops"><button data-v="0">Precise</button><button data-v="0.5">Balanced</button><button data-v="1">Creative</button></div>
    <p class="sdx-sm" aria-live="polite"><span></span></p>
  </div>
  <div class="sdx-b">
    <div class="sdx-h"><span id="sdx-mx">Tool calls per run</span><span class="sdx-v num"></span></div>
    <div class="sdx-tr" data-s="mx"><span class="sdx-rail"><i class="sdx-fill"></i></span><span class="sdx-k" role="slider" tabindex="0" aria-labelledby="sdx-mx"><i class="sdx-kb"></i><span class="sdx-tt num"></span></span></div>
    <div class="sdx-ticks num"></div>
  </div>
  <div class="sdx-b">
    <div class="sdx-h"><span id="sdx-co">Cost per run</span><span class="sdx-v num"></span></div>
    <div class="sdx-tr" data-s="co"><span class="sdx-rail"><i class="sdx-fill"></i></span><span class="sdx-k" role="slider" tabindex="0" aria-label="Lowest cost per run"><i class="sdx-kb"></i><span class="sdx-tt num"></span></span><span class="sdx-k" role="slider" tabindex="0" aria-label="Highest cost per run"><i class="sdx-kb"></i><span class="sdx-tt num"></span></span></div>
    <div class="sdx-ends muted num"><span>$0.00</span><span>$1.00</span></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './slider.js';
</script>
