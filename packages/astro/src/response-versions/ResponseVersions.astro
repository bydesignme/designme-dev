---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Response versions: Regenerate an answer and flip between versions.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change response-versions.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './response-versions.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="response-versions" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rvx">
  <div class="bub">Write a headline for the pricing page</div>
  <div class="rvx-a">
    <p class="msg rvx-t"></p>
    <div class="rvx-bar">
      <div class="rvx-pg"><button class="ib rvx-prev" aria-label="Previous version" data-tip="Previous"><svg class="i s"><use href="#i-chev-l"/></svg></button><span class="rvx-n num">1 / 1</span><button class="ib rvx-next" aria-label="Next version" data-tip="Next"><svg class="i s"><use href="#i-chev-r"/></svg></button></div>
      <button class="ib rvx-re" aria-label="Regenerate" data-tip="Regenerate" data-tip-k="⌘R"><svg class="i s"><use href="#i-refresh"/></svg></button>
      <button class="ib rvx-cp" aria-label="Copy" data-tip="Copy"><svg class="i s"><use href="#i-copy"/></svg></button>
      <span class="rvx-st muted"></span>
    </div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './response-versions.js';
</script>
