---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Reasoning trail: The agent's plan, notes, sources and edits, after it thinks.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change reasoning-trail.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './reasoning-trail.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="reasoning-trail" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rtr-dm dm"><div class="dm-main"><div class="rtr panel">
  <button class="rtr-h" aria-expanded="true">
    <span class="think on rtr-mark"><i></i><i></i><i></i><i></i></span>
    <span class="rtr-title shim">Reasoning</span><span class="rtr-time num muted">0s</span>
    <svg class="i xs rtr-chev"><use href="#i-chev-d"/></svg>
  </button>
  <div class="fold rtr-fold"><div>
    <div class="rtr-body"></div>
  </div></div>
</div></div>
  <div class="demo"><div class="seg2" role="group" aria-label="View"><button aria-pressed="true" data-v="plan">Plan</button><button aria-pressed="false" data-v="notes">Notes</button><button aria-pressed="false" data-v="sources">Sources</button><button aria-pressed="false" data-v="edits">Edits</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './reasoning-trail.js';
</script>
