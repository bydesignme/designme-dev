---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Banner: An announcement on a tint of its tone, with its own line drawing.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change banner.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './banner.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="banner" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="dm bnx-dm"><div class="dm-main bnx-slot">
  <div class="bnx" role="region" data-tone="accent" data-art="layers" aria-label="Announcement">
    <div class="bnx-art" aria-hidden="true"></div>
    <div class="bnx-tx">
      <span class="bnx-eb"><span>New</span></span>
      <p class="bnx-t"><span>Memory that carries across threads</span></p>
      <p class="bnx-d"><span>Agents keep what they learn about your project, so you only explain things once.</span></p>
      <div class="bnx-acts"><button class="pill primary sm bnx-go"><span>Turn on memory</span></button><button class="bnx-lk"><span>What it keeps</span></button></div>
    </div>
  </div>
</div>
<div class="demo"><div class="seg2" role="group" aria-label="Banner style"><button aria-pressed="true" data-v="0">Accent</button><button aria-pressed="false" data-v="1">Violet</button><button aria-pressed="false" data-v="2">Green</button><button aria-pressed="false" data-v="3">Amber</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './banner.js';
</script>
