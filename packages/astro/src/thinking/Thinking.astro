---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Thinking: The live trace, written as the agent works, then folded away.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change thinking.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './thinking.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="thinking" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tk" data-open="1">
  <button class="tk-h" aria-expanded="true">
    <span class="tk-mark"><span class="think on"><i></i><i></i><i></i><i></i></span></span>
    <span class="tk-title shim">Checking the pricing page</span><span class="tk-time num">0s</span>
    <svg class="i xs tk-chev"><use href="#i-chev-d"/></svg>
  </button>
  <div class="fold tk-fold"><div><ol class="tk-list" aria-live="polite"></ol></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './thinking.js';
</script>
