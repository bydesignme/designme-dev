---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Attachment tray: Drop files for the agent and watch each one upload.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change attachment-tray.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './attachment-tray.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="attachment-tray" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="atx">
  <label class="atx-drop"><input type="file" multiple class="atx-file" aria-label="Choose files"><svg class="atx-ants" aria-hidden="true"><rect/></svg>
    <span class="atx-ic"><svg class="i s"><use href="#i-upload"/></svg></span><b>Drop files here</b><span class="muted">or <span class="atx-sample">add sample files</span></span>
  </label>
  <div class="atx-list"></div>
  <div class="atx-sum muted"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './attachment-tray.js';
</script>
