---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Tool rail: A board's tools in one vertical rail: pick one, and its name and key show on hover.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change tool-rail.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './tool-rail.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="tool-rail" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tlr">
  <div class="tlr-bar" role="toolbar" aria-label="Tools" aria-orientation="vertical">
    <div class="tlr-tools" role="radiogroup" aria-label="Tool">
      <button class="tlr-b mx-press" role="radio" aria-checked="true" data-t="select" aria-label="Select" data-tip="Select" data-tip-k="V"><svg class="i s"><use href="#i-cursor"/></svg></button>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="hand" aria-label="Pan" data-tip="Pan" data-tip-k="H"><svg class="i s"><use href="#i-hand"/></svg></button>
      <span class="tlr-sep" aria-hidden="true"></span>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="sticky" aria-label="Sticky note" data-tip="Sticky note" data-tip-k="S"><svg class="i s"><use href="#i-sticky"/></svg></button>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="pen" aria-label="Pen" data-tip="Pen" data-tip-k="P"><svg class="i s"><use href="#i-pen"/></svg></button>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="eraser" aria-label="Eraser" data-tip="Eraser" data-tip-k="E"><svg class="i s"><use href="#i-eraser"/></svg></button>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="shape" aria-label="Shape" data-tip="Shape" data-tip-k="R"><svg class="i s"><use href="#i-shape"/></svg></button>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="arrow" aria-label="Connector" data-tip="Connector" data-tip-k="A"><svg class="i s"><use href="#i-connector"/></svg></button>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="text" aria-label="Text" data-tip="Text" data-tip-k="T"><svg class="i s"><use href="#i-text"/></svg></button>
      <span class="tlr-sep" aria-hidden="true"></span>
      <button class="tlr-b mx-press" role="radio" aria-checked="false" tabindex="-1" data-t="comment" aria-label="Comment" data-tip="Comment" data-tip-k="C"><svg class="i s"><use href="#i-comment"/></svg></button>
    </div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './tool-rail.js';
</script>
