---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Activity heatmap: When the agent and the team were busy, by day and hour.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change activity-heatmap.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './activity-heatmap.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="activity-heatmap" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="hmx panel">
  <div class="hmx-h"><div><b>Activity</b><span class="muted hmx-st">Last 4 weeks</span></div><div class="seg2 hmx-sg" role="group" aria-label="Who"><button aria-pressed="true" data-v="agent">Agent</button><button aria-pressed="false" data-v="team">Team</button></div></div>
  <div class="hmx-wrap"><div class="hmx-sc"><div class="hmx-days muted"><span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span><span>Sun</span></div><div class="hmx-grid"></div>
  <div class="hmx-f muted"><span class="hmx-ax">12am</span><span class="hmx-ax x">3am</span><span class="hmx-ax">6am</span><span class="hmx-ax x">9am</span><span class="hmx-ax">12pm</span><span class="hmx-ax x">3pm</span><span class="hmx-ax">6pm</span><span class="hmx-ax x">9pm</span></div></div></div>
  <div class="hmx-lg muted">Less<i style="--dm-a:.08"></i><i style="--dm-a:.3"></i><i style="--dm-a:.55"></i><i style="--dm-a:.85"></i>More</div>
</div>
  </Fragment></div>
</div>
<script>
  import './activity-heatmap.js';
</script>
