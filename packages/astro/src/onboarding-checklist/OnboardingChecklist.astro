---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Onboarding checklist: First steps with a progress ring, and the agent can do some for you.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change onboarding-checklist.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './onboarding-checklist.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="onboarding-checklist" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="obx">
  <div class="obx-h"><span class="obx-rw"><svg class="obx-ring" viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" class="tr"/><circle cx="20" cy="20" r="16" class="fl"/></svg><span class="obx-rk"><svg class="i xs"><use href="#i-check"/></svg></span></span><div class="obx-ht"><b>Get set up</b><span class="muted obx-st">0 of 5 done</span></div><button class="ib obx-min" aria-label="Collapse" data-tip="Collapse"><svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
  <div class="fold obx-fold"><div><div class="obx-list"></div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './onboarding-checklist.js';
</script>
