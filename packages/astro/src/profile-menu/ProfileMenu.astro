---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Profile menu: The account menu behind an avatar: switch workspace, theme, shortcuts and sign out.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change profile-menu.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './profile-menu.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="profile-menu" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="pfm">
  <div class="pfm-bar panel">
    <span class="pfm-lg pfm-cur"></span><span class="pfm-ws"><b class="pfm-wn"></b><span class="muted">Pricing refresh</span></span>
    <button class="pfm-tr" aria-haspopup="menu" aria-expanded="false" aria-label="Account menu, Maya Kim" data-pop-align="end" data-pop-pos="down"><span class="av">MK</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
    <button class="pill line sm pfm-in" hidden>Sign in</button>
  </div>
  <div class="pop pfm-pop" role="menu">
    <div class="pfm-me" role="none"><span class="av">MK</span><span class="t"><b class="pfm-nm">Maya Kim</b><span class="muted pfm-em">maya@northwind.studio</span></span></div>
    <div class="sep" role="separator"></div>
    <div class="pfm-grp" role="group"><div class="ph pfm-gl" role="none">Workspaces</div><div class="pfm-wsl"></div></div>
    <div class="sep" role="separator"></div>
    <button class="mi pfm-th" role="menuitemcheckbox" aria-checked="false" tabindex="-1"><svg class="i s"><use href="#i-moon"/></svg><span>Dark theme</span><span class="toggle" aria-hidden="true"></span></button>
    <button class="mi pfm-ky" role="menuitem" tabindex="-1"><svg class="i s"><use href="#i-keyboard"/></svg><span>Keyboard shortcuts</span><span class="kbd" aria-hidden="true">?</span></button>
    <div class="sep" role="separator"></div>
    <button class="mi pfm-out" role="menuitem" tabindex="-1"><svg class="i s"><use href="#i-logout"/></svg><span>Sign out</span></button>
  </div>
  <div class="fold shut pfm-kf"><div><div class="pfm-keys panel" role="region" aria-label="Keyboard shortcuts">
    <div class="pfm-kh"><b>Keyboard shortcuts</b><button class="ib pfm-kx" aria-label="Close shortcuts" data-tip="Close"><svg class="i xs"><use href="#i-x"/></svg></button></div>
    <dl class="pfm-kl"><div><dt><span class="kbd">↑</span><span class="kbd">↓</span></dt><dd>Move through the menu</dd></div><div><dt><span class="kbd">Home</span><span class="kbd">End</span></dt><dd>First or last item</dd></div><div><dt><span class="kbd">Esc</span></dt><dd>Close the menu</dd></div><div><dt><span class="kbd">?</span></dt><dd>Show these shortcuts</dd></div></dl>
  </div></div></div>
  <p class="pfm-note muted" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './profile-menu.js';
</script>
