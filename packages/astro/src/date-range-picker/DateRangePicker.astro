---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Date range picker: Pick a start and end across two months, or use a preset.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change date-range-picker.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './date-range-picker.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="date-range-picker" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="drx panel">
  <div class="drx-side"><button class="drx-p" data-p="7">Last 7 days</button><button class="drx-p" data-p="30">Last 30 days</button><button class="drx-p" data-p="q">This quarter</button><button class="drx-p" data-p="sp">Since pricing launch</button></div>
  <div class="drx-main">
    <div class="drx-top"><div class="drx-in"><span class="muted">From</span><b class="drx-a">–</b></div><svg class="i xs"><use href="#i-right"/></svg><div class="drx-in"><span class="muted">To</span><b class="drx-b">–</b></div><span class="drx-n muted"></span></div>
    <div class="drx-cals"><div class="drx-cal" data-o="0"></div><div class="drx-cal" data-o="1"></div></div>
    <div class="drx-f"><button class="pill ghost sm drx-clr">Clear</button><button class="pill primary sm drx-ok" disabled>Apply</button></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './date-range-picker.js';
</script>
