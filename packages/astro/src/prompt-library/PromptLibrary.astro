---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Prompt library: Saved prompts with blanks to fill in before they go to the agent.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change prompt-library.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './prompt-library.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="prompt-library" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="plb panel">
  <div class="plb-list">
    <div class="plb-h"><div class="plb-ht"><b>Prompt library</b><span class="muted">Shared with DesignMe Studio</span></div></div>
    <div class="plb-rows"></div>
  </div>
  <div class="plb-one" hidden>
    <div class="plb-h"><button class="ib plb-back" aria-label="All prompts" data-tip="All prompts"><svg class="i s"><use href="#i-chev-l"/></svg></button><div class="plb-ht"><b class="plb-tt"></b><span class="muted plb-vn"></span></div></div>
    <p class="plb-tp" aria-live="polite"></p>
    <div class="plb-vars"></div>
    <div class="plb-f"><span class="muted plb-note">Fills in as you go</span><span class="sp"></span><button class="pill primary sm plb-use">Use prompt</button></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './prompt-library.js';
</script>
