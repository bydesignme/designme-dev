---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Command palette: Jump anywhere or hand a task to the agent from one box.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change command-palette.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './command-palette.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="command-palette" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="cpl panel">
  <div class="cpl-in"><svg class="i s"><use href="#i-search"/></svg><input class="cpl-q" placeholder="Search or ask the agent" aria-label="Command" spellcheck="false"><span class="kbd">esc</span></div>
  <div class="cpl-list" role="listbox"></div>
  <div class="cpl-f muted"><span><span class="kbd">↑</span><span class="kbd">↓</span> move</span><span><span class="kbd">↵</span> run</span><span class="cpl-st"></span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './command-palette.js';
</script>
