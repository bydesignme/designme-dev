---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Hand-off to a person: The agent hands a conversation to a person, with what they need to pick it up.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change human-handoff.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './human-handoff.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="human-handoff" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="hox panel">
  <div class="hox-h"><span class="hox-ic"><svg class="i s"><use href="#i-user"/></svg></span><div class="hox-ht"><b>Handed off to a person</b><span class="muted">Refund over $500 needs a person</span></div></div>
  <div class="hox-b">
    <div class="hox-col">
      <span class="hox-lb">Assigned to</span>
      <div class="hox-who"><span class="hox-av"><span class="spin"></span></span><span class="hox-wt"><b class="hox-wn">Finding someone</b><span class="hox-wd"><span class="hox-wv">Billing team</span></span></span><button class="hox-rb" aria-haspopup="menu" aria-expanded="false" data-pop=".hox-pop" data-pop-align="end" data-pop-pos="down" disabled>Reassign<svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
      <div class="hox-sla"><div class="hox-sl"><svg class="i s"><use href="#i-clock"/></svg><span class="hox-due num">Reply due in 14 min</span><span class="muted">15 min target</span></div><div class="hox-bar" role="progressbar" aria-label="Time left to reply" aria-valuemin="0" aria-valuemax="900"><i></i></div></div>
      <div class="hox-ms">
        <div class="hox-mh"><span class="hox-lb hox-ml">Sent to Dana</span><span class="sp"></span><button class="pill ghost sm hox-no" hidden>Cancel</button><button class="pill ghost sm hox-ed"><svg class="i xs"><use href="#i-edit"/></svg>Edit</button></div>
        <div class="hox-mb" role="textbox" aria-multiline="true" aria-readonly="true" aria-label="Message sent to Dana" spellcheck="false">Thanks, Dana. A refund this size needs someone on our billing team, so I've passed your conversation to them. They'll reply here within 15 minutes.</div>
      </div>
    </div>
    <div class="hox-col">
      <span class="hox-lb">Context passed along</span>
      <p class="hox-sum">Dana was charged twice for her annual plan on Oct 21 and wants one charge back. The agent confirmed the duplicate, but can't refund more than $500.</p>
      <div class="hox-facts">
        <div class="hox-f"><span class="k">Amount</span><span class="v num">$588.00</span></div>
        <div class="hox-f"><span class="k">Customer</span><span class="v">Dana Lee · Pro since 2023</span></div>
        <div class="hox-f"><span class="k">Order</span><span class="v num">#48213 · charged twice</span></div>
      </div>
      <button class="fchip lnk hox-lnk" data-tip="Opens the whole conversation"><svg class="i xs"><use href="#i-link"/></svg><span>View conversation · 12 messages</span></button>
    </div>
  </div>
  <div class="hox-st" aria-live="polite"><span class="g"><span class="spin"></span></span><span class="t"><b class="hox-sa">Handing off to Billing</b><span class="hox-sb">The agent has stopped replying to Dana</span></span></div>
  <div class="pop hox-pop" role="menu" aria-label="Reassign to">
    <div class="ph">Reassign to</div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './human-handoff.js';
</script>
