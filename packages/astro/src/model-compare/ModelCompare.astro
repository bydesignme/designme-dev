---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Model compare: Run one prompt on three models side by side and keep the best.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change model-compare.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './model-compare.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="model-compare" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="mcx panel">
  <form class="mcx-in">
    <div class="mcx-fd"><input class="mcx-q" value="Write a one line value prop for the Pro plan" aria-label="Prompt for every model" spellcheck="false" autocomplete="off"><span class="mcx-n num">3 models</span></div>
    <button type="button" class="pill ghost sm mcx-add" data-pop=".mcx-pa" data-pop-align="end" aria-haspopup="menu" aria-expanded="false" hidden><svg class="i xs"><use href="#i-plus"/></svg>Add model</button>
    <button type="submit" class="pill primary sm mcx-go" data-tip="Run on every model" data-tip-k="↵">Run</button>
  </form>
  <div class="pop mcx-pop mcx-pa" role="menu" aria-label="Add a model"></div>
  <div class="mcx-cols"></div>
  <p class="mcx-live" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './model-compare.js';
</script>
