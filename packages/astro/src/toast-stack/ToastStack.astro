---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Toast stack: Agent notifications that stack and fan out on hover.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change toast-stack.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './toast-stack.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="toast-stack" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="tsk dm">
  <div class="dm-main"><div class="tsk-stack" aria-live="polite"></div></div>
  <div class="demo"><button class="pill soft sm tsk-add"><svg class="i s"><use href="#i-bell"/></svg>Send notification</button></div>
</div>
  </Fragment></div>
</div>
<script>
  import './toast-stack.js';
</script>
