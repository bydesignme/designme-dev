---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Form: A project brief with inline checks and an agent that drafts the rest.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change form.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './form.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="form" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<form class="fmx panel" novalidate>
  <div class="fmx-h"><b>New project brief</b><button type="button" class="pill soft sm fmx-ai"><svg class="i xs"><use href="#i-spark"/></svg>Draft with agent</button></div>
  <label class="fmx-f"><span>Project name<i class="fmx-dr" aria-hidden="true"><svg class="i xs"><use href="#i-spark"/></svg>Drafted</i></span><input name="n" placeholder="Pricing refresh" maxlength="40"><em class="fmx-c num">0/40</em></label>
  <label class="fmx-f"><span>Goal<i class="fmx-dr" aria-hidden="true"><svg class="i xs"><use href="#i-spark"/></svg>Drafted</i></span><textarea name="g" rows="2" placeholder="What should change, and why?"></textarea></label>
  <div class="fmx-f"><span>Type</span><div class="fmx-ty"><button type="button" class="chip sm" data-v="web">Website</button><button type="button" class="chip sm" data-v="app">App</button><button type="button" class="chip sm" data-v="brand">Brand</button></div></div>
  <label class="fmx-f"><span>Due<i class="fmx-dr" aria-hidden="true"><svg class="i xs"><use href="#i-spark"/></svg>Drafted</i></span><input name="d" type="text" placeholder="Nov 14"></label>
  <div class="fmx-ft"><span class="fmx-ms muted"></span><button class="pill primary sm fmx-go" type="submit">Create brief</button></div>
</form>
  </Fragment></div>
</div>
<script>
  import './form.js';
</script>
