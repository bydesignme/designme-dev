---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Code viewer: Code the agent wrote, with line notes you can ask about.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change code-viewer.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './code-viewer.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="code-viewer" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="cvx panel" data-reveal="flat">
  <div class="cvx-h"><div class="cvx-tabs" role="tablist"></div><span class="cvx-meta num"></span><button class="ib cvx-cp" aria-label="Copy file" data-tip="Copy"><svg class="i s"><use href="#i-copy"/></svg></button></div>
  <div class="cvx-body"><pre class="cvx-code"></pre></div>
</div>
  </Fragment></div>
</div>
<script>
  import './code-viewer.js';
</script>
