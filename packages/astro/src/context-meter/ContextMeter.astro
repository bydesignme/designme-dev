---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Context meter: How full the context is and what fills it, with Compact to free room.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change context-meter.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './context-meter.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="context-meter" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ctm" data-open="1">
  <button class="ctm-tg" aria-expanded="true" aria-label="Context"><span class="ctm-ring" aria-hidden="true"><svg viewBox="0 0 20 20"><circle class="tr" cx="10" cy="10" r="7.5"/><circle class="fl" cx="10" cy="10" r="7.5" pathLength="100"/></svg></span><span><span class="ctm-pc num">0%</span> of context used</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
  <div class="ctm-pop panel" role="region" aria-label="What fills the context">
    <div class="ctm-ph"><span>In context</span><span class="num"><b class="ctm-tot">0k</b> of 200k tokens</span></div>
    <div class="ctm-bar" aria-hidden="true"></div>
    <div class="ctm-leg"></div>
    <div class="ctm-msg" aria-live="polite"><span></span></div>
    <div class="ctm-f"><span class="ctm-hint">Summarises older turns</span><button class="pill ghost sm ctm-go">Compact</button></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './context-meter.js';
</script>
