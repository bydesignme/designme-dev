---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Step inspector: The settings of one step in an agent workflow, in sections that fold.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change step-inspector.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './step-inspector.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="step-inspector" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="sti-dm dm"><div class="dm-main">
  <div class="sti panel" data-k="ai">
    <div class="sti-h">
      <span class="sti-ti" data-k="ai" aria-hidden="true"><svg class="i s"><use href="#i-spark"/></svg></span>
      <span class="sti-tx"><span class="sti-nr"><input class="sti-n" value="Research and score" aria-label="Step name" maxlength="40" spellcheck="false" autocomplete="off"></span><span class="sti-kd">AI step, step 2 of 7</span></span>
      <button class="ib sti-test" aria-label="Test this step" data-tip="Test this step"><svg class="i s"><use href="#i-play"/></svg></button>
      <button class="ib sti-more" data-pop=".sti-mm" data-pop-align="end" aria-haspopup="menu" aria-expanded="false" aria-label="Step actions" data-tip="More"><svg class="i s"><use href="#i-more"/></svg></button>
    </div>
    <div class="sti-body"></div>
    <div class="pop sti-pk" role="menu" aria-label="Options"></div>
    <div class="pop sti-dp" role="menu" aria-label="Data from earlier steps"></div>
    <div class="pop sti-mm" role="menu" aria-label="Step actions">
      <button class="mi" role="menuitem" tabindex="-1" data-a="rename" data-close><svg class="i s"><use href="#i-edit"/></svg><span>Rename</span></button>
      <button class="mi" role="menuitem" tabindex="-1" data-a="off" data-close><svg class="i s"><use href="#i-pause"/></svg><span>Turn off</span></button>
    </div>
    <p class="sti-live" aria-live="polite"></p>
  </div>
  </div>
  <div class="demo"><div class="seg2" role="group" aria-label="Step"><button aria-pressed="true" data-v="ai">AI step</button><button aria-pressed="false" data-v="branch">Branch</button><button aria-pressed="false" data-v="approval">Approval</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './step-inspector.js';
</script>
