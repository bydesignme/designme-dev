---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Scheduled runs: Tasks the agent runs on a schedule, with their last result and a switch.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change scheduled-runs.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './scheduled-runs.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="scheduled-runs" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="shx panel" data-reveal="flat">
  <div class="shx-h"><div><b>Scheduled runs</b><span class="muted shx-st" aria-live="polite"></span></div></div>
  <div class="shx-list" role="list" aria-label="Schedules"></div>
  <button class="shx-add" data-pop=".shx-pop" data-pop-pos="up" aria-haspopup="dialog" aria-expanded="false"><svg class="i xs"><use href="#i-plus"/></svg>New schedule</button>
  <div class="pop shx-pop" role="dialog" aria-label="New schedule"><form class="shx-f">
    <h4>New schedule</h4>
    <input class="shx-in" placeholder="What should the agent do?" aria-label="What should the agent do?" spellcheck="false" autocomplete="off">
    <div class="seg2 shx-rep" role="group" aria-label="Repeat"><button type="button" aria-pressed="true" data-v="day">Every day</button><button type="button" aria-pressed="false" data-v="mon">Every Monday</button><button type="button" aria-pressed="false" data-v="custom">Custom</button></div>
    <div class="shx-days" role="group" aria-label="Days" hidden></div>
    <div class="shx-ff"><span class="muted shx-sum"></span><button class="pill accent sm shx-mk" type="submit" disabled>Create</button></div>
  </form></div>
</div>
  </Fragment></div>
</div>
<script>
  import './scheduled-runs.js';
</script>
