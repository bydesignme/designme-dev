---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Search input: Search with scoped filters, recent queries and an agent answer.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change search-input.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './search-input.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="search-input" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="six">
  <div class="six-box">
    <div class="six-in"><svg class="i xs"><use href="#i-search"/></svg><span class="six-chips"></span><input placeholder="Search frames, files and docs" aria-label="Search" spellcheck="false"><span class="kbd six-k">⌘K</span><button class="ib six-x" aria-label="Clear" hidden><svg class="i xs"><use href="#i-x"/></svg></button></div>
    <div class="fold shut six-dd"><div><div class="six-res"></div></div></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './search-input.js';
</script>
