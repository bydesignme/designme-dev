---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Segmented control: Switch between views of the same thing, with a sliding indicator.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change segmented-control.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './segmented-control.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="segmented-control" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="sgc panel">
  <div class="sgc-h"><div class="sgc-ht"><b>Pricing launch</b></div>
    <div class="sgc-seg" role="tablist" aria-label="View"><span class="sgc-k" aria-hidden="true"></span><button role="tab" aria-selected="true" data-v="day">Day</button><button role="tab" aria-selected="false" tabindex="-1" data-v="week">Week</button><button role="tab" aria-selected="false" tabindex="-1" data-v="month">Month</button></div></div>
  <div class="sgc-bar"><span class="sgc-r" aria-live="polite">Friday, Oct 23</span><button class="pill ghost sm sgc-td">Today</button><button class="ib sgc-pv" aria-label="Previous day"></button><button class="ib sgc-nx" aria-label="Next day"></button></div>
  <div class="sgc-p" role="tabpanel" tabindex="0"><div class="sgc-in"></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './segmented-control.js';
</script>
