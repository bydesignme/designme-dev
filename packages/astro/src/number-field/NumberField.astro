---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Number field: Type a number or step it with minus and plus, with units, limits and a word when a value is changed to fit.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change number-field.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './number-field.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="number-field" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="nmf panel">
  <div class="nmf-h"><b>Run limits</b><span class="muted">For each run of the release agent</span></div>
  <div class="nmf-f" data-k="steps">
    <span class="nmf-l">Max steps</span>
    <div class="nmf-in"><button class="ib nmf-dn" tabindex="-1" aria-label="Fewer steps"><svg class="i xs"><use href="#i-minus"/></svg></button><span class="nmf-v"><input class="num" role="spinbutton" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="Max steps"><span class="nmf-u">steps</span></span><button class="ib nmf-up" tabindex="-1" aria-label="More steps"><svg class="i xs"><use href="#i-plus"/></svg></button></div>
    <span class="nmf-hint muted"></span>
  </div>
  <div class="nmf-f" data-k="budget">
    <span class="nmf-l">Budget per run</span>
    <div class="nmf-in"><button class="ib nmf-dn" tabindex="-1" aria-label="Lower budget"><svg class="i xs"><use href="#i-minus"/></svg></button><span class="nmf-v"><span class="nmf-u">$</span><input class="num" role="spinbutton" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="Budget per run"></span><button class="ib nmf-up" tabindex="-1" aria-label="Higher budget"><svg class="i xs"><use href="#i-plus"/></svg></button></div>
    <span class="nmf-hint muted"></span>
  </div>
  <div class="nmf-f" data-k="time">
    <span class="nmf-l">Time limit</span>
    <div class="nmf-in"><button class="ib nmf-dn" tabindex="-1" aria-label="Less time"><svg class="i xs"><use href="#i-minus"/></svg></button><span class="nmf-v"><input class="num" role="spinbutton" inputmode="decimal" autocomplete="off" spellcheck="false" aria-label="Time limit"><span class="nmf-u">min</span></span><button class="ib nmf-up" tabindex="-1" aria-label="More time"><svg class="i xs"><use href="#i-plus"/></svg></button></div>
    <span class="nmf-hint muted"></span>
  </div>
  <p class="nmf-sum muted" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './number-field.js';
</script>
