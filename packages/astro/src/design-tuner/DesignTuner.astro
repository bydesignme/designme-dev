---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Design tuner: Tweak a component by hand or let the agent tune it.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change design-tuner.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './design-tuner.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="design-tuner" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="dtx">
  <div class="dtx-prev"><div class="dtx-card">
    <span class="tag b dtx-tg">Pro</span>
    <div class="dtx-pr"><b class="num">$24</b><span class="muted">per editor, monthly</span></div>
    <div class="dtx-li"><span><svg class="i xs"><use href="#i-check"/></svg>Unlimited frames</span><span><svg class="i xs"><use href="#i-check"/></svg>Agent reviews</span><span><svg class="i xs"><use href="#i-check"/></svg>Shared tokens</span></div>
    <button class="pill accent dtx-cta">Start free trial</button>
  </div></div>
  <div class="dtx-insp panel">
    <div class="dtx-ih"><b>Pricing card</b><span class="muted dtx-st">Edited by you</span></div>
    <div class="dtx-rows"></div>
    <button class="pill primary sm dtx-go"><svg class="i xs"><use href="#i-wand"/></svg>Tune with agent</button>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './design-tuner.js';
</script>
