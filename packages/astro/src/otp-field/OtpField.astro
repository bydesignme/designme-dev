---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// OTP field: A one-time code, one box per digit, that fills from a paste.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change otp-field.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './otp-field.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="otp-field" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="otp panel">
  <span class="otp-ic"><svg class="i s"><use href="#i-mail"/></svg></span>
  <b class="otp-t">Check your email</b>
  <p class="muted otp-s">Enter the 6-digit code we sent to maya@designme.studio</p>
  <div class="otp-in" role="group" aria-label="Verification code"></div>
  <p class="otp-m" aria-live="polite"></p>
  <p class="muted otp-f"><span class="otp-rs">Resend code in <span class="num">0:30</span></span></p>
</div>
  </Fragment></div>
</div>
<script>
  import './otp-field.js';
</script>
