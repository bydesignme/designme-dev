---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Carousel: Drafts the agent made to keep one of, or a gallery of pictures, on one swipeable track.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change carousel.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './carousel.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="carousel" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="crs dm">
  <div class="dm-main">
    <div class="crs-c panel" data-type="variants" role="region" aria-roledescription="carousel" aria-label="Cover image drafts">
      <div class="crs-h">
        <div class="crs-t"><b>Cover image drafts</b><span class="muted crs-sub">Making 4 variants</span></div>
        <button class="pill line crs-nav crs-prev" aria-label="Previous variant" data-tip="Previous"><svg class="i s"><use href="#i-chev-l"/></svg></button><button class="pill line crs-nav crs-next" aria-label="Next variant" data-tip="Next"><svg class="i s"><use href="#i-chev-r"/></svg></button>
      </div>
      <div class="crs-tr" role="group" tabindex="0" aria-label="Variants. Enter keeps the one in view"></div>
      <div class="crs-dots"></div>
      <p class="crs-sr" aria-live="polite"></p>
    </div>
    <div class="crs-c" data-type="images" role="region" aria-roledescription="carousel" aria-label="Gallery" hidden>
      <div class="crs-h"><button class="pill line crs-nav crs-prev" aria-label="Previous picture" data-tip="Previous"><svg class="i s"><use href="#i-chev-l"/></svg></button><button class="pill line crs-nav crs-next" aria-label="Next picture" data-tip="Next"><svg class="i s"><use href="#i-chev-r"/></svg></button></div>
      <div class="crs-tr" role="group" tabindex="0" aria-label="Pictures"></div>
      <div class="crs-dots"></div>
      <p class="crs-sr" aria-live="polite"></p>
    </div>
  </div>
  <div class="demo"><div class="seg2" role="group" aria-label="Type"><button aria-pressed="true" data-v="variants">Variants</button><button aria-pressed="false" data-v="images">Images</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './carousel.js';
</script>
