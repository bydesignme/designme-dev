---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Eval results: An eval run case by case, against the run before.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change eval-results.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './eval-results.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="eval-results" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="evr panel">
  <div class="evr-h"><div class="evr-ht"><b>Pricing copy evals</b><span class="muted evr-st">Copy agent · 8 cases · run 2h ago</span></div><button class="pill primary sm evr-run"><svg class="i xs"><use href="#i-play"/></svg>Run evals</button></div>
  <div class="evr-sum"><div class="evr-segs" aria-hidden="true"></div><div class="evr-nums"><span class="evr-pass num" aria-live="polite"></span><span class="tag evr-dl"></span></div></div>
  <div class="evr-tabs"><div class="seg2" role="group" aria-label="Show"><button aria-pressed="true" data-v="all">All <span class="n num"></span></button><button aria-pressed="false" data-v="fail">Failed <span class="n num"></span></button></div></div>
  <div class="evr-list" role="list" aria-label="Cases"></div>
  <p class="evr-none" hidden>No failed cases</p>
</div>
  </Fragment></div>
</div>
<script>
  import './eval-results.js';
</script>
