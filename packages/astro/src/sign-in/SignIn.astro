---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Sign in: Email first, then the one-time code from the email, copied or typed in.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change sign-in.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './sign-in.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="sign-in" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="sgx panel">
  <div class="sgx-st sgx-1">
    <b>Sign in</b><span class="muted">We will email you a code</span>
    <label class="sgx-f"><span>Email</span><input type="email" class="sgx-em" placeholder="you@studio.com" autocomplete="off"></label>
    <span class="sgx-err"></span>
    <button class="pill primary sgx-go">Send code</button>
  </div>
  <div class="sgx-st sgx-2" hidden>
    <div class="fold shut sgx-ntf"><div><div class="sgx-nt" role="status"><span class="sgx-ni"><svg class="i xs"><use href="#i-mail"/></svg></span><span class="t"><b>Designme <span class="muted">now</span></b><span>Your sign-in code is <span class="num">482 157</span></span></span><button class="pill sm sgx-cp">Copy code</button></div></div></div>
    <button class="sgx-bk"><svg class="i xs"><use href="#i-chev-l"/></svg><span class="sgx-to"></span></button>
    <b>Check your inbox</b><span class="muted">Enter the 6 digit code</span>
    <div class="sgx-code"></div>
    <span class="muted sgx-rs">Resend in <span class="num">30</span>s · <span class="sgx-hint">Copy it from the email above</span></span>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './sign-in.js';
</script>
