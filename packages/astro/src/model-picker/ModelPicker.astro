---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Model picker: Pick a model by speed, quality and cost, and how hard it thinks.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change model-picker.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './model-picker.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="model-picker" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="mpk">
  <div class="mpk-top"><span class="muted mpk-lb">Model for this chat</span><button class="mpk-tr" aria-haspopup="true" aria-expanded="true"><span class="mpk-mk"></span><span class="mpk-nm"></span><span class="mpk-ef muted"></span><svg class="i xs"><use href="#i-chev-d"/></svg></button></div>
  <div class="fold mpk-fold"><div><div class="mpk-p panel">
    <div class="mpk-hd" aria-hidden="true"><span></span><span></span><span>Speed</span><span>Quality</span><span>Cost</span></div>
    <div class="mpk-list" role="radiogroup" aria-label="Model"></div>
    <div class="fold shut mpk-sgf"><div><div class="mpk-sg" aria-live="polite"><p class="mpk-sgt"></p><div class="mpk-sga"><button class="pill ghost sm mpk-wait">Wait for Opus</button><button class="pill primary sm mpk-use">Use Sonnet on high</button></div></div></div></div>
    <div class="mpk-th">
      <div class="mpk-thh"><b><svg class="i xs"><use href="#i-brain"/></svg>Thinking</b><span class="muted mpk-thd"></span></div>
      <button class="mpk-eb" aria-haspopup="menu" aria-expanded="false" aria-label="Thinking effort" data-pop=".mpk-pop" data-pop-align="end"><span class="mpk-ev">Medium</span><svg class="i xs"><use href="#i-chev-d"/></svg></button>
    </div>
  </div></div></div>
  <div class="pop mpk-pop" role="menu" aria-label="Thinking effort">
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-v="0"><span>Off<span class="d">Answers straight away</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-v="1"><span>Low<span class="d">Up to 2k thinking tokens</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="true" data-close data-v="2"><span>Medium<span class="d">Up to 8k thinking tokens</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <button class="mi" role="menuitemradio" aria-checked="false" data-close data-v="3"><span>High<span class="d">Up to 24k thinking tokens</span></span><span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
  </div>
  <p class="mpk-note muted" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './model-picker.js';
</script>
