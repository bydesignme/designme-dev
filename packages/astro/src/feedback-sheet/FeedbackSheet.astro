---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Feedback sheet: Rate an answer and tell the agent what missed.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change feedback-sheet.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './feedback-sheet.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="feedback-sheet" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="fbx">
  <p class="msg">I tightened the hero spacing to 24px and swapped the CTA to the accent blue. The card grid now wraps at 720px.</p>
  <div class="fbx-bar">
    <button class="ib fbx-up" aria-label="Good answer" data-tip="Good answer"><svg class="i s"><use href="#i-up-thumb"/></svg></button>
    <button class="ib fbx-dn" aria-label="Bad answer" data-tip="Bad answer"><svg class="i s"><use href="#i-down-thumb"/></svg></button>
    <span class="fbx-st muted"></span>
  </div>
  <div class="fold shut fbx-box"><div><div class="fbx-in panel keep">
    <div class="fbx-q">What went wrong?</div>
    <div class="fbx-ch"><button class="chip sm">Wrong spacing</button><button class="chip sm">Ignored my tokens</button><button class="chip sm">Too many changes</button><button class="chip sm">Broke the layout</button></div>
    <textarea class="fbx-ta" rows="2" placeholder="Anything else the agent should know"></textarea>
    <div class="fbx-f"><span class="muted fbx-n">Shared with the agent for this project</span><button class="pill ghost sm fbx-x">Cancel</button><button class="pill primary sm fbx-go" disabled>Send</button></div>
  </div></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './feedback-sheet.js';
</script>
