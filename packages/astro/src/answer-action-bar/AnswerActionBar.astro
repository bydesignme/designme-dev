---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Answer action bar: Copy, regenerate, rate and listen to an answer from one row under it.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change answer-action-bar.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './answer-action-bar.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="answer-action-bar" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="aab">
  <div class="bub">How much do people save on the yearly Pro plan?</div>
  <p class="msg aab-t" aria-live="polite"></p>
  <div class="aab-row">
    <div class="aab-bar" role="toolbar" aria-label="Answer actions">
      <button class="ib aab-cp" aria-label="Copy" data-tip="Copy"><svg class="i s"><use href="#i-copy"/></svg></button>
      <button class="ib aab-re" aria-label="Regenerate" data-tip="Regenerate"><svg class="i s"><use href="#i-refresh"/></svg></button>
      <span class="aab-pg"><button class="ib aab-prev" aria-label="Previous version" data-tip="Previous version"><svg class="i xs"><use href="#i-chev-l"/></svg></button><span class="aab-n num" aria-live="polite">1 / 1</span><button class="ib aab-next" aria-label="Next version" data-tip="Next version"><svg class="i xs"><use href="#i-chev-r"/></svg></button></span>
      <span class="aab-sep" aria-hidden="true"></span>
      <button class="ib aab-up" aria-label="Good answer" aria-pressed="false" data-tip="Good answer"><svg class="i s"><use href="#i-up-thumb"/></svg></button>
      <button class="ib aab-dn" aria-label="Bad answer" aria-pressed="false" data-tip="Bad answer"><svg class="i s"><use href="#i-down-thumb"/></svg></button>
      <span class="aab-sep" aria-hidden="true"></span>
      <button class="aab-rd" aria-label="Read aloud" aria-pressed="false" data-tip="Read aloud"><span class="ic"><svg class="i xs"><use href="#i-vol"/></svg></span><span class="aab-pr" aria-hidden="true"><i></i></span><span class="aab-tm num"></span></button>
    </div>
    <span class="aab-meta muted num"></span>
  </div>
  <div class="fold shut aab-why"><div><div class="aab-wy">
    <span class="aab-wq">What was off?</span>
    <div class="aab-ch"><button class="chip sm">Wrong numbers</button><button class="chip sm">Too long</button><button class="chip sm">Not our tone</button><button class="chip sm">Missed the brief</button></div>
  </div></div></div>
  <p class="aab-st muted" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './answer-action-bar.js';
</script>
