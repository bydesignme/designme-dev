---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Run drawer: A workflow's run under its canvas: the steps, the log and the data.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change run-drawer.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './run-drawer.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="run-drawer" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rdr" data-reveal="flat">
  <div class="rdr-cv"><div class="rdr-flow" role="group" aria-label="Steps of the workflow"></div></div>
  <div class="rdr-dw" role="region" aria-label="Run">
    <div class="rdr-grip" role="separator" aria-orientation="horizontal" aria-label="Resize the run drawer" tabindex="0" aria-valuemin="120" aria-valuemax="408" aria-valuenow="312"><i></i></div>
    <div class="rdr-h">
      <button class="rdr-tg" aria-expanded="true"><svg class="i xs"><use href="#i-chev-u"/></svg><span><span class="w">Test run </span><span class="rdr-id num">#2088</span></span><span class="rdr-st tag run"><span class="spin"></span>Running</span></button>
      <span class="rdr-meta num"></span>
      <span class="rdr-sp"></span>
      <div class="seg2 rdr-tabs" role="group" aria-label="Show"><button aria-pressed="true" data-v="steps">Steps</button><button aria-pressed="false" data-v="log">Log</button><button aria-pressed="false" data-v="data">Data</button></div>
      <button class="pill ghost sm rdr-stop" aria-label="Stop the run" data-tip="Stop the run"><svg class="i xs"><use href="#i-stop"/></svg><span>Stop</span></button>
      <button class="pill ghost sm rdr-again" aria-label="Run again" data-tip="Run again" hidden><svg class="i xs"><use href="#i-refresh"/></svg><span>Run again</span></button>
      <button class="ib rdr-follow" aria-pressed="true" aria-label="Follow the run" data-tip="Follow the run"><svg class="i s"><use href="#i-target"/></svg></button>
    </div>
    <div class="rdr-b">
      <div class="rdr-v" data-v="steps"><div class="rdr-ax" aria-hidden="true"><span>Step</span><span class="rdr-sc"></span><span class="ms">Time</span></div><div class="rdr-rows" role="group" aria-label="Steps of the run"></div></div>
      <div class="rdr-v" data-v="log" hidden><div class="rdr-lf"><div class="seg2 rdr-lvs" role="group" aria-label="Level"><button aria-pressed="true" data-v="all">All</button><button aria-pressed="false" data-v="warn">Warnings</button><button aria-pressed="false" data-v="error">Errors</button></div><span class="n num"></span></div><ol class="rdr-log" aria-label="Run log"></ol></div>
      <div class="rdr-v" data-v="data" hidden><div class="rdr-data"><div class="rdr-ds" role="group" aria-label="Steps"></div><div class="rdr-io"></div></div></div>
    </div>
    <p class="rdr-live" aria-live="polite"></p>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './run-drawer.js';
</script>
