---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Memory panel: What the agent remembers about your team, editable and removable.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change memory-panel.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './memory-panel.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="memory-panel" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="mmx panel" data-reveal="flat">
  <div class="mmx-h"><span class="mmx-ic"><svg class="i s"><use href="#i-book"/></svg></span><div class="mmx-ht"><b>Team memory</b><span class="mmx-sub"><span class="muted mmx-st">7 memories</span><span class="mmx-srcs" aria-hidden="true"></span></span></div><div class="seg2 mmx-tab" role="group" aria-label="Filter"><button aria-pressed="true" data-v="all">All</button><button aria-pressed="false" data-v="brand">Brand</button><button aria-pressed="false" data-v="process">Process</button></div></div>
  <div class="mmx-list"></div>
  <div class="mmx-f" aria-live="polite"><span class="mmx-fi" aria-hidden="true"><svg class="i xs"><use href="#i-spark"/></svg></span><span class="mmx-ft">Used in 14 answers this week</span></div>
</div>
  </Fragment></div>
</div>
<script>
  import './memory-panel.js';
</script>
