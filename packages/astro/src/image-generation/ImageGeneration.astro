---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Image generation: A prompt with styles, shape and count, pictures that resolve out of grain, and a gallery of earlier ones.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change image-generation.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './image-generation.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="image-generation" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="igx" role="region" aria-label="Image generation">
<div class="igx-in" data-view="create">
  <div class="igx-main" role="group" aria-label="Create">
    <div class="igx-h">
      <span class="igx-cr"><span>Images</span><svg class="i s"><use href="#i-chev-r"/></svg><b>Spring lookbook</b></span>
      <div class="seg2 igx-vw" role="group" aria-label="Show"><button type="button" aria-pressed="true" data-v="create">Create</button><button type="button" aria-pressed="false" data-v="gallery">Gallery</button><button type="button" aria-pressed="false" data-v="styles">Styles</button></div>
    </div>
    <div class="igx-feed">
      <div class="bub igx-ask"></div>
      <div class="igx-empty"><div class="igx-ef" aria-hidden="true"><span><svg class="i s"><use href="#i-image"/></svg></span><span><svg class="i s"><use href="#i-image"/></svg></span><span><svg class="i s"><use href="#i-image"/></svg></span></div><span>Describe a picture and press Generate</span></div>
      <div class="igx-run" hidden>
        <div class="igx-rh">
          <span class="igx-rt"></span>
          <span class="igx-steps" aria-hidden="true"><span data-k="0"><i></i><svg class="i s"><use href="#i-check"/></svg>Composing</span><span data-k="1"><i></i><svg class="i s"><use href="#i-check"/></svg>Adding detail</span><span data-k="2"><i></i><svg class="i s"><use href="#i-check"/></svg>Upscaling</span></span>
          <span class="igx-pc num" aria-hidden="true"></span>
        </div>
        <div class="igx-tiles" role="group" aria-label="Pictures"></div>
        <div class="igx-acts" role="toolbar" aria-label="Rate and copy">
          <button type="button" class="ib igx-up" aria-label="Good pictures" aria-pressed="false" data-tip="Good pictures"><svg class="i s"><use href="#i-up-thumb"/></svg></button>
          <button type="button" class="ib igx-dn" aria-label="Bad pictures" aria-pressed="false" data-tip="Bad pictures"><svg class="i s"><use href="#i-down-thumb"/></svg></button>
          <button type="button" class="ib igx-cp" aria-label="Copy prompt" data-tip="Copy prompt"><svg class="i s"><use href="#i-copy"/></svg></button>
          <span class="igx-meta"></span>
        </div>
      </div>
      <p class="igx-sr" aria-live="polite"></p>
    </div>
    <form class="igx-cmp">
      <div class="igx-refs" role="group" aria-label="References"></div>
      <textarea class="igx-ta" rows="2" aria-label="Prompt" placeholder="Describe the picture you want">Editorial portrait on a bold colour backdrop, studio light</textarea>
      <div class="igx-sty" role="group" aria-label="Styles">
        <button type="button" class="igx-sc" aria-pressed="true" data-s="Editorial"><svg class="i s"><use href="#i-check"/></svg>Editorial</button><button type="button" class="igx-sc" aria-pressed="false" data-s="Poster"><svg class="i s"><use href="#i-check"/></svg>Poster</button><button type="button" class="igx-sc" aria-pressed="false" data-s="Surreal"><svg class="i s"><use href="#i-check"/></svg>Surreal</button><button type="button" class="igx-sc" aria-pressed="false" data-s="35mm"><svg class="i s"><use href="#i-check"/></svg>35mm</button>
      </div>
      <div class="igx-bar">
        <button type="button" class="chip igx-set" aria-haspopup="dialog" aria-expanded="false" data-pop=".igx-pp-set" data-pop-pos="up" data-tip="Shape and number"><svg class="i s"><use href="#i-image"/></svg><span class="igx-set-n">3:4 · 4</span><svg class="i s"><use href="#i-chev-d"/></svg></button>
        <button type="button" class="chip igx-mdl" aria-haspopup="menu" aria-expanded="false" data-pop=".igx-pp-m" data-pop-pos="up" data-tip="Image model"><svg class="i s"><use href="#i-spark"/></svg><span class="igx-mdl-n">Studio 2</span><svg class="i s"><use href="#i-chev-d"/></svg></button>
        <span class="sp"></span>
        <button type="submit" class="pill primary igx-go" aria-label="Generate" data-tip="Generate" data-tip-k="↵"><svg class="i s"><use href="#i-wand"/></svg><span>Generate</span></button>
      </div>
      <div class="pop igx-pp-set" role="dialog" aria-label="Shape and number">
        <div class="ph">Shape</div>
        <div class="seg2 igx-ars" role="group" aria-label="Shape"><button type="button" aria-pressed="false" data-v="1:1">1:1</button><button type="button" aria-pressed="true" data-v="3:4">3:4</button><button type="button" aria-pressed="false" data-v="16:9">16:9</button></div>
        <div class="ph">Pictures</div>
        <div class="seg2 igx-cts" role="group" aria-label="Pictures"><button type="button" aria-pressed="false" data-v="1">1</button><button type="button" aria-pressed="false" data-v="2">2</button><button type="button" aria-pressed="false" data-v="3">3</button><button type="button" aria-pressed="true" data-v="4">4</button></div>
      </div>
      <div class="pop igx-pp-m" role="menu" aria-label="Image model">
        <div class="ph">Image model</div>
        <button type="button" class="mi" role="menuitemradio" aria-checked="true" data-close data-m="0"><svg class="i s"><use href="#i-spark"/></svg><span>Studio 2<span class="d">Most detail, about 6s a picture</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
        <button type="button" class="mi" role="menuitemradio" aria-checked="false" data-close data-m="1"><svg class="i s"><use href="#i-bolt"/></svg><span>Studio 2 Fast<span class="d">Quick drafts, about 3s</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
        <button type="button" class="mi" role="menuitemradio" aria-checked="false" data-close data-m="2"><svg class="i s"><use href="#i-layers"/></svg><span>Studio 2 HD<span class="d">Twice the size, about 9s</span></span><span class="ck"><svg class="i s"><use href="#i-check"/></svg></span></button>
      </div>
    </form>
  </div>
  <div class="igx-side" role="group" aria-label="Library">
    <div class="igx-sh">
      <div class="seg2 igx-tb" role="group" aria-label="Show"><button type="button" aria-pressed="true" data-v="gallery">Gallery</button><button type="button" aria-pressed="false" data-v="styles">Styles</button></div>
      <span class="sp"></span><span class="muted igx-cn num"></span>
    </div>
    <div class="igx-pane igx-gp" role="group" aria-label="Gallery"><div class="igx-gal"></div></div>
    <div class="igx-pane igx-sp" role="group" aria-label="Style presets" hidden><div class="igx-prs"></div></div>
  </div>
  <div class="igx-lb" role="dialog" aria-modal="true" aria-label="Picture" hidden></div>
</div>
</div>
  </Fragment></div>
</div>
<script>
  import './image-generation.js';
</script>
