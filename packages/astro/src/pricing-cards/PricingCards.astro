---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Pricing cards: Three plans with a billing switch and a seat slider.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change pricing-cards.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './pricing-cards.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="pricing-cards" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="pcx">
  <div class="pcx-top"><div class="seg2 pcx-per" role="group" aria-label="Billing"><button aria-pressed="false" data-v="m">Monthly</button><button aria-pressed="true" data-v="y">Yearly <span class="tag ok">−20%</span></button></div>
    <label class="pcx-seats"><span class="muted">Editors</span><input type="range" min="1" max="50" value="5" aria-label="Editors"><b class="num pcx-sn">5</b></label></div>
  <div class="pcx-grid"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './pricing-cards.js';
</script>
