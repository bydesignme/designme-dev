---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Step loader: Named steps with a progress track and four loaders.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change step-loader.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './step-loader.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', 'bare', className]} data-c="step-loader" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="stl dm"><div class="dm-main">
  <button class="stl-row" aria-expanded="false">
    <span class="stl-g"></span>
    <span class="stl-t"><span class="stl-lab shim">Reading Figma frames</span></span>
    <span class="stl-n num">1/4</span>
    <svg class="i xs stl-chev"><use href="#i-chev-d"/></svg>
  </button>
  <div class="stl-track"><i></i><i></i><i></i><i></i></div>
  <div class="fold shut stl-fold"><div><ol class="stl-list"></ol></div></div>
  </div>
  <div class="demo"><div class="seg2" role="group" aria-label="Loader"><button aria-pressed="true" data-v="radar">Radar</button><button aria-pressed="false" data-v="think">Dots</button><button aria-pressed="false" data-v="spin">Ring</button><button aria-pressed="false" data-v="bars">Bars</button></div></div>
</div>
  </Fragment></div>
</div>
<script>
  import './step-loader.js';
</script>
