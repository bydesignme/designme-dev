---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Run queue: Agent jobs running, up next and done, with progress, retries and a compact view.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change run-queue.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './run-queue.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="run-queue" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="rq panel keep">
  <div class="rq-h"><div class="rq-ht"><b>Launch prep</b><span class="rq-st num">4 jobs queued</span></div><div class="seg2" role="group" aria-label="Density"><button aria-pressed="true" data-v="full">Detailed</button><button aria-pressed="false" data-v="compact">Compact</button></div></div>
  <div class="rq-tot" aria-hidden="true"></div>
  <div class="rq-b">
    <div class="fold shut rq-ff"><div><div class="rq-sec"><div class="rq-fin"><span class="rq-av" aria-hidden="true"></span><span class="rq-jt"><b class="rq-ft">All jobs done</b><span class="rq-js rq-fs"></span></span></div></div></div></div>
    <div class="fold rq-rf"><div><div class="rq-sec"><span class="rq-l">Running</span><ul class="rq-run" aria-label="Running"></ul></div></div></div>
    <div class="fold rq-nf"><div><div class="rq-sec"><span class="rq-l">Up next</span><ol class="rq-next" aria-label="Up next"></ol><p class="rq-none">Nothing waiting</p></div></div></div>
    <div class="fold rq-df"><div><div class="rq-sec"><span class="rq-l">Done <span class="num rq-dn">0</span></span><ul class="rq-done" aria-label="Done"></ul><p class="rq-none">Nothing done yet</p></div></div></div>
  </div>
  <p class="rq-say" aria-live="polite"></p>
</div>
  </Fragment></div>
</div>
<script>
  import './run-queue.js';
</script>
