---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Context menu: Right-click an agent reply for its actions, with a submenu that asks the agent about it.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change context-menu.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './context-menu.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="context-menu" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="cxm">
  <div class="cxm-msg panel" tabindex="0" aria-haspopup="menu" aria-label="Agent reply. Press Shift+F10 for actions">
    <div class="cxm-hd"><span class="cxm-av"><svg class="i s"><use href="#i-spark"/></svg></span><b>Agent</b><span class="muted num">2:14 pm</span><span class="cxm-pin" hidden><svg class="i s"><use href="#i-pin"/></svg>Pinned</span></div>
    <p class="cxm-tx">Most of the checkout drop-off is on mobile. 61% of the people who leave do it at the address step, where the keyboard covers the Continue button. Moving Continue above the keyboard should win back about 300 orders a week.</p>
    <div class="cxm-out" aria-live="polite"></div>
  </div>
  <p class="cxm-note muted" aria-live="polite"></p>
  <div class="pop cxm-pop" role="menu" aria-label="Reply actions">
    <button class="mi" role="menuitem" data-a="copy"><svg class="i s"><use href="#i-copy"/></svg>Copy text<span class="r">⌘C</span></button>
    <button class="mi" role="menuitem" data-a="quote"><svg class="i s"><use href="#i-quote"/></svg>Quote in reply<span class="r">R</span></button>
    <button class="mi" role="menuitem" data-a="pin"><svg class="i s"><use href="#i-pin"/></svg><span class="t">Pin to thread</span><span class="r">P</span></button>
    <div class="sep" role="separator"></div>
    <button class="mi cxm-sub" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-a="ask"><svg class="i s"><use href="#i-spark"/></svg>Ask the agent<span class="r"><svg class="i xs"><use href="#i-chev-r"/></svg></span></button>
    <button class="mi" role="menuitemcheckbox" aria-checked="false" data-a="follow"><svg class="i s"><use href="#i-bell"/></svg>Follow replies<span class="ck"><svg class="i xs"><use href="#i-check"/></svg></span></button>
    <div class="sep" role="separator"></div>
    <button class="mi cxm-del" role="menuitem" data-a="del"><svg class="i s"><use href="#i-trash"/></svg><span class="t">Delete reply</span><span class="r">⌫</span></button>
  </div>
  <div class="pop cxm-pop2" role="menu" aria-label="Ask the agent">
    <button class="mi" role="menuitem" data-a="explain"><svg class="i s"><use href="#i-info"/></svg>Explain</button>
    <button class="mi" role="menuitem" data-a="sum"><svg class="i s"><use href="#i-list"/></svg>Summarise</button>
    <button class="mi" role="menuitem" data-a="rewrite"><svg class="i s"><use href="#i-edit"/></svg>Rewrite shorter</button>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './context-menu.js';
</script>
