---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Donut chart: Where the agent's time went, by kind of task.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change donut-chart.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './donut-chart.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="donut-chart" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="dnx panel">
  <div class="dnx-ring"><svg viewBox="0 0 120 120"></svg><div class="dnx-c"><b class="num dnx-v">0h</b><span class="muted dnx-l">Agent time</span></div></div>
  <div class="dnx-lg"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './donut-chart.js';
</script>
