---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Meeting card: The next meeting from countdown to wrap-up, with the time already gone hatched out and a join that stays open.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change meeting-card.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './meeting-card.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" or "clean" draws it in that style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft" or "clean") */
  'data-style'?: 'soft' | 'clean';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="meeting-card" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="mtx panel">
  <div class="mtx-h">
    <b class="mtx-t">Pricing review</b><span class="mtx-sub num">Today, 10:30 to 11:15</span>
    <span class="tag mtx-st"><span><svg class="i xs"><use href="#i-clock"/></svg>In <span class="mtx-roll num"><i>10</i></span> min</span></span>
  </div>
  <div class="mtx-track" role="img" aria-label="Now 10:20. The meeting runs 10:30 to 11:15">
    <span class="mtx-blk"><span class="mtx-bp"></span><span class="num">10:30</span><span class="num">11:15</span></span>
    <span class="mtx-now"><i></i></span>
  </div>
  <div class="mtx-f">
    <div class="mtx-who"><span class="av" style="background:var(--dm-av-l);color:var(--dm-av-l-ink)" role="img" aria-label="Maya Kim" data-tip="Maya Kim" data-pic="people/MK-5876695">MK</span><span class="av" style="background:var(--dm-av-m);color:var(--dm-av-m-ink)" role="img" aria-label="Jon Ortiz" data-tip="Jon Ortiz" data-pic="people/JO-5384445">JO</span><span class="av" style="background:var(--dm-av-p);color:var(--dm-av-p-ink)" role="img" aria-label="Ari Reyes" data-tip="Ari Reyes" data-pic="people/AR-3785077">AR</span><span class="av" style="background:var(--dm-av-t);color:var(--dm-av-t-ink)" role="img" aria-label="Sam Lee" data-tip="Sam Lee">SL</span><span class="av mtx-more" role="img" aria-label="Dev Kapoor, Lena Novak" data-tip="Dev Kapoor, Lena Novak">+2</span></div>
    <span class="sp"></span>
    <button class="ib mtx-cp" aria-label="Copy Google Meet link" data-tip="Copy meet.google.com/nax-wqkf-stu"><svg class="i s"><use href="#i-link"/></svg></button>
    <div class="mtx-jg"><button class="pill primary mtx-join"><span class="mk"><svg class="brand" aria-hidden="true" viewBox="0 0 87.5 72"><path fill="#00832d" d="M49.5 36l8.53 9.75 11.47 7.33 2-17.02-2-16.64-11.69 6.44z"/><path fill="#0066da" d="M0 51.5V66c0 3.315 2.685 6 6 6h14.5l3-10.96-3-9.54-9.95-3z"/><path fill="#e94235" d="M20.5 0L0 20.5l10.55 3 9.95-3 2.95-9.41z"/><path fill="#2684fc" d="M20.5 20.5H0v31h20.5z"/><path fill="#00ac47" d="M82.6 8.68L69.5 19.42v33.66l13.16 10.79c1.97 1.54 4.85.135 4.85-2.37V11c0-2.535-2.945-3.925-4.91-2.32zM49.5 36v15.5h-29V72h43c3.315 0 6-2.685 6-6V53.08z"/><path fill="#ffba00" d="M63.5 0h-43v20.5h29V36l20-16.57V6c0-3.315-2.685-6-6-6z"/></svg></span><span class="lb">Join</span></button><button class="pill primary mtx-jm" aria-label="More for this meeting" data-pop=".mtx-pop" data-pop-align="end" aria-haspopup="menu"><svg class="i xs"><use href="#i-chev-d"/></svg></button><div class="pop mtx-pop" role="menu"><button class="mi" role="menuitem" data-close data-a="Invite sent"><svg class="i s"><use href="#i-mail"/></svg>Send invite</button><button class="mi" role="menuitem" data-close data-a="Added to calendar"><svg class="i s"><use href="#i-cal"/></svg>Add to calendar</button><button class="mi" role="menuitem" data-close data-a="Invitation copied"><svg class="i s"><use href="#i-copy"/></svg>Copy invitation</button></div></div>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './meeting-card.js';
</script>
