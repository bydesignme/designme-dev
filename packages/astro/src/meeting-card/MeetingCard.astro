---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Meeting card: The next meeting with a countdown, a now line on its time track and a one-click join.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change meeting-card.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './meeting-card.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'wide', className]} data-c="meeting-card" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="mtx panel">
  <div class="mtx-top">
    <div class="mtx-when"><span class="mtx-dot"></span><span class="mtx-in num">In 30 minutes</span></div>
    <b class="mtx-t">Meeting with Product team</b>
    <div class="mtx-track" role="img" aria-label="Now 10:00. The meeting runs 10:30 to 12:00"><span class="mtx-ticks"></span><span class="mtx-blk"><span class="num">90 min</span></span><span class="mtx-now"><i></i></span></div>
    <div class="mtx-axis num" aria-hidden="true"><span class="a">10:00</span><span style="left:20%">10:30</span><span style="left:80%">12:00</span><span class="z">12:30</span></div>
  </div>
  <div class="mtx-join">
    <button class="mtx-go"><span class="mtx-mk"><svg class="brand" aria-hidden="true" viewBox="0 0 87.5 72"><path fill="#00832d" d="M49.5 36l8.53 9.75 11.47 7.33 2-17.02-2-16.64-11.69 6.44z"/><path fill="#0066da" d="M0 51.5V66c0 3.315 2.685 6 6 6h14.5l3-10.96-3-9.54-9.95-3z"/><path fill="#e94235" d="M20.5 0L0 20.5l10.55 3 9.95-3 2.95-9.41z"/><path fill="#2684fc" d="M20.5 20.5H0v31h20.5z"/><path fill="#00ac47" d="M82.6 8.68L69.5 19.42v33.66l13.16 10.79c1.97 1.54 4.85.135 4.85-2.37V11c0-2.535-2.945-3.925-4.91-2.32zM49.5 36v15.5h-29V72h43c3.315 0 6-2.685 6-6V53.08z"/><path fill="#ffba00" d="M63.5 0h-43v20.5h29V36l20-16.57V6c0-3.315-2.685-6-6-6z"/></svg></span><span class="mtx-gt"><b>Join on Google Meet</b><span class="mtx-url">meet.google.com/nax-wqkf-stu</span></span><span class="mtx-ar"><svg class="i s"><use href="#i-right"/></svg></span></button>
    <button class="ib mtx-cp" aria-label="Copy meeting link" data-tip="Copy link"><svg class="i s"><use href="#i-copy"/></svg></button>
  </div>
</div>
  </Fragment></div>
</div>
<script>
  import './meeting-card.js';
</script>
