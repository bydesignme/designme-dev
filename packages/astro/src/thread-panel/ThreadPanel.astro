---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Thread panel: Switch between agent threads and reply in place.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change thread-panel.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './thread-panel.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', 'bare', className]} data-c="thread-panel" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="thp panel">
  <div class="thp-tabs" role="tablist"></div>
  <div class="thp-body" aria-live="polite"></div>
  <form class="thp-in"><input class="thp-field" aria-label="Reply" placeholder="Reply to the agent"><button class="thp-send" aria-label="Send" data-tip="Send" data-tip-k="↵" disabled><svg class="i s"><use href="#i-up"/></svg></button></form>
</div>
  </Fragment></div>
</div>
<script>
  import './thread-panel.js';
</script>
