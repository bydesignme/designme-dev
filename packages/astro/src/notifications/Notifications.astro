---
// Generated from designme.dev by scripts/sync.mjs. Edit the site, then sync.
// Notifications: An inbox where agent updates and mentions arrive live.
// The markup, CSS and script are designme.dev's own, run by the shared core in ../core, which mounts the component when it scrolls
// into view and plays its demo. To show your own data, change notifications.js. The markup is kept exactly as it is (is:raw).
import type { HTMLAttributes } from 'astro/types';
import '../core/designme.css';
import './notifications.css';

export interface Props extends HTMLAttributes<'div'> {
  /** "soft" draws it in the Soft style. Leave it out for Blueprint, or for the style set on <html> (data-style="soft") */
  'data-style'?: 'soft';
}
const { class: className, ...rest } = Astro.props;
---
<div class:list={['card', className]} data-c="notifications" {...rest}>
  <div class="stage-in"><Fragment is:raw>
<div class="ntx panel">
  <div class="ntx-h"><b>Inbox</b><span class="ntx-ct num">0</span><span class="ntx-sp"></span><button class="pill ghost sm ntx-all">Mark all read</button></div>
  <div class="ntx-tabs"><div class="seg2" role="group" aria-label="Filter"><button aria-pressed="true" data-v="all">All</button><button aria-pressed="false" data-v="agent">Agent</button><button aria-pressed="false" data-v="men">Mentions</button></div></div>
  <div class="ntx-list"></div>
</div>
  </Fragment></div>
</div>
<script>
  import './notifications.js';
</script>
